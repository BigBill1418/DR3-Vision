// DR3-Vision schema
// First-draft DDL derived from PROJECT-CHARTER.md §6.
//
// IMPORTANT semantics encoded here:
// - Per-site separation: every domain table includes site_id; queries scope by it
// - Audit log: append-only, indefinite retention (ADR-0007)
// - Photo storage: file bytes go to R2; Postgres holds metadata only (ADR-0005)
// - Soft delete: a few tables have deleted_at; the audit_log records who/when
// - Bonus rules: parameter table, not hardcoded (ADR-0011)
// - Forward-compat hooks: load_source_type enum supports CIP (V2.2 per ADR-0010)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────────────
// Sites and configuration
// ────────────────────────────────────────────────────────────────────────

enum Jurisdiction {
  oregon
  california
}

enum BillingCadence {
  end_of_month_only // Oregon
  mid_month_and_end // California
}

model Site {
  id               String       @id @default(uuid())
  code             String       @unique // 'eugene' | 'woodland'
  name             String
  jurisdiction     Jurisdiction
  mrc_program_code String // e.g. 'MRC-OR-2025' or 'MRC-CA-2025'

  // Storage limits. ADR-0037 addendum (2026-07-22): outdoor storage is not
  // tracked — DR3 never stores units outside, so there is no outdoor cap.
  max_units_indoor        Int? // CA only
  max_units_total_on_site Int? // OR only (off-site prohibited)

  // Operational windows
  customer_service_open  String // '08:00' | '08:30'
  customer_service_close String // '16:00' | '16:30'

  // Contract specifics
  recycling_rate_target_pct                Decimal @db.Decimal(5, 2) // 75.00 | 70.00
  records_retention_years                  Int // 4 | 5
  inbound_processing_deadline_days         Int // 45 | 60
  mymrc_inbound_submission_business_days   Int // 3 (both)
  mymrc_processed_submission_business_days Int // 1 (both)
  dock_sla_minutes                         Int // 60 (both)
  reconciliation_target_pct                Decimal @db.Decimal(5, 2) // 97.00

  billing_cadence BillingCadence
  cip_enabled     Boolean        @default(false) // CA Woodland only

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  users               User[]
  inbound_loads       InboundLoad[]
  expected_loads      ExpectedLoad[]
  sources             Source[]
  site_holidays       SiteHoliday[]
  inventory_snapshots SiteInventorySnapshot[]
  billing_rates       SiteBillingRate[]
  bonus_rules         ProcessorBonusRule[]
  processing_sessions ProcessingSession[]

  // Bonus Management System (ADR-0019; bi-weekly cadence per ADR-0019.1)
  bonus_employees       BonusEmployee[]
  bonus_pay_periods     BonusPayPeriod[]
  bonus_signature_chain BonusSignatureChain?

  // Bonus amendment workflow (ADR-0028)
  bonus_amendment_requests BonusAmendmentRequest[]

  // Daily production report (ADR-0030)
  bonus_daily_report_config BonusDailyReportConfig?
  bonus_daily_report_logs   BonusDailyReportLog[]

  // Processor production quota alert (ADR-0071)
  processor_quota_config ProcessorQuotaConfig?
  processor_quota_logs   ProcessorQuotaLog[]

  // Tiered anchor-overwrite guardrail (ADR-0072)
  inventory_anchor_config InventoryAnchorConfig?
  inventory_count_holds   InventoryCountHold[]

  // Absorbed trailer-list rows (ADR-0069 Am.1)
  doc_trailer_rows DocTrailerRow[]

  // Absorbed TEREX maintenance rows (ADR-0069 Am.2)
  doc_terex_rows DocTerexMaintenanceRow[]

  // Absorbed commodity audit-coverage rows (ADR-0080)
  doc_commodity_audit_rows DocCommodityAuditRow[]

  // Absorbed outbound load weights + their commodity split (ADR-0104 D2)
  doc_outbound_load_rows      DocOutboundLoadRow[]
  doc_outbound_commodity_rows DocOutboundCommodityRow[]

  // Editable per-commodity outlier bounds for the coverage page (ADR-0108)
  outbound_variance_config OutboundVarianceConfig[]

  // Absorbed facility expense-log rows (ADR-0104 D4)
  doc_facility_expense_rows DocFacilityExpenseRow[]

  // Reporting-only production adjustments (ADR-0032)
  bonus_reporting_adjustments BonusReportingAdjustment[]

  // Loads & inventory foundations (ADR-0037)
  state_program_rules   StateProgramRule[]
  consumer_dropoffs     ConsumerDropoff[]
  outbound_materials    OutboundMaterial[]
  landfilled_units      LandfilledUnit[]
  processed_units_daily ProcessedUnitsDaily[]

  // 3-way audit engine (ADR-0039)
  audit_findings     AuditFinding[]
  audit_check_config AuditCheckConfig[]
  workbook_imports   WorkbookImport[]
  audit_runs         AuditRun[]

  // P3 rate alerts + missing-record detection (ADR-0043)
  alert_recipients  AlertRecipient[]
  alert_digest_logs AlertDigestLog[]

  // Shared-file document ingestion (ADR-0067). A source with site_id NULL is
  // UNCLASSIFIED, not cross-site — see DocSource.
  doc_sources          DocSource[]
  // The classifier's PROPOSED site, before a human confirms it. Deliberately a
  // separate edge from `doc_sources`: a proposal must never be readable as a
  // site scoping decision (hard rule #2).
  doc_sources_proposed DocSource[] @relation("DocSourceProposedSite")

  /// ADR-0069 — REFERENCE figures extracted from documents shared for this site.
  /// Never operational data: nothing computes payroll, billing, bonus or inventory
  /// from these rows. `site_id` is NOT NULL here (unlike DocSource) because
  /// absorption REFUSES an unclassified source rather than guessing a site.
  doc_reference_rows DocReferenceRow[]

  /// ADR-0068 — reimbursements filed against this site. Auto-filled from the
  /// submitter, never client-chosen (hard rule #2: site reach is server-decided).
  reimbursement_requests ReimbursementRequest[]

  @@map("sites")

  // ADR-0019.4 signature-chain health ledger
  bonus_chain_health_runs BonusChainHealthRun[]
}

model SiteHoliday {
  id           String   @id @default(uuid())
  site_id      String
  site         Site     @relation(fields: [site_id], references: [id])
  holiday_date DateTime @db.Date
  name         String // 'New Year's Day', 'Memorial Day', etc.

  @@unique([site_id, holiday_date])
  @@map("site_holidays")
}

model SiteBillingRate {
  id                String    @id @default(uuid())
  site_id           String
  site              Site      @relation(fields: [site_id], references: [id])
  per_unit_rate_usd Decimal   @db.Decimal(10, 4)
  effective_date    DateTime  @db.Date
  end_date          DateTime? @db.Date
  notes             String?

  @@index([site_id, effective_date])
  @@map("site_billing_rates")
}

model SiteInventorySnapshot {
  id                  String   @id @default(uuid())
  site_id             String
  site                Site     @relation(fields: [site_id], references: [id])
  snapshot_at         DateTime @default(now())
  units_indoor        Int? // CA only
  units_total         Int? // OR only
  units_in_processing Int      @default(0)

  // ADR-0037 D6 — reconciliation of the computed running balance to a
  // physical count. A `physical` snapshot becomes the new anchor for
  // `running-balance.ts`; `computed` marks a system-derived snapshot.
  // Existing rows default to `physical` (they were hand-taken counts).
  snapshot_kind    InventorySnapshotKind @default(physical)
  // `physical − computed` at reconcile time; recorded, never silently
  // absorbed. Null for non-reconcile snapshots.
  reconciled_delta Int?
  // Provenance of the snapshot (who/what produced it).
  source           RecordSource          @default(manual)
  // ADR-0048 — workbook_promotions.id when this row was promoted from staging.
  import_id        String?

  // ADR-0037 §3 amendment (D6 pool split, handoff §1.4) — a physical count records
  // the program and non-program pools SEPARATELY (MRC is billed on program units
  // only). `pool_attribution`:
  //   'measured' → both `program_units` + `non_program_units` were entered and MUST
  //                 sum to the snapshot total (validated at the service layer);
  //   'legacy'   → a pre-amendment row: all counts attributed to the program pool
  //                 (backfilled in migration 20260715_pool_split). The running
  //                 balance uses the measured split when present, else legacy.
  // TEXT (not an enum) per the §3 amendment spec.
  program_units     Decimal? @db.Decimal(7, 1)
  non_program_units Decimal? @db.Decimal(7, 1)
  pool_attribution  String   @default("measured")

  // ADR-0078 D1 — the tiebreaker that makes "the latest anchor" a FACT.
  //
  // `snapshot_at` is not unique and is not even distinct per count: the floor
  // count route anchors at Pacific MIDNIGHT of the current day (ADR-0060 D-3),
  // so two counts taken on the same day carry the byte-identical
  // `snapshot_at`. Both anchor selectors ordered by `snapshot_at DESC` alone,
  // and SQL does not promise which of two equal keys comes back — so which
  // count became the anchor was decided by whatever the planner felt like.
  // Every downstream number is computed forward from the anchor, so this was
  // an arbitrary choice about inventory, not about row order.
  //
  // Recorded, not inferred: `created_at` is the insertion instant, so
  // ORDER BY snapshot_at DESC, created_at DESC always names the count that was
  // ENTERED LAST. Existing rows backfill to `snapshot_at` in the migration —
  // for the two production rows (different days) that is exact, and it can
  // never invert an ordering that `snapshot_at` alone already determined.
  //
  // No new index. The existing `(site_id, snapshot_kind, snapshot_at)` index
  // still resolves the range; the tiebreak sorts at most a handful of
  // same-instant rows, and an index that Postgres would not meaningfully use
  // is ceremony, not performance.
  created_at        DateTime @default(now())

  // ADR-0084 — same-day operator VOID of a physical count.
  //
  // The iPad is the only surface that can double-enter a count: the operator
  // types a number and submits, and before ADR-0078's idempotency key a
  // double-tap produced two rows. ADR-0078 closed the mechanism; this closes the
  // genuine-mistake case (wrong number keyed, or a duplicate predating the key).
  //
  // Soft-void, never a hard delete: a physical count is the anchor every
  // downstream floor/COR/billing number is computed forward from, so the value's
  // history has to survive (CLAUDE.md hard rule #6 in spirit — the audit row is
  // append-only and the row it describes must still be there to describe).
  //
  // `voided_at` non-null means EXCLUDED FROM ANCHOR SELECTION. Every reader
  // filters it — the filter is centralised in `NOT_VOIDED` /
  // `notVoidedSnapshotWhere()` (src/lib/inventory/snapshot-void.ts) precisely so
  // a new reader cannot quietly omit it; `snapshot-void-readers.guard.test.ts`
  // fails the build if a `siteInventorySnapshot` query appears without it.
  //
  // `voided_by` is a bare scalar FK → users.id (ON DELETE SET NULL in the
  // migration, no Prisma relation field), matching the BonusReportingAdjustment
  // `created_by` pattern: we never navigate user → voided snapshots.
  //
  // No new index. The existing `(site_id, snapshot_kind, snapshot_at)` index
  // still resolves the range and `voided_at IS NULL` is a residual predicate over
  // a handful of rows — same reasoning ADR-0078 D1 recorded for the tiebreaker.
  voided_at         DateTime?
  voided_by         String?

  @@index([site_id, snapshot_at])
  @@index([site_id, snapshot_kind, snapshot_at])
  // ADR-0120 — a partial UNIQUE index on (site_id, snapshot_at) WHERE
  // snapshot_kind = 'physical' AND voided_at IS NULL AND source = 'import'
  // lives in migration 20260852. Prisma cannot express a partial index, so it
  // is SQL-only and `migrate diff` will report it as drift (that check is
  // advisory and non-blocking by design — see .github/workflows/ci.yml).
  //
  // It is scoped to source = 'import' DELIBERATELY. Two live `physical` counts
  // at one site sharing an instant is a SUPPORTED state, not a defect: the floor
  // anchors every count at Pacific midnight of its day, and ADR-0078 D1 added
  // the created_at tiebreak precisely so same-day counts resolve deterministically.
  // An unscoped unique index makes the second same-day count fail — verified
  // against the ADR-0078 D1 suite, which goes red on it.
  @@map("site_inventory_snapshots")
}

// ADR-0078 — exactly-once receipts for floor writes.
//
// One row per (client-minted) idempotency key. The row is claimed and completed
// inside the SAME transaction as the business write it guards, so the key and
// the write commit or roll back together — see `src/lib/idempotency.ts` for why
// that is non-negotiable rather than a nicety.
//
// `status_code` and `response_body` are nullable ONLY to give the claim a
// distinguishable "claimed but not completed" state. Because the claim and the
// completion share a transaction, a committed row with NULL status is
// unreachable through this module; if one is ever read, something else wrote
// this table and `withIdempotency` refuses it loudly instead of reading it as an
// empty success.
//
// DELIBERATELY NO FOREIGN KEYS on `actor_user_id` / `site_id`. These rows are
// ephemeral request receipts swept after 7 days, not domain records — the
// durable account of who did what is `audit_log`, which does carry the FK. An FK
// here would let a 7-day-old receipt block a user or site mutation, which is a
// referential-integrity cost with no integrity benefit.
model IdempotencyKey {
  /// Client-minted, `src/lib/ulid.ts` shape. The dedupe identity.
  key           String   @id
  /// Write class, e.g. `operator.count.create`. Part of the replay identity.
  scope         String
  actor_user_id String?
  site_id       String?
  /// sha256 hex of the canonical request payload; a mismatch is a 409.
  request_hash  String
  status_code   Int?
  response_body Json?
  created_at    DateTime @default(now())

  // Drives the TTL sweep (`/api/internal/idempotency/sweep`), which is the only
  // writer that ever deletes from this table.
  @@index([created_at])
  @@map("idempotency_keys")
}

// ────────────────────────────────────────────────────────────────────────
// Users and auth
// ────────────────────────────────────────────────────────────────────────

enum UserRole {
  operator
  manager
  admin
}

enum UserLocale {
  en
  es
  ur
}

model User {
  id     String     @id @default(uuid())
  email  String?    @unique // null for operator-only accounts
  name   String
  role   UserRole
  locale UserLocale @default(en)

  // Browser auth (manager/admin) — Microsoft Entra ID SSO only per
  // ADR-0016. The legacy `password_hash` column was dropped in
  // Sprint-2 cleanup migration `20260506215753_drop_user_password_hash`.

  // PIN auth (operator)
  pin_hash            String? // Argon2id; per ADR-0004, NOT indexed
  pin_failed_attempts Int       @default(0)
  pin_first_failed_at DateTime? // start of the current 60s rate-limit window (ADR-0004)
  pin_locked_until    DateTime?

  // Roles and assignment
  primary_site_id String?
  primary_site    Site?   @relation(fields: [primary_site_id], references: [id])

  // ADR-0024 — all-sites manager. When true, a `manager` reaches every site
  // (like an admin) WITHOUT the admin role, so it confers no admin-only powers
  // (user management, bonus amendment/override, /admin). Always false for
  // operators and irrelevant for admins (who already see all sites).
  all_sites               Boolean @default(false)
  can_manage_rates        Boolean @default(false) // ADR-0040 — rate-table write access (D5)
  // 2026-07-09 rollup §1.2 (ADR-0041/0039 addendum) — READ-ONLY access to the
  // /admin/billing/verify page (invoices ready for GP entry + the ADR-0039
  // findings touching their windows). MANAGER-ONLY, exactly like
  // can_manage_rates (hard rule #2: never an operator grant; coerced false on
  // any role change away from manager). Grants exactly that one read surface;
  // never any write, never any other /admin page. Site reach on the page
  // follows rule #2: all_sites managers (+ admins) see both sites; a
  // single-site manager sees only their primary site. Intended grantee: Mary
  // Scott (GP entry, bills both CA and OR) as manager + all_sites + this flag,
  // once her account exists.
  can_view_billing_verify Boolean @default(false)

  // ADR-0046 Amendment 5 (D-M5-5) — READ-ONLY access to the AP invoice-history
  // search surface (`/admin/ap/history`). Admin role grants it implicitly; this
  // column grants it to a designated SECOND APPROVER (Shannon Rockwell, Eugene)
  // who is not an admin, resolved in `src/lib/auth-helpers.ts`
  // (`requireApHistoryRead` / `checkApHistoryRead`: role==='admin' OR fresh-DB
  // read of this flag). Follows the `can_view_billing_verify` precedent exactly —
  // read FRESH from Postgres every request, NEVER carried in the NextAuth JWT,
  // grants exactly that one read surface and no admin power (hard rule #2). NOT
  // attached to the general `ap_approvers` roster (avoids leaking historical AP
  // data to shift operators). The `ap_second_approvers` roster is the intended
  // grant vehicle for non-admin second approvers.
  can_view_ap_history Boolean @default(false)

  // ADR-0046 Amendment 9 (§2.5) — SITE-MANAGER access to the AP equipment-request
  // resolution worklist (`/admin/ap/equipment-requests`) and its resolve/reject
  // writes, and membership of the per-site notification roster (§2.4). Admin role
  // grants it implicitly; this column grants it to the named SITE MANAGERS (Morena
  // Gomez + Janette Tomas, Woodland; Rick Albritton, Eugene) who are not admins.
  //
  // This is a DELIBERATE, narrow exception to "/admin/* is admin-only" — the ADR
  // records why: the people who know the fleet are the site managers, not Bill, and
  // routing every unknown asset through the one admin is precisely the friction the
  // hatch exists to remove. It follows the `can_view_ap_history` /
  // `can_view_billing_verify` precedent exactly — read FRESH from Postgres on every
  // request, NEVER carried in the NextAuth JWT, consulted NOWHERE ELSE, and it
  // grants no admin power (no user management, no bonus override, no other
  // `/admin/*` surface). It is NOT the `ap_approvers` roster: an approver files the
  // request, a site manager resolves it, and those are deliberately different sets.
  can_resolve_equipment_requests Boolean @default(false)

  // ADR-0030 — super-admin gate for the Bill-only daily-production-report
  // admin tile (`/admin/production-report`). Distinct from `role = admin`:
  // admin-role Kelsey is NOT super-admin. Promotion is a DB UPDATE, not a UI affordance.
  is_super_admin Boolean @default(false)

  // Processor-specific (V2.1)
  processor_role String? // 'Lead', 'Processor', 'Machine Operator', 'Stryo', 'Floater' (Eugene); null for Woodland

  is_active     Boolean   @default(true)
  last_login_at DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  // ADR-0053 D2 — session revocation kill-switch. Bumped to now() in the SAME
  // mutation whenever an admin changes an auth-relevant, token-cached claim
  // (role / all_sites / is_super_admin) or the activation state (deactivate /
  // soft-delete). The Auth.js jwt callback (Node pass) reads this fresh on every
  // request and forces re-auth when it is newer than the token's issued-at —
  // turning off-boarding from "up to 12h idle / 30d absolute" into effectively
  // instant. Defense-in-depth ON TOP OF the Entra signIn gate (ADR-0016), not a
  // replacement. Timestamptz (the repo otherwise defaults to timestamp(3))
  // because it is a bare instant compared against token.iat. No index: only ever
  // read by the PK findUnique in the jwt callback, never filtered on. A manual
  // is_super_admin demotion via raw SQL MUST also set this (see ADR-0053 D2).
  sessions_invalidated_at DateTime? @db.Timestamptz

  // Relations
  loads_assigned                 InboundLoad[]       @relation("LoadAssignedOperator")
  loads_submitted                InboundLoad[]       @relation("LoadSubmittedBy")
  processing_sessions_processor  ProcessingSession[] @relation("SessionProcessor")
  processing_sessions_lead       ProcessingSession[] @relation("SessionLead")
  processing_sessions_authorized ProcessingSession[] @relation("SessionAuthorizedBy")
  audit_entries                  AuditLog[]

  // Bonus Management System (ADR-0019; bi-weekly cadence + Eugene per ADR-0019.1 / ADR-0019.2)
  bonus_employee_link                     BonusEmployee[]       @relation("BonusEmployeeUser")
  bonus_entries_authored                  BonusDailyEntry[]     @relation("BonusEntryAuthor")
  bonus_pay_periods_signed_as_facility    BonusPayPeriod[]      @relation("BonusFacilitySigner")
  bonus_pay_periods_signed_as_ops         BonusPayPeriod[]      @relation("BonusOpsSigner")
  bonus_pay_periods_amended               BonusPayPeriod[]      @relation("BonusAmender")
  bonus_signature_chains_as_facility      BonusSignatureChain[] @relation("BonusFacilitySignerConfig")
  bonus_signature_chains_as_ops           BonusSignatureChain[] @relation("BonusOpsSignerConfig")
  bonus_signature_chains_as_auto_override BonusSignatureChain[] @relation("BonusAutoOverrideActor")
  bonus_imports_authored                  BonusImport[]

  // Bonus amendment workflow (ADR-0028)
  bonus_amendments_requested  BonusAmendmentRequest[] @relation("BonusAmendmentRequester")
  bonus_amendments_to_approve BonusAmendmentRequest[] @relation("BonusAmendmentExpectedApprover")
  bonus_amendments_reviewed   BonusAmendmentRequest[] @relation("BonusAmendmentReviewer")

  // Daily production report (ADR-0030)
  bonus_daily_report_recipients_added BonusDailyReportRecipient[] @relation("BonusDailyReportRecipientAdder")

  // Operational intelligence survey (ADR-0034)
  survey_campaigns_created SurveyCampaign[] @relation("SurveyCampaignCreator")
  survey_invites_approved  SurveyInvite[]   @relation("SurveyInviteApprover")

  // 3-way audit engine (ADR-0039)
  audit_findings_resolved   AuditFinding[]   @relation("AuditFindingResolver")
  workbook_imports_uploaded WorkbookImport[] @relation("WorkbookImportUploader")

  // ADR-0068 — reimbursements. Four DISTINCT roles on one request, kept apart
  // because the control depends on the distinction: the submitter may never
  // approve (D4), and the beneficiary may never approve even when routing points
  // at them (D6). Collapsing any two of these would erase the control.
  reimbursements_submitted       ReimbursementRequest[] @relation("ReimbursementSubmitter")
  reimbursements_benefiting      ReimbursementRequest[] @relation("ReimbursementBeneficiary")
  reimbursements_second_approved ReimbursementRequest[] @relation("ReimbursementSecondApprover")
  reimbursements_routed_to       ReimbursementRequest[] @relation("ReimbursementRoutedTo")

  @@map("users")
}

// ────────────────────────────────────────────────────────────────────────
// Sources (where mattresses come from)
// ────────────────────────────────────────────────────────────────────────

/// ADR-0037 amendment (rollup §3.2, Rick Albritton 2026-07-17) — the billing TYPE of a
/// collection site, which drives which invoice lines a source produces:
/// - `mrc_inbound`         : trans + trailer + MRC unit rate (Glenwood, all CA MRC sites)
/// - `cvp_retailer`        : trans + trailer only, no MRC unit rate (Rifes)
/// - `collection_site`     : trans + trailer + per-mattress ($2.25) + MRC unit rate (SVDP)
/// - `third_party_inbound` : MRC unit rate only; MRC-contracted haulers deliver, DR3
///                           only processes (Thompsons, Stayton, Deschutes). NB:
///                           `Sponsors` is NOT here — §2 reclassified it as a
///                           provenance agency (see ProvenanceAgency), not a source.
enum SourceSiteType {
  mrc_inbound
  cvp_retailer
  collection_site
  third_party_inbound
  // ADR-0037 amendment (rollup §4/§14, Rick 2026-07-19) — SVDP-run retail/warehouse
  // locations that BRING mattresses but are NOT MRC-approved collection sites:
  // no $2.25/unit collection billing, no trans, no trailer rental. Seeded with
  // `active_billing=false` (produce zero invoice lines). 11 stores seeded in §4.
  svdp_internal_store
}

model Source {
  id                String          @id @default(uuid())
  site_id           String
  site              Site            @relation(fields: [site_id], references: [id])
  name              String // verbatim from MyMRC for reconciliation match
  street            String?
  city              String?
  state             String?
  zip               String?
  is_active         Boolean         @default(true)
  notes             String?
  // ADR-0037 Addendum B7 — site-driven program-ness + trans-charge classifier.
  // Program-ness is a property of the collection SITE, not the commodity: a
  // non-program source's units default to the non-program pool at the verify gate
  // (manager can override). `is_trans_charge` splits the two Inbound tabs;
  // `canonical_mileage` feeds the (P2) freight tier table. Spelling drift in the
  // source workbook lists is resolved via `source_aliases`.
  is_non_program    Boolean         @default(false)
  is_trans_charge   Boolean         @default(false)
  canonical_mileage Int?
  // ADR-0037 amendment (rollup §3.2) — billing routing. `site_type` picks the invoice-line
  // set (see SourceSiteType); nullable (legacy seeds predate the taxonomy).
  // `active_billing=false` suppresses ALL invoice lines (Roseburg: non-program, seed
  // inactive until they sign MRC). `bill_trans` / `bill_trailer` are per-source overrides
  // of the site_type default (Cottage Grove: both false, per-mattress still charged).
  site_type         SourceSiteType?
  active_billing    Boolean         @default(true)
  bill_trans        Boolean         @default(true)
  bill_trailer      Boolean         @default(true)
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt

  inbound_loads  InboundLoad[]
  expected_loads ExpectedLoad[]
  aliases        SourceAlias[]

  @@unique([site_id, name])
  @@index([site_id, is_active])
  @@map("sources")
}

/// ADR-0037 Addendum B7 — alias table for source-name spelling drift. The
/// workbook's own site lists carry heavy variant spellings (`VAcaville`,
/// `Chester Tranfer`, …); historical data cannot be joined without alias
/// resolution. One canonical `Source` may have many aliases; each alias resolves
/// to exactly one source (UNIQUE).
model SourceAlias {
  id         String   @id @default(uuid())
  source_id  String
  source     Source   @relation(fields: [source_id], references: [id])
  alias      String   @unique
  created_at DateTime @default(now())

  @@index([source_id])
  @@map("source_aliases")
}

// ────────────────────────────────────────────────────────────────────────
// Transporters (carriers)
// ────────────────────────────────────────────────────────────────────────

model Transporter {
  id          String   @id @default(uuid())
  name        String   @unique // verbatim from MyMRC
  is_internal Boolean  @default(false) // SVdP/DR3-owned hauling
  is_active   Boolean  @default(true)
  notes       String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  inbound_loads  InboundLoad[]
  expected_loads ExpectedLoad[]

  @@map("transporters")
}

// ────────────────────────────────────────────────────────────────────────
// Expected loads (scheduled hauls scraped from MyMRC)
// ────────────────────────────────────────────────────────────────────────

model ExpectedLoad {
  id                       String       @id @default(uuid())
  site_id                  String
  site                     Site         @relation(fields: [site_id], references: [id])
  external_mymrc_haul_id   String       @unique
  expected_arrival_at      DateTime
  source_id                String?
  source                   Source?      @relation(fields: [source_id], references: [id])
  source_name_at_sync      String // raw name from MyMRC; in case match fails
  transporter_id           String?
  transporter              Transporter? @relation(fields: [transporter_id], references: [id])
  transporter_name_at_sync String?
  expected_unit_count      Int?
  bol_number               String?
  scheduled_at_mymrc       DateTime?
  last_synced_at           DateTime     @default(now())
  cancelled_at             DateTime? // set when haul disappears from MyMRC

  // ── ADR-0099 — how many CONSECUTIVE scrapes have missed this haul ──────────
  // The stale-haul sweep used to cancel on ONE absence. Measured on production
  // 2026-08-11 22:04 PT: of 69 auto-cancellations, 67 were later UN-cancelled by
  // a subsequent scrape and 30 of those came back on the very next hourly pass.
  // The sweep was not retiring dead hauls, it was FLAPPING — and the gap between
  // the cancel and the restore is a window in which the queue hides the row
  // entirely and the hauls screen says "View only".
  //
  // Reset to 0 on every scrape that CONTAINS the haul, so the count is
  // consecutive by construction rather than cumulative.
  missed_scrape_count      Int          @default(0)
  // When the current miss STREAK began. Not used by the cancel decision (the
  // count is), and deliberately kept anyway: it is the only way to answer "was
  // the threshold right?" from the data instead of from the argument, which
  // ADR-0094 §6 asks of every threshold this repo sets.
  first_missed_at          DateTime?

  inbound_load InboundLoad?

  @@index([site_id, expected_arrival_at])
  @@index([cancelled_at])
  @@map("expected_loads")
}

// ────────────────────────────────────────────────────────────────────────
// Inbound loads (the dock workflow record)
// ────────────────────────────────────────────────────────────────────────

enum LoadSourceType {
  b2b_haul // standard transporter delivery (MVP)
  cip_consumer // consumer drop-off (V2.2 per ADR-0010)
  event // ADR-0037 Addendum B1 — event units (daily-log `list!Q` source type)
  // ADR-0037 Phase 3 §3.2(b) — one synthesized aggregate row per site per day,
  // entered by a manager from the paper daily log during the pre-iPad bootstrap.
  // Never a dock capture; provenance is explicit so per-load rows stay distinct.
  paper_bulk
  // ADR-0059 — one synthesized aggregate row per (site, delivery day), bridged from
  // MyMRC `Delivered` `General` hauls (the recycler's received count). PROVISIONAL /
  // unconfirmed: this enum value IS the provisional-state marker — a manager
  // `paper_bulk` entry or a future iPad floor-confirmation supersedes it (the
  // generalized partial unique index + upsertBulkInboundDay's delete enforce that
  // precedence). Never a dock capture.
  mymrc_haul
  // ADR-0060 — one FLOOR-CONFIRMED aggregate row per (site, delivery day), written by an
  // operator on the iPad (`/operator/[site]/inbound`) when they confirm, correct, or enter
  // the day's inbound haul counts. This is the CONFIRMED terminal of the ADR-0059
  // provisional lifecycle: `confirmFloorInboundDay` retires the day's `mymrc_haul`
  // provisional and installs this row in one audited transaction. Precedence:
  // ipad_floor > paper_bulk > mymrc_haul (a day owned by an office `paper_bulk` row is
  // refused on the floor — office amends via the manager surface). The three-value
  // partial unique index (migration 20260812) keeps at most one aggregate row per
  // (site, day). Never a dock capture.
  ipad_floor
}

enum LoadStatus {
  expected // pre-arrival
  arrived // truck on dock, BOL captured
  weight_captured // optional weight ticket logged
  unload_started // door-open photo, timer running
  in_progress // counting stacks
  finished // timer stopped, ready to submit
  submitted // operator pressed submit
  verified // manager-verified gate before MRC submission (ADR-0012 §2)
  rejected // terminal: rejected at dock
  submitted_to_mymrc // entered into MyMRC (V2.1)
  processed // line crew finished deconstruction (V2.1)
  // ADR-0090 C — terminal: the load should never have been started. A mis-tapped
  // haul or a truck that never came. NOT a zero-unit delivery (that is a real
  // truck with a real count of nothing, and it goes through `submitted`).
  //
  // A new ENUM MEMBER rather than ADR-0084's `voided_at` column pair, and the
  // divergence is deliberate: every money path on this model already filters
  // through a status ALLOW-list (INVOICE_STATUSES, VERIFIED_INBOUND_STATUSES,
  // OPEN_DOCK_STATUSES, TAKEOVER_STATUSES, VERIFIABLE_FROM), so a new member is
  // excluded from all of them by construction. A nullable column would have been
  // opt-OUT — every one of those queries would need a new predicate and missing
  // one would be silent. Snapshots had no such allow-list (they are selected by
  // recency), which is why ADR-0084 answered the same question the other way.
  voided
}

/// ADR-0090 C — what the operator ASSERTS happened. A mis-click and a truck that
/// never arrived are different facts about the world, and collapsing them into
/// one "voided" would destroy the only signal that distinguishes a UI problem
/// from a carrier problem. Mirrors ADR-0077 D4's "not recorded" vs zero.
enum LoadVoidReason {
  wrong_haul // tapped the wrong card; another haul is the real one
  truck_never_arrived // the appointment existed, the truck did not
  other // requires a note
}

enum CountMode {
  ledger
  multiplier
  total
}

enum RejectionCategory {
  contamination
  damaged
  wet
  bedbugs
  short
  mislabeled
  other
}

enum ConcernCategory {
  damaged
  wet
  bedbugs
  contamination
  short
  mislabeled
  other
}

model InboundLoad {
  id               String        @id @default(uuid())
  site_id          String
  site             Site          @relation(fields: [site_id], references: [id])
  expected_load_id String?       @unique
  expected_load    ExpectedLoad? @relation(fields: [expected_load_id], references: [id])

  load_source_type LoadSourceType @default(b2b_haul)
  bol_number       String?
  source_id        String?
  source           Source?        @relation(fields: [source_id], references: [id])
  transporter_id   String?
  transporter      Transporter?   @relation(fields: [transporter_id], references: [id])

  // Operator
  assigned_operator_id String?
  assigned_operator    User?     @relation("LoadAssignedOperator", fields: [assigned_operator_id], references: [id])
  assigned_at          DateTime?

  submitted_by_id String?
  submitted_by    User?   @relation("LoadSubmittedBy", fields: [submitted_by_id], references: [id])

  // Workflow timestamps
  status                       LoadStatus @default(expected)
  dock_appointment_at          DateTime?
  arrived_at                   DateTime?
  weight_captured_at           DateTime?
  /// ADR-0124 — the operator declared this load has NO weight ticket ("None").
  ///
  /// It existed only as a `useState` in the browser, so the decision died on
  /// every reload and every takeover and the next operator was asked again. It
  /// is a real fact about the truck — somebody looked and there was no ticket —
  /// and the seven-stage dispatch now reads it instead of a latch. Distinct from
  /// `weight_captured_at`, deliberately: "no ticket" and "a ticket weighing
  /// nothing" are different claims, and a `weight_captured` status with a NULL
  /// `weight_lbs` would say the second while meaning the first.
  weight_skipped_at            DateTime?
  unload_started_at            DateTime? // when door-open photo submitted; timer reference
  unload_finished_at           DateTime?
  submitted_at                 DateTime?
  time_to_unload_start_seconds Int? // arrived_at → unload_started_at
  unload_duration_seconds      Int? // unload_started_at → unload_finished_at

  // Counts
  total_units Int?
  count_mode  CountMode?

  // Weight (US trucking standard, integer pounds)
  weight_lbs Int? // 1..100,000 valid range

  // Rejection
  rejection_category RejectionCategory?
  rejection_note     String?

  // ADR-0090 C — the void (a load that should never have been started).
  //
  // `status = 'voided'` is what every reader filters on; these columns carry the
  // FACTS, so "it was voided" and "why, by whom, when" cannot drift apart.
  voided_at   DateTime?
  voided_by   String? // bare scalar FK -> users.id, ON DELETE SET NULL (ADR-0084 pattern)
  void_reason LoadVoidReason?
  void_note   String? // required when void_reason = other
  /// The `expected_loads` slot this load was severed FROM.
  ///
  /// `expected_load_id` is UNIQUE, so a voided child would otherwise hold its
  /// parent slot forever and the real truck could never check in — the exact
  /// dead end ADR-0074 Am.1 closed from the other direction. The void NULLs
  /// `expected_load_id` (freeing the slot for `startInboundLoad`) and records
  /// the original here, so "which haul did they mis-tap?" stays answerable.
  /// Deliberately NOT a relation field: it is provenance, never navigated.
  voided_from_expected_load_id String?

  // Integration
  external_mymrc_haul_id      String?   @unique
  external_mymrc_materials_id String?
  mymrc_submission_deadline   DateTime? // arrived_at + 3 business days
  // ADR-0048 — workbook_promotions.id when this load was promoted from staging.
  import_id                   String?

  // ADR-0037 D2 — workbook Inbound-tab parity + Q8 segregation gate.
  // Re-TRAC is the universal external join key across every workbook record
  // type; kept DISTINCT from external_mymrc_haul_id (different systems). Not
  // unique — Re-TRAC ids can repeat across record types.
  retrac_id              String?
  slip_number            String? // workbook Slip # (present on every inbound tab)
  transport_charged      Boolean @default(false) // splits the two Inbound tabs
  freight_cents          Int? // load-level transportation charge (CA)
  fuel_surcharge_cents   Int? // CA only; an OR load can never carry one (D1 resolver refuses)
  // Q8 verify-gate split: program + non_program == total_units, enforced
  // server-side at the submitted→verified transition (verify-gate.ts).
  program_unit_count     Int?
  non_program_unit_count Int?

  // ADR-0041 (capture half) — Vision-assigned DR3 document number. Issued
  // atomically from `document_sequences` at the office VERIFY step for
  // Woodland-style (CA-jurisdiction) sites only; Eugene (OR) leaves this null
  // (their scan-timestamp lives in existing arrival fields). This ONE column on
  // an existing model is the documented exception to the "one contiguous
  // end-block" convention (a scalar column can't live in an end-block).
  dr3_number String?

  // ADR-0037 amendment (rollup §2/§14, Rick 2026-07-19) — "source of origin" provenance
  // AGENCY that brought the mattresses (Sponsors halfway house, Eugene Mattress Company,
  // U-Haul, …). ORTHOGONAL to `source` (the collection site / MyMRC-billing source): a
  // provenance agency never produces a billing line. Bare scalar FK → provenance_agencies.id
  // (constraint in migration), no Prisma relation — a scalar column can't live in a
  // self-contained end-block, the same documented exception as `dr3_number` above.
  provenance_agency_id String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  load_stacks   LoadStack[]
  load_photos   LoadPhoto[]
  load_concerns LoadConcern[]

  @@index([site_id, status])
  @@index([site_id, arrived_at])
  @@index([assigned_operator_id, status])
  @@index([retrac_id]) // ADR-0037 D2 — external join key for workbook parity
  @@index([site_id, transport_charged]) // ADR-0037 — Inbound-tab split queries
  @@index([provenance_agency_id]) // ADR-0037 amendment — provenance-agency lookups
  // ADR-0037 Phase 3 — one aggregate inbound row per site per day (partial unique index,
  // `WHERE load_source_type IN ('paper_bulk','mymrc_haul','ipad_floor')`). ADR-0059
  // generalized the ADR-0037 paper_bulk-only predicate to the MyMRC-haul aggregate, and
  // ADR-0060 widened it again to the iPad floor-confirmed aggregate, so at most ONE
  // aggregate inbound row can exist per (site, day) across ALL THREE source types — the
  // DB-level guard that makes a paper_bulk↔mymrc_haul↔ipad_floor double-count impossible.
  // (Per-load `b2b_haul` dock captures are NOT covered by the predicate; the aggregate-vs-
  // per-load double-count is guarded on the write path — ADR-0060 D5.) Declared in the
  // migration; Prisma has no partial-index syntax, so this @@index only mirrors the
  // lookup shape.
  @@index([site_id, load_source_type, arrived_at])
  @@map("inbound_loads")
}

model LoadStack {
  id          String      @id @default(uuid())
  load_id     String
  load        InboundLoad @relation(fields: [load_id], references: [id], onDelete: Cascade)
  stack_index Int // 1, 2, 3, ... MONOTONIC — never reused, see below
  unit_count  Int
  count_mode  CountMode // duplicate of parent's mode for debugging
  created_at  DateTime    @default(now())

  // ADR-0090 Amendment 1 (B) — a miscounted stack is SOFT-voided, never deleted.
  //
  // A stack is a BILLED unit: `finishUnload` sums `load_stacks` into
  // `total_units`. Deleting one would destroy the only record that the operator
  // ever counted it, and the audit log would point at a row that no longer
  // exists. So the row stays and both sum sites filter `voided_at IS NULL`.
  //
  // `@@unique(load_id, stack_index)` is deliberately left FULL rather than made
  // partial: `stack_index` is MONOTONIC (the client computes the next index over
  // every stack including voided ones), so an index is never reused, and the
  // positional meaning of the audit trail is preserved. A P2002 at an index that
  // holds a VOIDED row is therefore never a converged replay — it is a conflict,
  // and `addStack` answers 409 rather than resurrecting the void as a false 201.
  voided_at DateTime?
  voided_by String? // bare scalar FK -> users.id, ON DELETE SET NULL (ADR-0084 pattern)

  @@unique([load_id, stack_index])
  @@map("load_stacks")
}

enum PhotoKind {
  bol
  weight_ticket
  door_open
  concern
  rejection
}

model LoadPhoto {
  id                     String      @id @default(uuid())
  load_id                String
  load                   InboundLoad @relation(fields: [load_id], references: [id], onDelete: Cascade)
  kind                   PhotoKind
  storage_key            String // R2 object key for raw photo
  annotation_storage_key String? // R2 object key for annotated overlay
  width                  Int?
  height                 Int?
  byte_size              Int?
  captured_at            DateTime
  uploaded_at            DateTime    @default(now())
  purged_at              DateTime? // set when retention purge removes the R2 object

  // ADR-0078 Amendment 1 — WHO uploaded this photo.
  //
  // Before this the table recorded no uploader at all: the strict owner gate
  // enforced who was ALLOWED to upload and then kept no record of who did. The
  // gate is now site-scoped (see `load-photo-guard.ts`), so attribution stops
  // being implied by the gate and has to be written down.
  //
  // NULLABLE and NOT backfilled, deliberately. The rows that predate this
  // column have a genuinely unknown uploader — the session that created them
  // was never recorded — and inferring it from `assigned_operator_id` would
  // manufacture a claim about a person from data that does not support it. NULL
  // reads as "we do not know", which is true. (Same reasoning as ADR-0077's
  // "not recorded" over a fake 0.0.)
  //
  // No FK, matching the `idempotency_keys` precedent and for the same reason:
  // this is an attribution stamp, not a relational dependency, and it must not
  // be able to block a user mutation.
  uploaded_by            String?

  @@index([load_id, kind])
  @@map("load_photos")
}

model LoadConcern {
  id                     String          @id @default(uuid())
  load_id                String
  load                   InboundLoad     @relation(fields: [load_id], references: [id], onDelete: Cascade)
  category               ConcernCategory
  note                   String?
  note_locale            UserLocale?
  voice_note_storage_key String?
  raised_by_user_id      String?
  created_at             DateTime        @default(now())

  @@index([load_id])
  @@map("load_concerns")
}

// ────────────────────────────────────────────────────────────────────────
// Processing (V2.1 — schema present, UI deferred per ADR-0011)
// ────────────────────────────────────────────────────────────────────────

enum Shift {
  morning
  afternoon
  evening
}

model ProcessingSession {
  id                    String    @id @default(uuid())
  site_id               String
  site                  Site      @relation(fields: [site_id], references: [id])
  processor_user_id     String
  processor             User      @relation("SessionProcessor", fields: [processor_user_id], references: [id])
  session_date          DateTime  @db.Date
  shift                 Shift
  line_no               Int?
  lead_user_id          String?
  lead                  User?     @relation("SessionLead", fields: [lead_user_id], references: [id])
  authorized_by_user_id String?
  authorized_by         User?     @relation("SessionAuthorizedBy", fields: [authorized_by_user_id], references: [id])
  units_handled         Int       @default(0)
  units_processed       Int       @default(0)
  units_saved           Int       @default(0)
  units_leftover        Int       @default(0)
  notes                 String?
  submitted_to_mymrc_at DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  @@index([site_id, session_date])
  @@map("processing_sessions")
}

model ProcessorBonusRule {
  id             String    @id @default(uuid())
  site_id        String
  site           Site      @relation(fields: [site_id], references: [id])
  threshold_low  Int // e.g., 50
  rate_low       Decimal   @db.Decimal(10, 4) // OR: 1.0000, CA: 0.5000
  threshold_high Int // OR: 100, CA: 75
  rate_high      Decimal   @db.Decimal(10, 4) // 0.2500 both
  effective_date DateTime  @db.Date
  end_date       DateTime? @db.Date
  notes          String?

  @@index([site_id, effective_date])
  @@map("processor_bonus_rules")
}

// ────────────────────────────────────────────────────────────────────────
// MyMRC reconciliation
// ────────────────────────────────────────────────────────────────────────

// Sprint-1 T-016 — categorize each CSV row against DR3-Vision loads.
// `unmatched_in_dr3` / `unmatched_in_mymrc` retained for back-compat
// with the compliance-tile read; the parser writes the new
// `match_clean` / `count_mismatch` / `weight_mismatch` /
// `missing_in_dr3` / `missing_in_mymrc` shapes.
enum ReconciliationStatus {
  match_clean
  count_mismatch
  weight_mismatch
  missing_in_dr3
  missing_in_mymrc
  // Legacy aliases — kept for the v0.1 compliance read; the T-016
  // engine never writes these, but dropping them would break the
  // existing migration's enum values.
  unmatched_in_dr3
  unmatched_in_mymrc
  resolved
}

// Sprint-1 T-016 — operator's resolution decision for a discrepancy
// row. `unresolved` is the default at upload time; the manager
// chooses one of the three explicit actions.
enum ReconciliationResolution {
  unresolved
  dr3_correct
  mymrc_correct
  flag_followup
}

model MymrcReconciliation {
  id             String   @id @default(uuid())
  site_id        String
  period_start   DateTime @db.Date
  period_end     DateTime @db.Date
  uploaded_by_id String?
  uploaded_at    DateTime @default(now())

  // Idempotency: same file (sha256) + same site -> reuse the upload
  // session instead of creating duplicate items. The unique
  // constraint enforces this at the DB layer; the upload route
  // detects the collision and returns the existing session.
  filename       String
  content_sha256 String

  // Tolerance threshold the engine applied when categorizing this
  // file. Persisted so a later threshold change does not retroactively
  // reclassify historical items.
  weight_tolerance_pct Decimal @db.Decimal(5, 2)

  total_rows      Int
  // Legacy roll-ups (kept so the compliance tile keeps reading the
  // same fields). Engine sets `matched_count = match_clean_count` and
  // `unmatched_count = total_rows - matched_count`.
  matched_count   Int
  unmatched_count Int
  resolved_count  Int @default(0)

  // T-016 by-category counts. Snapshot at upload; do not recompute on
  // resolution-write (resolution is a separate audit-tracked decision,
  // not a re-categorization).
  match_clean_count      Int @default(0)
  weight_mismatch_count  Int @default(0)
  count_mismatch_count   Int @default(0)
  missing_in_dr3_count   Int @default(0)
  missing_in_mymrc_count Int @default(0)

  items MymrcReconciliationItem[]

  @@unique([site_id, content_sha256])
  @@index([site_id, period_start])
  @@map("mymrc_reconciliations")
}

model MymrcReconciliationItem {
  id                     String              @id @default(uuid())
  reconciliation_id      String
  reconciliation         MymrcReconciliation @relation(fields: [reconciliation_id], references: [id], onDelete: Cascade)
  external_haul_id       String
  external_delivery_date DateTime?           @db.Date
  external_source_name   String? // raw "Collection Site" from CSV
  external_unit_count    Int?
  external_weight_lbs    Int?

  // DR3-side snapshot at upload time, captured for the table view +
  // resolution UI so the manager sees both sides without a second
  // join. Null for `missing_in_dr3` rows.
  matched_load_id String?
  dr3_unit_count  Int?
  dr3_weight_lbs  Int?

  status ReconciliationStatus

  // Resolution decision. `unresolved` until the manager picks one of
  // {dr3_correct, mymrc_correct, flag_followup}. Audit-logged on every
  // change.
  resolution       ReconciliationResolution @default(unresolved)
  resolution_notes String?
  resolved_at      DateTime?
  resolved_by_id   String?

  @@index([reconciliation_id, status])
  @@index([external_haul_id])
  @@map("mymrc_reconciliation_items")
}

// ────────────────────────────────────────────────────────────────────────
// Daily production report (ADR-0030) — per-site config, recipients, send log.
// ────────────────────────────────────────────────────────────────────────

model BonusDailyReportConfig {
  id      String @id @default(uuid())
  site_id String @unique
  site    Site   @relation(fields: [site_id], references: [id])

  enabled               Boolean  @default(false)
  /// Pacific wall-clock time as HH:MM:SS. DST handled by the daemon/runner.
  send_time_pt          DateTime @db.Time
  subject_template      String   @default("DR3 Daily Production Report — {site} — {date}")
  skip_if_zero          Boolean  @default(true)
  skip_weekends         Boolean  @default(false)
  skip_holidays         Boolean  @default(false)
  include_bonus_dollars Boolean  @default(true)
  include_comparisons   Boolean  @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  recipients BonusDailyReportRecipient[]

  @@map("bonus_daily_report_config")
}

model BonusDailyReportRecipient {
  id               String                 @id @default(uuid())
  config_id        String
  config           BonusDailyReportConfig @relation(fields: [config_id], references: [id], onDelete: Cascade)
  email            String
  added_by_user_id String?
  added_by         User?                  @relation("BonusDailyReportRecipientAdder", fields: [added_by_user_id], references: [id])
  added_at         DateTime               @default(now())

  @@unique([config_id, email])
  @@index([config_id])
  @@map("bonus_daily_report_recipients")
}

model BonusDailyReportLog {
  id                String    @id @default(uuid())
  site_id           String
  site              Site      @relation(fields: [site_id], references: [id])
  report_date       DateTime  @db.Date
  sent_at           DateTime  @default(now())
  recipient_count   Int
  total_today       Int
  total_bonus_cents Int
  mtd_total         Int
  delivered_count   Int
  graph_message_id  String?
  last_status       Int?
  // 2026-07-11 (Bill directive): a late entry save still pushes the report out
  // immediately, flagged with when the data was submitted. `late_submission`
  // marks a report (re)sent by the on-save path after the scheduled send time;
  // `data_entered_at` is the save instant shown in the banner; `resend_count`
  // counts on-save re-sends that superseded an earlier send for the same day.
  late_submission   Boolean   @default(false)
  data_entered_at   DateTime?
  resend_count      Int       @default(0)
  // ADR-0037 Phase 4 (EOD inventory truthfulness) — a compact fingerprint of the
  // EOD inventory carried by the last send (state + program + non-program +
  // flow-recency). The resend decision compares this so an INVENTORY change
  // re-sends even when the mattress totals are unchanged (the number in the
  // team's last email must reflect current data, not a stale mid-day floor).
  // Null on rows written before this column / when no inventory section shipped.
  eod_inventory_sig String?
  // ADR-0076 — distinct-processor headcounts as sent (the "harness" half of the
  // directive: the log is where the report's own numbers become queryable).
  // Nullable, no default: the ~300 rows before this column genuinely did not
  // carry these figures; a 0 default would assert a false fact about past sends.
  // Mirrors the total_today/mtd_total precedent — comparisons are not stored.
  processors_today  Int?
  processors_mtd    Int?
  created_at        DateTime  @default(now())

  @@unique([site_id, report_date])
  @@index([sent_at(sort: Desc)])
  @@map("bonus_daily_report_log")
}

// ────────────────────────────────────────────────────────────────────────
// Audit log (append-only, indefinite retention per ADR-0007)
// ────────────────────────────────────────────────────────────────────────

enum AuditAction {
  insert
  update
  delete
  soft_delete
  restore
}

model AuditLog {
  id            String      @id @default(uuid())
  actor_user_id String?
  actor         User?       @relation(fields: [actor_user_id], references: [id])
  actor_label   String? // e.g. 'system:mymrc-scrape', 'system:r2-purge'
  action        AuditAction
  table_name    String
  row_id        String
  before        Json? // null for inserts
  after         Json? // null for deletes
  ip            String?
  user_agent    String?
  created_at    DateTime    @default(now())

  // Bonus amendment workflow (ADR-0028)
  bonus_amendments_applied BonusAmendmentRequest[] @relation("BonusAmendmentAppliedAudit")

  @@index([table_name, row_id])
  @@index([actor_user_id, created_at])
  @@index([action, created_at])
  @@map("audit_log")
}

// ────────────────────────────────────────────────────────────────────────
// Admin file-drop inbox (O-2, 2026-07-16)
// ────────────────────────────────────────────────────────────────────────
//
// A raw capture inbox: an admin uploads ANY file through /admin/file-drop; the
// bytes go to R2 (`file-drops/<id>/<sanitized-name>`) and one manifest row lands
// here. Classification/routing is a DOWNSTREAM human step (Claude Code reads the
// manifest + downloads the object) — this table only CAPTURES. `detected_kind` is
// an advisory hint (best-effort, by extension/content-type), never load-bearing.
// `uploaded_by` is a bare audit-actor user id with NO FK, matching the AP audit
// columns (held_by / decided_by).

enum FileDropStatus {
  received
  routed
  discarded
}

model FileDrop {
  id                String         @id @default(uuid())
  original_filename String
  content_type      String
  byte_size         Int
  r2_key            String
  status            FileDropStatus @default(received)
  detected_kind     String? // advisory classification hint (workbook/pdf_document/csv/image/other)
  note              String? // operator annotation of what was done with the file
  uploaded_by       String // bare audit-actor user id (no FK; mirrors AP held_by/decided_by)
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt

  // ADR-0067 — provenance. Defaults keep every pre-ADR-0067 row correct with no
  // backfill: they WERE manual uploads. `doc_source_id` is the coarse
  // "everything that came from this shared document" link; the exact revision
  // that produced this drop is on DocSourceVersion.file_drop_id.
  ingest_source DocIngestSource @default(manual)
  doc_source_id String?
  doc_source    DocSource?      @relation(fields: [doc_source_id], references: [id], onUpdate: Cascade, onDelete: SetNull)

  doc_source_versions DocSourceVersion[]

  @@index([status, created_at])
  @@index([created_at])
  @@index([ingest_source, created_at])
  @@index([doc_source_id])
  @@map("file_drops")
}

// ────────────────────────────────────────────────────────────────────────
// ADR-0067 — shared-file document ingestion
// ────────────────────────────────────────────────────────────────────────
//
// Documents STAY where they live in Microsoft, shared to the `docs-dr3@svdp.us`
// service account; Vision reads the LIVE document. Email forwarding gives a
// snapshot, file sharing gives current state — that distinction is the whole
// point, and it is why this model is version-aware rather than drop-shaped.
//
// Auth is delegated authorization-code + refresh token (Amendment A, which
// supersedes §3.5 entirely). NOT ROPC. The service-account password is used
// once, by a human, in a browser, and never becomes a runtime credential — so
// there is deliberately no column for it anywhere below.

/// How a captured file entered Vision. `manual` is the pre-ADR-0067 world and
/// stays the default forever.
enum DocIngestSource {
  manual
  email
  shared_file
}

enum DocSourceKind {
  file
  folder
}

/// `access_denied` is deliberately NOT folded into `disappeared`. A revoked
/// share and a deleted file look identical from a 404 but need different
/// operator action; collapsing them is how "the document is gone" silently
/// becomes "nobody noticed the share lapsed".
enum DocSourceState {
  active
  disappeared
  access_denied
}

enum DocIngestSubscriptionState {
  pending
  active
  expired
  failed
  revoked
}

enum DocIngestAnomalyKind {
  access_denied
  source_disappeared
  subscription_expired
  subscription_renew_failed
  delta_token_invalid
  download_failed
  checksum_mismatch
  oversize
  unclassified
  reauth_required
  // ── Pipeline phase (§3.2 D7 / D8, §A.9) ───────────────────────────────────
  /// The sharer's account was disabled or they left. Distinct from
  /// `access_denied` (share revoked, account fine): the operator action is "who
  /// owns this now", and the alert must NAME the previous owner.
  owner_lost
  /// Password-protected or structurally unreadable. Marked and paged ONCE —
  /// never retried in a loop (see `DocSource.read_blocked_at`).
  unreadable
  /// A billing/inventory aggregate moved beyond the variance threshold. Uses the
  /// SAME either-trips $50-flat / 15% semantics as ADR-0046 Amendment 5 D-M5-4 —
  /// one anomaly concept in the system, not two.
  aggregate_variance
  /// A previously-populated column went empty/null across a revision.
  column_nulled
  /// The revision dropped more than the configured share of rows.
  row_count_drop
  /// The revision no longer parses as its REGISTERED classification. Also the
  /// ONLY trigger for re-classification — D5 forbids re-asking otherwise.
  parse_broken
  /// The Graph validation-token handshake failed. Surfaced rather than silently
  /// degrading to polling-only (§A.9): the sweep still guarantees correctness,
  /// but latency degrades and the operator must know.
  webhook_validation_failed
  /// The sweep itself failed. The sweep IS the correctness guarantee (D4).
  sweep_failed
  /// A vendor invoice was shared here. NOT routed by this pipeline — the AP
  /// mailbox (ADR-0046) is its address, and the detail line says so.
  misdirected_document
  /// A shared folder tree is deeper than the traversal limit. The limit bounds
  /// enumeration, but hitting it means files exist that Vision is NOT watching.
  depth_limit_reached
  // ── Absorption (ADR-0069) ─────────────────────────────────────────────────
  /// A confirmed absorbable document whose `site_id` is NULL. A NULL site is
  /// UNCLASSIFIED, never a guess (hard rule #2), so absorption REFUSES — and
  /// says so, because a document that silently never absorbs looks identical to
  /// one that absorbed nothing.
  absorption_refused
  /// The extractor ran and produced ZERO usable rows. Never treated as "the
  /// document was empty": far more likely the daily-row adapter's layout
  /// assumption failed against a real workbook. A silent zero here would look
  /// exactly like success on every surface — the whole failure history of this
  /// module in one line.
  absorption_empty
  // ── Discovery reachability (ADR-0080) ─────────────────────────────────────
  /// Vision can READ documents in scope that it is not WATCHING. The one guard
  /// the discovery layer never had: `sharedWithMe` under-reported for 902
  /// consecutive sweeps and no surface compared its answer against anything.
  /// Also raised when the probe itself cannot run — "we could not look" must
  /// never be recorded as "there is no gap".
  discovery_gap
  /// ADR-0112 — the probe SUCCEEDED and returned zero documents while Vision was
  /// demonstrably reading live ones in the same sweep. A separate kind from
  /// `discovery_gap` because it is a different question with a different answer:
  /// a gap is a human deciding whether a document belongs in the pipeline, this
  /// is the probe having stopped being able to answer at all. Recorded loudly
  /// because the alternative — the `gap 0` branch — reads as an all-clear.
  discovery_probe_contradiction
}

enum DocIngestAnomalySeverity {
  info
  warning
  critical
}

enum DocIngestAnomalyStatus {
  open
  acknowledged
  resolved
}

/// Two states, deliberately. There is no `degraded`: ingestion halts LOUDLY
/// rather than degrading quietly (Amendment A §A.6), so the only alternative to
/// `connected` is "a human must sign in again".
enum DocIngestConnectionState {
  connected
  reauth_required
}

/// The delegated Entra connection (Amendment A §A.7). Singleton row, same
/// AES-256-GCM-at-rest shape as MymrcAdminCredential (ADR-0057 D1/D9) with a
/// DEDICATED key from ~/.dr3-vision-secrets/ — never a `.env` credential.
/// tenant_id / client_id / account_upn / account_object_id are NOT secrets
/// (§A.1) and may appear in config, logs and API responses; the tokens are, and
/// the status read path never SELECTs them.
model DocIngestConnection {
  id String @id @default("singleton")

  tenant_id         String
  client_id         String
  account_upn       String // asserted == docs-dr3@svdp.us before any token is persisted
  account_object_id String?

  // The only durable credential. Rolled forward on every refresh.
  refresh_token_ciphertext String
  refresh_token_iv         String
  refresh_token_auth_tag   String
  refresh_token_issued_at  DateTime

  // Access-token cache. Nullable because an expired access token is a HEALTHY
  // state (the refresh token regenerates it); a missing refresh token is not.
  access_token_ciphertext String?
  access_token_iv         String?
  access_token_auth_tag   String?
  access_token_expires_at DateTime?

  key_version Int @default(1) // pins KDF+salt+cipher; bump to rotate scheme

  /// Verbatim scope string from the token endpoint, so the connect surface can
  /// diff granted-vs-required without re-deriving what Entra actually consented.
  granted_scopes String

  acquired_at        DateTime
  last_refresh_at    DateTime?
  last_refresh_error String?

  state           DocIngestConnectionState @default(connected)
  reauth_reason   String?
  reauth_since    DateTime?
  /// Last time reauth_required was PAGED — latches the re-page cooldown
  /// (ADR-0037) without ever suppressing the transition page itself.
  reauth_paged_at DateTime?

  /// OneDrive provisions ASYNCHRONOUSLY (§A.5). NULL is a legitimate
  /// "not provisioned yet", NOT an error — the first interactive sign-in creates
  /// the drive, so a 404 before that is expected.
  drive_id             String?
  drive_provisioned_at DateTime?
  drive_check_error    String?

  connected_by String // bare audit-actor user id (no FK)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("doc_ingest_connections")
}

/// One shared file or folder Vision watches.
model DocSource {
  id String @id @default(uuid())

  /// (drive_id, item_id) is THE natural key — a driveItem id is only unique
  /// within its drive, so the pair is what makes the sweep's upsert idempotent
  /// across a shared-with-me set spanning several people's OneDrives.
  drive_id String
  item_id  String
  kind     DocSourceKind @default(file)

  display_name String
  web_url      String?
  path_hint    String?
  owner_upn    String?
  content_type String?
  size_bytes   Int? // Int, not BigInt — matches FileDrop.byte_size, no JSON-serialization trap

  /// Site scoping (CLAUDE.md hard rule #2). NULL means UNCLASSIFIED, never
  /// "both" — read paths must not leak a NULL-site source into a site-scoped
  /// list. The classifier (next phase) sets it.
  site_id String?
  site    Site?   @relation(fields: [site_id], references: [id], onUpdate: Cascade, onDelete: SetNull)

  /// CONFIRMED classification. Unconstrained TEXT on purpose: the class
  /// vocabulary is not settled, and an enum would force a migration on every new
  /// document type discovered in the wild.
  ///
  /// D5 — classify once, confirm once, then LOCKED. A non-null `doc_class` IS
  /// the lock: the pipeline never re-asks. There is deliberately no separate
  /// boolean, because a boolean can drift out of agreement with this column.
  doc_class        String?
  doc_class_source String? // 'classifier' | 'operator'
  classified_at    DateTime?
  /// Confirmed reporting period, set alongside `doc_class`.
  period           String?
  classified_by    String? // bare audit-actor user id (no FK)

  /// The classifier's PROPOSAL, awaiting confirmation. Separate from the
  /// confirmed columns above so a proposal can never be mistaken for a decision.
  proposed_class              String?
  proposed_site_id            String?
  proposed_site               Site?     @relation("DocSourceProposedSite", fields: [proposed_site_id], references: [id], onUpdate: Cascade, onDelete: SetNull)
  proposed_period             String?
  proposed_confidence         Float?
  proposed_reasoning          String?
  proposed_source             String? // 'local' | 'claude' — which half of the hybrid
  classification_attempted_at DateTime?
  classification_error        String?

  /// Folder traversal (D8). `parent_item_id` is the containing folder's
  /// driveItem id within the SAME drive; NULL means this row is a shared ROOT
  /// (the thing a human actually shared), where `depth` is 0.
  parent_item_id String?
  depth          Int     @default(0)

  /// D8 "same file shared twice" — two people sharing one item yields ONE
  /// logical source (the (drive_id, item_id) key guarantees it). This counter is
  /// the EVIDENCE the dedup happened, so the surface can say so.
  shared_by_count Int @default(1)

  /// D8 "password-protected / unreadable — mark, page, DO NOT retry in a loop."
  /// This latch is what stops the loop. It clears when the CONTENT changes (a new
  /// ctag is a genuinely new file and earns exactly one more attempt), which is
  /// why the blocking ctag is recorded alongside the reason.
  read_blocked_at     DateTime?
  read_blocked_reason String?
  read_blocked_ctag   String?

  /// `ctag` changes on CONTENT change; `etag` on content OR metadata change. The
  /// sweep compares ctag to decide whether a new version row is warranted.
  etag             String?
  ctag             String?
  last_modified_at DateTime?

  state   DocSourceState @default(active)
  /// Operator kill switch, independent of `state`. `state` is what Microsoft
  /// says; `enabled` is what Bill says. Never conflate them.
  enabled Boolean        @default(true)

  first_seen_at    DateTime  @default(now())
  last_seen_at     DateTime  @default(now())
  disappeared_at   DateTime?
  last_ingested_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  versions       DocSourceVersion[]
  anomalies      DocIngestAnomaly[]
  file_drops     FileDrop[]
  /// ADR-0069 — reference figures absorbed from this document. Reference data
  /// only; the operational table has exactly one writer and it is workbook-sync.
  reference_rows DocReferenceRow[]

  @@unique([drive_id, item_id])
  @@index([state, enabled])
  @@index([site_id, doc_class])
  @@index([last_seen_at])
  @@index([drive_id, parent_item_id])
  // NOTE: the confirm-queue index (`classification_attempted_at`
  // WHERE doc_class IS NULL) is PARTIAL and therefore lives only in the
  // hand-written migration — Prisma cannot express a partial index.
  @@map("doc_sources")
}

/// Append-only observed history of a source. This is what makes "live document"
/// real. Bytes go to R2 (CLAUDE.md hard rule #7) — only the key is stored here,
/// never the blob and never a local path.
model DocSourceVersion {
  id            String    @id @default(uuid())
  doc_source_id String
  doc_source    DocSource @relation(fields: [doc_source_id], references: [id], onUpdate: Cascade, onDelete: Cascade)

  /// The content-change marker this version was cut on. UNIQUE per source —
  /// which is exactly what makes a re-delivered Graph notification a no-op
  /// instead of a duplicate ingest.
  ctag String
  etag String?

  size_bytes       Int?
  last_modified_at DateTime?
  modified_by      String?

  r2_key         String? // NULL until the bytes are fetched
  content_sha256 String?

  observed_at DateTime  @default(now())
  fetched_at  DateTime?
  ingested_at DateTime?

  /// The precise provenance edge: THIS revision became THAT drop.
  file_drop_id String?
  file_drop    FileDrop? @relation(fields: [file_drop_id], references: [id], onUpdate: Cascade, onDelete: SetNull)

  /// D6 + D7. After confirmation changes propagate AUTOMATICALLY — per-change
  /// approval would defeat the feature. The guardrail replaces that gate by
  /// catching ABNORMAL changes, so a version is in exactly one of three states:
  ///   applied   — auto-flowed (the normal case); `applied_at` set, audit written
  ///   staged    — a guardrail condition tripped; held for apply-or-discard
  ///   discarded — a human rejected the staged revision
  staged        Boolean   @default(false)
  staged_reason String?
  applied_at    DateTime?
  applied_by    String? // bare audit-actor user id (no FK)
  discarded_at  DateTime?
  discarded_by  String?

  /// The structural projection the guardrail compares revision-over-revision
  /// (row count, populated columns, numeric aggregates). It is the "after" of
  /// this comparison and the "before" of the next, which is why it is persisted
  /// rather than recomputed.
  parse_summary Json?
  parse_error   String?

  /// ── ADR-0069 absorption ledger ──────────────────────────────────────────
  /// Set when a TERMINAL absorption attempt completed for this revision
  /// (absorbed / empty / unreadable / not_absorbable). It is the "do not
  /// re-download this revision every 15 minutes" latch. Deliberately NOT set on
  /// a REFUSAL: a refusal is caused by missing operator input (an unconfirmed
  /// site) and must re-attempt for free the moment that input arrives.
  absorbed_at       DateTime?
  /// 'absorbed' | 'refused_unclassified_site' | 'empty' | 'unreadable' |
  /// 'not_absorbable'. Unconstrained TEXT for the same reason `doc_class` is —
  /// the outcome vocabulary grows as more document kinds become absorbable.
  absorption_status String?
  /// Reference rows this revision produced. The point of the column is that
  /// "produced nothing" is a NUMBER on a screen, not an absence nobody notices.
  absorption_rows   Int       @default(0)
  /// The operator-actionable reason absorption produced no rows. Never
  /// credentials, never a stack trace.
  absorption_error  String?

  created_at DateTime @default(now())

  anomalies      DocIngestAnomaly[]
  reference_rows DocReferenceRow[]

  @@unique([doc_source_id, ctag])
  @@index([doc_source_id, observed_at])
  @@index([file_drop_id])
  // NOTE: the staged-queue index (`observed_at` WHERE staged) and the absorption
  // work-queue index (`applied_at` WHERE applied_at IS NOT NULL AND absorbed_at
  // IS NULL) are PARTIAL and live only in the hand-written migration — Prisma
  // cannot express them.
  @@map("doc_source_versions")
}

/// ADR-0069 — the ABSORPTION BRIDGE's landing table: what a shared spreadsheet
/// CLAIMS about a production day, with full provenance.
///
/// ── The one-writer rule ───────────────────────────────────────────────────
/// `src/lib/workbook-sync/` (ADR-0049) is the system of record for
/// `processed_units_daily`. Doc-ingest never writes that table. This model is the
/// separate, explicitly-REFERENCE landing zone that makes the separation real
/// rather than a convention: there is no source discriminator that would let both
/// pipelines write one table, and no "upsert when workbook-sync hasn't" fallback.
///
/// Nothing computes payroll, billing, bonus or inventory from these rows. The only
/// consumer is `src/lib/doc-ingest/reconciliation.ts`, which compares them against
/// `processed_units_daily` and reports agreement, disagreement and coverage — the
/// measuring device for "has Vision taken this over yet?".
model DocReferenceRow {
  id String @id @default(uuid())

  /// Provenance to the document AND the exact revision. Both, so a reference
  /// figure always traces to the bytes it came from and superseded revisions stay
  /// readable as history.
  doc_source_id         String
  doc_source            DocSource        @relation(fields: [doc_source_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  doc_source_version_id String
  doc_source_version    DocSourceVersion @relation(fields: [doc_source_version_id], references: [id], onUpdate: Cascade, onDelete: Cascade)

  /// NOT NULL, and that is hard rule #2 enforced at the storage layer rather than
  /// in application code. Absorption refuses an unclassified source; this makes it
  /// impossible for a later code path to quietly change its mind and write a
  /// guessed site.
  site_id String
  site    Site   @relation(fields: [site_id], references: [id], onUpdate: Cascade)

  /// The day the spreadsheet is making a claim about. `@db.Date`, not a timestamp:
  /// a production day is a day, and storing an instant invites a timezone bug in a
  /// Pacific-operating org whose servers run UTC.
  production_date DateTime @db.Date

  metric DocReferenceMetric
  /// Decimal(12,2) is deliberately WIDER than the operational column's
  /// Decimal(7,1): reference data records what the spreadsheet said, including a
  /// figure Vision would reject — which is exactly the discrepancy worth surfacing.
  value  Decimal            @db.Decimal(12, 2)

  /// Cell-level provenance, so a disagreement can be chased into the workbook
  /// instead of merely reported.
  source_sheet String?
  source_row   Int?

  extracted_at DateTime @default(now())
  created_at   DateTime @default(now())

  @@unique([doc_source_version_id, production_date, metric])
  @@index([site_id, production_date])
  @@index([doc_source_id])
  @@map("doc_reference_rows")
}

/// ADR-0069 — the reference metric vocabulary. Deliberately CLOSED, unlike
/// `doc_sources.doc_class`.
///
/// The invariant that makes the reconciliation TOTAL: every value here names a real
/// column of `processed_units_daily`. A metric with no counterpart column could be
/// extracted but never compared — reference data unable to answer the only question
/// the table exists to answer.
enum DocReferenceMetric {
  stripped_program
  stripped_non_program
  saved_units
}

/// Graph change-notification + delta state. Built by the NEXT phase; the table
/// lands now so the sweep/renewal worker has a durable home and anomalies can
/// reference a subscription from day one.
model DocIngestSubscription {
  id String @id @default(uuid())

  drive_id         String
  resource         String // e.g. /drives/{driveId}/root
  subscription_id  String? // Graph-assigned; NULL until created
  notification_url String

  /// HASH of the clientState secret, never the secret. The webhook compares a
  /// hash of the value Graph echoes back; storing plaintext would put a
  /// bearer-equivalent value in every DB backup for no gain.
  client_state_hash String?

  expires_at      DateTime?
  last_renewed_at DateTime?
  renew_after     DateTime? // scheduler wake time

  /// Opaque Graph deltaLink. Never parsed, only replayed. An invalidated token
  /// is a `delta_token_invalid` anomaly + full re-enumeration, never a silent skip.
  delta_link      String?
  delta_synced_at DateTime?

  state         DocIngestSubscriptionState @default(pending)
  failure_count Int                        @default(0)
  last_error    String?

  /// When Graph last actually DELIVERED a notification here. The only honest
  /// measure of whether push works — `state = active` merely means the
  /// subscription exists. Active-but-never-delivered is exactly the silent
  /// webhook failure the sweep exists to cover (§A.9).
  last_notification_at   DateTime?
  /// When the validation-token handshake last succeeded. NULL on an active
  /// subscription means push was never empirically proven.
  validated_at           DateTime?
  notifications_received Int       @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  anomalies DocIngestAnomaly[]

  @@unique([subscription_id])
  @@index([state, renew_after])
  @@index([drive_id])
  @@map("doc_ingest_subscriptions")
}

/// The guardrail ledger. Detection is the NEXT phase's; the ledger is here so it
/// has an idempotent target. `fingerprint` + a PARTIAL unique index over OPEN
/// rows is what makes "raise this anomaly" safe to call on every sweep: a
/// recurring condition bumps `occurrences`/`last_seen_at` instead of growing a
/// row-per-poll queue. Resolved rows are RETAINED — they are the evidence that a
/// thing was wrong and got fixed.
///
/// NOTE: the partial index (`WHERE status = 'open'`) is expressed in the
/// hand-written migration, not here — Prisma cannot model a partial unique
/// index. `@@unique([fingerprint])` is deliberately ABSENT for that reason;
/// writers must go through the raiser helper, not a bare `upsert`.
model DocIngestAnomaly {
  id String @id @default(uuid())

  doc_source_id String?
  doc_source    DocSource? @relation(fields: [doc_source_id], references: [id], onUpdate: Cascade, onDelete: SetNull)

  subscription_id String?
  subscription    DocIngestSubscription? @relation(fields: [subscription_id], references: [id], onUpdate: Cascade, onDelete: SetNull)

  /// Which REVISION this anomaly is about. Required for the before/after diff on
  /// /admin/doc-ingest/anomalies and so apply-or-discard knows its target.
  doc_source_version_id String?
  doc_source_version    DocSourceVersion? @relation(fields: [doc_source_version_id], references: [id], onUpdate: Cascade, onDelete: SetNull)

  kind     DocIngestAnomalyKind
  severity DocIngestAnomalySeverity @default(warning)
  status   DocIngestAnomalyStatus   @default(open)

  fingerprint String // stable dedup key: kind + the entity it is about
  detail      String
  context     Json?

  occurrences   Int      @default(1)
  first_seen_at DateTime @default(now())
  last_seen_at  DateTime @default(now())

  resolved_at     DateTime?
  resolved_by     String? // bare audit-actor user id (no FK)
  resolution_note String?

  /// Last time THIS anomaly paged. Same reasoning as
  /// `DocIngestConnection.reauth_paged_at`: `publishNtfy`'s cooldown ledger is
  /// per-process and per-container, so it would either re-page on every restart
  /// or suppress the FIRST page after one. This column is the ledger every
  /// process shares.
  last_paged_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([status, severity, last_seen_at])
  @@index([doc_source_id])
  @@index([subscription_id])
  @@index([doc_source_version_id])
  @@map("doc_ingest_anomalies")
}

/// The sweep ledger. Mirrors `ap_poll_runs` (ADR-0046 C6) and for the same
/// reason: the row is ALWAYS written, including on throw. Without it, "the sweep
/// has not run in three weeks" is invisible — which is exactly how MyMRC
/// ingested nothing for months (ADR-0057 D9). The health surface reads
/// `last sweep` from here, and a stale ledger is itself the alarm.
/// ADR-0019.4 — one row per signature-chain health poll (per site).
///
/// A LEDGER, not a mutable state row. The previous row's `status` IS the
/// last-known state that `decideChainPage` compares against, so paging survives
/// a container restart — `publishNtfy`'s cooldown ledger is per-process and
/// every deploy recreates the cron, which would otherwise re-page on each
/// deploy. Keeping the history also makes "the chain check has not run since
/// Tuesday" visible instead of silent, the same reason doc_ingest_sweep_runs
/// always writes a row.
model BonusChainHealthRun {
  id         String   @id @default(uuid())
  observed_at DateTime @default(now())

  site_id String
  site    Site   @relation(fields: [site_id], references: [id])

  /// 'green' | 'amber' | 'red'. TEXT not an enum so a new tier never needs a
  /// migration; values are asserted in code.
  status String

  /// Full ChainFinding[] as returned by evaluateChainHealth — the evidence for
  /// the status, kept so a past red can be explained after the chain is fixed.
  findings Json

  /// True when this observation fired an ntfy (leading edge or re-page).
  paged Boolean @default(false)

  @@index([site_id, observed_at])
  @@index([observed_at])
  @@map("bonus_chain_health_runs")
}

model DocIngestSweepRun {
  id          String    @id @default(uuid())
  started_at  DateTime  @default(now())
  finished_at DateTime?

  /// 'ok' | 'partial' | 'failed' | 'halted' | 'skipped'. TEXT rather than an
  /// enum so a new outcome never needs a migration; values are asserted in code.
  status String

  /// 'scheduled' | 'notification' | 'manual' — WHY this run happened. A fleet of
  /// `notification` runs with no `scheduled` ones means the cron is dead and only
  /// push is keeping things current: the exact posture D4 forbids relying on.
  trigger String @default("scheduled")

  sources_discovered    Int @default(0)
  sources_updated       Int @default(0)
  versions_created      Int @default(0)
  versions_applied      Int @default(0)
  versions_staged       Int @default(0)
  anomalies_raised      Int @default(0)
  subscriptions_renewed Int @default(0)

  error  String? // human error text; never credentials or PII
  run_id String? // per-run correlation id (crypto.randomUUID)

  created_at DateTime @default(now())

  @@index([started_at])
  @@index([status, started_at])
  @@map("doc_ingest_sweep_runs")
}

// ────────────────────────────────────────────────────────────────────────
// Form templates (V2.2+ extensibility hook; not used in MVP)
// ────────────────────────────────────────────────────────────────────────

model FormTemplate {
  id          String   @id @default(uuid())
  site_id     String?
  code        String   @unique
  name        String
  schema_json Json // form schema
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("form_templates")
}

// ────────────────────────────────────────────────────────────────────────
// Bonus Management System (ADR-0019) — Woodland processor daily bonus.
// Site-scoped so Eugene can be enabled in V2.1+ with no migration.
// ────────────────────────────────────────────────────────────────────────

enum BonusPayPeriodState {
  draft // current period, daily entries being added
  pending_signatures // period closed, awaiting first signature
  partially_signed // one signature in, awaiting second
  signed // both signatures captured, PDF generated
  paid // PDF sent to payroll@svdp.us via M365 Graph
  amended // post-signature edit (Bill-only override)
  skipped // NEW (ADR-0019.1): pre-cutover periods with no data; terminal, no PDF
  historical_imported // ADR-0023 — periods loaded from the historical spreadsheet
}

model BonusEmployee {
  id      String @id @default(uuid())
  site_id String
  site    Site   @relation(fields: [site_id], references: [id])

  // Display name — see ADR-0019 §9b for retroactive display behavior
  full_name      String
  previous_names Json? // [{ name: "...", changed_at: "..." }, ...]

  // Legacy roster employee number extracted from full_name (ADR-0026).
  // Nullable: only the 21 imported DR3 Woodland legacy rows carry one;
  // production-created processors have none. Uniqueness is enforced
  // per-site at the application layer, NOT in the DB — see ADR-0026.
  employee_number String?

  is_active Boolean @default(true)

  // Optional link to a system user — most processors are NOT system users
  user_id String?
  user    User?   @relation("BonusEmployeeUser", fields: [user_id], references: [id])

  notes      String?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime? // soft delete; rehire reactivates per ADR-0019 §9a

  daily_entries BonusDailyEntry[]
  aliases       BonusEmployeeAlias[]

  // Bonus amendment workflow (ADR-0028)
  amendment_requests BonusAmendmentRequest[]

  @@index([site_id, is_active])
  @@index([site_id, employee_number])
  @@map("bonus_employees")
}

model BonusDailyEntry {
  id                  String         @id @default(uuid())
  bonus_employee_id   String
  bonus_employee      BonusEmployee  @relation(fields: [bonus_employee_id], references: [id])
  bonus_pay_period_id String // was bonus_month_id
  bonus_pay_period    BonusPayPeriod @relation(fields: [bonus_pay_period_id], references: [id])

  entry_date     DateTime @db.Date
  mattress_count Decimal  @db.Decimal(5, 1) // 0..999 valid, soft-warn above 200; Decimal(5,1) per ADR-0023 (historical half-shift values + decimal UI going forward)
  /// ADR-0083 — mattresses SAVED for resale, keyed beside the processed count in
  /// the same daily entry (JT: "a dedicated saves field beside processed"). A save
  /// is a PAID unit: the day's bonus is computed on `mattress_count + saves` through
  /// the one calculator (`dailyPaidUnits`), so the tier thresholds apply ONCE to the
  /// day's total work rather than twice. It is NOT a processed unit — every
  /// production-QUANTITY read path (daily report, processor quota, MRC-adjacent
  /// totals) stays on `mattress_count` alone, which is what makes the two columns
  /// disjoint quantities and the double-count structurally impossible.
  ///
  /// `Decimal(5,1)` mirrors `mattress_count` exactly (same range, same one-decimal
  /// resolution, same validator) so the two can be summed without a precision seam.
  ///
  /// NOT NULL DEFAULT 0, and the backfill is a REAL zero, not a not-recorded: every
  /// historical row predates the column on a floor where saves were not being
  /// captured in the bonus entry at all, so "this employee saved 0 mattresses that
  /// day, for bonus purposes" is the true statement. That truthfulness is what lets
  /// the sign-time lock and the ADR-0033 reconcile recompute historical signed
  /// periods with saves in the formula and get byte-identical totals — see ADR-0083.
  saves          Decimal  @default(0) @db.Decimal(5, 1)
  note           String? // optional HR annotation, does NOT affect math

  // Sprint 3 / ADR-0023: provenance for historical imports. NULL for
  // production entries; populated for every row loaded via the historical
  // spreadsheet import. See bonus_imports for the session this row belongs
  // to; import_provenance is the raw forensic payload.
  legacy_total_cents Int?
  import_session_id  String?
  import_provenance  Json?
  bonus_import       BonusImport? @relation(fields: [import_session_id], references: [id])

  // Who actually keyed this entry — could be Janette, Morena, or Bill per ADR-0019 §4
  entered_by_user_id String
  entered_by         User     @relation("BonusEntryAuthor", fields: [entered_by_user_id], references: [id])
  entered_at         DateTime @default(now())

  @@unique([bonus_employee_id, entry_date])
  @@index([bonus_pay_period_id])
  @@index([entry_date])
  @@index([import_session_id])
  @@map("bonus_daily_entries")
}

// ────────────────────────────────────────────────────────────────────────
// Reporting-only production adjustments (ADR-0032).
//
// A SEPARATE, additive layer of signed per-day unit deltas that correct the
// Woodland production TOTALS (daily-report MTD + annual year-over-year quantity)
// to the operator's true paper figures — WITHOUT touching any bonus/payout
// dollars. Every bonus-DOLLAR read path queries `bonus_daily_entries` and never
// this table, so an adjustment can NEVER leak into payroll math; only
// production-QUANTITY read paths sum these rows. See ADR-0032.
//
// `created_by` is a scalar FK (ON DELETE SET NULL in SQL) with no Prisma relation
// field on User, intentionally — these rows are operator-loaded and we do not
// need to navigate user → adjustments.
// ────────────────────────────────────────────────────────────────────────
model BonusReportingAdjustment {
  id      String @id @default(uuid())
  site_id String
  site    Site   @relation(fields: [site_id], references: [id])

  entry_date DateTime @db.Date // UTC-midnight key for the Pacific calendar day
  units      Int // signed unit delta (+add / -subtract); whole mattresses
  reason     String
  created_by String?
  created_at DateTime @default(now())

  @@unique([site_id, entry_date])
  @@index([site_id, entry_date])
  @@map("bonus_reporting_adjustments")
}

model BonusPayPeriod {
  id      String @id @default(uuid())
  site_id String
  site    Site   @relation(fields: [site_id], references: [id])

  // ─── Period identity (NEW columns per ADR-0019.1) ──────────────────
  period_number Int // 1..26
  period_year   Int // e.g. 2026
  pay_date      DateTime @db.Date // Fri, ~4 days after period_end

  // ─── Boundaries (was month_start / month_end) ──────────────────────
  period_start DateTime            @db.Date // Tue
  period_end   DateTime            @db.Date // Mon (14 days after period_start, inclusive boundary)
  state        BonusPayPeriodState @default(draft)

  // ─── Facility signature (was janette_*; facility manager attestation) ──
  facility_signed_by_user_id String?
  facility_signed_by         User?     @relation("BonusFacilitySigner", fields: [facility_signed_by_user_id], references: [id])
  facility_signed_at         DateTime?
  facility_signed_ip         String?
  facility_signed_user_agent String?
  // Set when an override actor signed in the facility signer's place per ADR-0019 §5
  facility_override_actor_id String?
  facility_override_reason   String?
  // NEW (ADR-0019.1 §4): when the system auto-signed this slot. NULL = human signed.
  facility_auto_override_at  DateTime?

  // ─── Ops signature (was morena_*; operations manager attestation) ──
  ops_signed_by_user_id String?
  ops_signed_by         User?     @relation("BonusOpsSigner", fields: [ops_signed_by_user_id], references: [id])
  ops_signed_at         DateTime?
  ops_signed_ip         String?
  ops_signed_user_agent String?
  // Set when an override actor (Bill) signed in the ops signer's place per ADR-0019 §5
  ops_override_actor_id String?
  ops_override_reason   String?
  // NEW (ADR-0019.1 §4): when the system auto-signed this slot. NULL = human signed.
  ops_auto_override_at  DateTime?

  // ─── PDF artifact ──────────────────────────────────────────────────
  pdf_storage_key  String? // R2 key
  pdf_generated_at DateTime?

  // ─── Payroll delivery (M365 Graph mail-send per ADR-0021) ──────────
  // ADR-0117 — `payroll_attempt_at` is claimed IMMEDIATELY BEFORE the Graph
  // send; `payroll_sent_at` is stamped after a confirmed 202. The pair is what
  // makes a lost in-flight delivery distinguishable from one that never
  // started: attempt-and-no-stamp is AMBIGUOUS (page a human, never resend),
  // no-attempt is safe to re-drive. Do not collapse them back into one column.
  payroll_attempt_at  DateTime?
  payroll_sent_at     DateTime?
  payroll_message_id  String? // Graph request ID for audit correlation
  payroll_retry_count Int       @default(0)

  // ─── Amendment tracking per ADR-0019 §6 ────────────────────────────
  // If this period was created by amending an earlier period, points to it
  amended_from_period_id String?         @unique
  amended_from           BonusPayPeriod? @relation("BonusAmendment", fields: [amended_from_period_id], references: [id])
  amended_into           BonusPayPeriod? @relation("BonusAmendment")
  amendment_reason       String?
  amended_by_user_id     String?
  amended_by             User?           @relation("BonusAmender", fields: [amended_by_user_id], references: [id])
  amended_at             DateTime?

  // Computed at sign time, locked thereafter (re-computed only on amendment).
  // For historical_imported periods, this stores the corrected-formula
  // calculator output (threshold_high=74 for Woodland).
  total_payout_cents Int?

  // Sprint 3 / ADR-0023: dual-total storage for historical_imported periods.
  // legacy_total_payout_cents is the sum of as-paid spreadsheet Total cells.
  // When imported_with_legacy_formula = true, PDF and payroll-export read from
  // legacy_total_payout_cents; the corrected total is informational only.
  legacy_total_payout_cents    Int?
  imported_with_legacy_formula Boolean      @default(false)
  import_session_id            String?
  bonus_import                 BonusImport? @relation(fields: [import_session_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  daily_entries BonusDailyEntry[]

  // Bonus amendment workflow (ADR-0028)
  amendment_requests BonusAmendmentRequest[]

  @@unique([site_id, period_start]) // semantically same as old (site_id, month_start)
  @@unique([site_id, period_year, period_number]) // NEW — fast canonical period lookup
  @@index([site_id, state])
  @@index([pay_date]) // NEW — upcoming-deadline queries
  @@map("bonus_pay_periods")
}

// ────────────────────────────────────────────────────────────────────────
// NEW table: bonus_signature_chains (per ADR-0019.2 §2)
// Per-site configuration of who signs which slot and who can override.
// Seeded for both sites at deploy time (T-201).
// ────────────────────────────────────────────────────────────────────────

model BonusSignatureChain {
  id      String @id @default(uuid())
  site_id String @unique
  site    Site   @relation(fields: [site_id], references: [id])

  // Facility slot
  facility_signer_user_id     String
  facility_signer             User   @relation("BonusFacilitySignerConfig", fields: [facility_signer_user_id], references: [id])
  // Comma-separated list of user UUIDs that may override the facility slot.
  // Stored as a string for portability; parsed at use site (cardinality <= 3).
  facility_override_actor_ids String // e.g. "uuid-bill,uuid-morena" for Woodland

  // Ops slot
  ops_signer_user_id     String
  ops_signer             User   @relation("BonusOpsSignerConfig", fields: [ops_signer_user_id], references: [id])
  ops_override_actor_ids String // e.g. "uuid-bill" for Woodland (Bill-only override)

  // The user who fires the auto-override at Tue 08:30 PT per ADR-0019.1 §4.
  // Same across all sites today (Bill); future-flexible.
  auto_override_actor_user_id String
  auto_override_actor         User   @relation("BonusAutoOverrideActor", fields: [auto_override_actor_user_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("bonus_signature_chains")
}

