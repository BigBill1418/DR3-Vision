// ════════════════════════════════════════════════════════════════════════
// ADR-0049 — workbook sync
//
// Woodland workbook → Vision sync bridge. Polls Kelsey's OneDrive (Graph
// `Files.Read.All`) for the current month's daily-log `.xlsm`, delta-detects,
// parses via the SHARED ADR-0048/0039 parser, and upserts into the operational
// daily-production table under the workbook-wins conflict rule (pre-cutover).
// Mock-first (ADR-0046 discipline): a real Graph Files transport and a fixture
// transport satisfy one interface, so the engine is testable without the tenant.
// FK columns are PLAIN SCALARS (repo convention, mirrors rollout_surfaces /
// yard_trailers) — constraints live in the migration; the Site relation list is
// never edited by this block.
// ════════════════════════════════════════════════════════════════════════

/// D1 self-reported transport for a sync run (mirrors ApTransportMode). `mock` is
/// the fixture-driven default until the Files.Read.All grant + real file land.
enum WorkbookSyncTransportMode {
  mock
  graph
}

/// Run-ledger status (mymrc_sync_runs shape). `forbidden` is the D6/test-plan-8
/// fail-soft state: the `Files.Read.All` grant is missing (Graph 403) — logged +
/// ntfy'd, never a crash. `not_found` = the current month's file was not
/// discoverable (a possibly-empty new-month state, D5).
enum WorkbookSyncStatus {
  ok
  forbidden
  not_found
  error
  /// ADR-0049 Am.3 A4 — the poll did NOT run to a conclusion and NOTHING was
  /// written, and that is not a fault. Two cases: the rollout state could not be
  /// read (fail-safe: we cannot know whether the site is cut over, so we do not
  /// upsert), and the workbook does not yet carry enough to date its close rows.
  /// Both used to be recorded as `ok` — the first with `cutover_noop: true`,
  /// which asserted a site was cut over when it was not.
  skipped
}

/// D9 — one syncing source (a site's monthly workbook location). Woodland ships
/// day 1. Eugene will NEVER have a row: Rick's site runs on hand-filled paper
/// forms, no shared workbook exists (confirmed definitively 2026-07-09, rollup
/// §4.2 — the Eugene sample was a scanned paper SHIPMENT/LOGIN sheet). The
/// Eugene iPad UI goes direct paper→Vision; do not add a source row for it.
/// Born `is_syncing=false` — a
/// deliberate operator enable turns real polling on (the engine no-ops disabled
/// sources). `drive_upn` is the OneDrive owner UPN (Kelsey), resolved to a drive
/// per D4; `share_url` is an optional operator-configurable share pointer kept for
/// reference/audit. `last_file_ctag` is the delta guard (D2): unchanged cTag ⇒ no
/// re-download / re-parse.
model WorkbookSource {
  id             String    @id @default(uuid())
  site_id        String    @unique // one source per site (bare FK; constraint in migration)
  drive_upn      String // OneDrive owner UPN (Kelsey), D4 — resolves to a user drive
  folder_path    String    @default("") // OneDrive path under the drive root ('' = root)
  share_url      String? // optional operator-configurable share link (reference/audit)
  naming_pattern String    @default("{MONTH} {YEAR} DAILY LOG WOODLAND.xlsm") // D5 rollover pattern
  is_syncing     Boolean   @default(false) // born disabled; operator enables (D9)
  last_polled_at DateTime?
  last_file_id   String? // Graph item id of the last-synced monthly file
  last_file_name String? // resolved file name of the last-synced file
  last_file_ctag String? // D2 change-detection guard (unchanged ⇒ skip re-download)

  /// ADR-0049 Am.4 B1 — the PRIOR month's watermark, used only while the grace
  /// window is open. Separate from `last_file_*` on purpose: during the window two
  /// files are in flight for one source, and a single cTag slot cannot answer
  /// "unchanged?" for both. Sharing one would make each poll invalidate the other's
  /// watermark — and, worse, let a grace read mark a genuinely-changed current-month
  /// file as unchanged, dropping the change silently.
  grace_file_id   String?
  grace_file_name String?
  grace_file_ctag String?

  /// ADR-0049 Am.3 A4 — "we polled" was recorded and "we last got DATA" was not,
  /// so a source that had produced nothing for three weeks was indistinguishable
  /// from a healthy one. Set on every poll that READ the workbook (including a
  /// delta no-op and a legitimately empty month) — never on not_found, never on a
  /// refusal.
  last_success_at      DateTime?
  /// Consecutive non-success polls. Resets to 0 on any success. Drives the
  /// escalation ladder so a permanently-failing source pages once and then daily
  /// rather than ~28 identical times per business day.
  consecutive_failures Int       @default(0)
  /// When this source last PAGED. Durable on purpose: the ntfy cooldown ledger is
  /// in-process memory, so a container restart reset it and the flood resumed.
  last_alert_at        DateTime?
  created_by           String? // bare audit-actor column
  updated_by           String? // bare audit-actor column
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  runs WorkbookSyncRun[]

  @@map("workbook_sources")
}

/// mymrc_sync_runs-shape run ledger. ALWAYS written, including on throw / fail-soft.
/// `changes_detected=false` marks a delta no-op (unchanged cTag). Mid-edit rows
/// (required cells empty, D11) are counted in `rows_skipped_midedit` and retried
/// next poll with NO alert. `rows_overwritten` counts workbook-wins overwrites of a
/// disagreeing Vision-captured row (each carries an audit_log entry, D3).
model WorkbookSyncRun {
  id                   String                    @id @default(uuid())
  source_id            String
  source               WorkbookSource            @relation(fields: [source_id], references: [id], onDelete: Cascade)
  site_id              String
  started_at           DateTime                  @default(now())
  finished_at          DateTime?
  status               WorkbookSyncStatus
  transport_mode       WorkbookSyncTransportMode
  file_name            String? // the month's file name resolved this poll
  changes_detected     Boolean                   @default(false)
  rows_upserted        Int                       @default(0)
  rows_skipped_midedit Int                       @default(0)
  rows_overwritten     Int                       @default(0)
  /// ADR-0049 Am.4 B1 — this run read the PRIOR month's workbook inside the grace
  /// window. Without it a July-dated run sitting among August runs looks exactly
  /// like the A2 stale-month defect, which is the opposite of a healthy signal.
  grace_window         Boolean                   @default(false)
  /// Days the workbook wanted to change that were left alone because an APPROVED
  /// invoice already covers them. Non-zero means the spreadsheet and a sent invoice
  /// disagree and a human must decide — it is never a silent drop.
  rows_skipped_billed  Int                       @default(0)
  /// ADR-0123 — days the workbook wanted to change that a PERSON owns
  /// (`processed_units_daily.source = 'manual'`). Non-zero means the spreadsheet
  /// and a human correction disagree, and this sync deliberately leaves the
  /// human's figure standing. Before ADR-0123 the sync overwrote it and flipped
  /// `source` to 'import', which also locked the MyMRC bridge out of the row for
  /// good — audited, and destroyed.
  rows_skipped_manual  Int                       @default(0)
  cutover_noop         Boolean                   @default(false) // true when the surface is live (post-cutover): sync no-op'd
  error_text           String? // human error (never credentials)
  run_id               String? // per-run correlation id (crypto.randomUUID)
  created_at           DateTime                  @default(now())

  @@index([source_id, started_at])
  @@index([status, started_at])
  @@map("workbook_sync_runs")
}

// ADR-0041 amendment (2026-07-18) — SIMPLIFIED invoice generation
//
// Three additive surfaces for the launch of MRC billing (rollup §A.1/§A.7/§4.2):
//   1. Pilot/production mode (§3.4) — the launch safety net. `InvoiceMode` +
//      `invoice_mode_config` (per site+kind flip) + `invoice_pilot_recipients`
//      (Bill + Rick). A pilot invoice is STRUCTURALLY incapable of reaching MRC
//      (`planInvoiceDelivery`); production is the only mode whose delivery plan
//      resolves to MRC.
//   2. GP export identifiers (§4.2) — the Great-Plains boundary the v2 export
//      carries. Company-wide statics (MRC Bill-To/Ship-To, Sales ID 34, Net 30)
//      in a singleton `gp_billing_config`; per-site Customer ID + PO suffix in
//      `gp_site_billing_config` (CA seeded; OR/Eugene left NULL — pending Mary,
//      never invented).
//
// COORDINATION (mirrors the ADR-0040/0041/0042 block headers): self-contained
// end-block. `site_id` columns carry DB-level FOREIGN KEY constraints created in
// the migration `20260727_adr0041_pilot_mode_gp_export` rather than Prisma
// relations, so there are NO back-relation fields on the sibling-owned `Site`
// model. `mode`/`program_units_processed`/`non_program_units_processed` are the
// one exception (scalar columns can't live in an end-block) and live on the
// `Invoice` model above. `db pull` would see these FKs as drift, but ADR-0035
// clean-replay `migrate deploy` passes and referential integrity is enforced at
// the DB.
// ────────────────────────────────────────────────────────────────────────

/// ADR-0041 amendment §3.4 — the launch safety net. DEFAULT `pilot`: a pilot
/// invoice routes previews to the pilot recipients (Bill + Rick), never MRC. An
/// admin flips a (site, kind) to `production` — the only mode whose delivery plan
/// resolves to MRC — once Rick reconciles and signs off.
enum InvoiceMode {
  pilot
  production
}

/// ADR-0041 amendment §3.4 — the pilot preview roster (Bill + Rick). While ANY
/// invoice is in pilot mode, preview delivery goes to the ACTIVE rows here and
/// NOWHERE else (mirrors `alert_recipients` / `ap_decision_recipients`). Seeded
/// with Bill + Rick; admin-editable. A pilot with zero active recipients is a
/// refuse-and-page condition for a future sender, never a fall-through to MRC.
model InvoicePilotRecipient {
  id         String   @id @default(uuid())
  email      String   @unique
  name       String?
  active     Boolean  @default(true)
  created_by String? // bare audit-actor column
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([active])
  @@map("invoice_pilot_recipients")
}

/// ADR-0041 amendment §3.4 — per (site, kind) mode flip. No row ⇒ pilot (the
/// safe default; generation reads this and stamps `invoices.mode`). An admin
/// upserts a row with `mode = production` to graduate one (site, kind) off the
/// pilot. Keyed on (site_id, kind) so a site graduates each kind independently
/// (covers both "per site" and "per kind" from the spec with one model).
model InvoiceModeConfig {
  id         String      @id @default(uuid())
  site_id    String // FK → sites.id (constraint in migration)
  kind       InvoiceKind
  mode       InvoiceMode @default(pilot)
  updated_by String? // bare audit-actor column
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt

  @@unique([site_id, kind])
  @@map("invoice_mode_config")
}

/// ADR-0041 amendment §4.2 — company-wide GP statics (one row, id="singleton").
/// The MRC Bill-To/Ship-To address (same entity for both), the static Sales ID
/// (34) and Payment Terms (Net 30). Per-site identifiers (Customer ID, PO suffix)
/// live in `gp_site_billing_config`. Denormalized onto the v2 export at read.
model GpBillingConfig {
  id               String   @id @default("singleton")
  bill_to_name     String // "Mattress Recycling Council"
  bill_to_attn     String? // "Ryan Trainer"
  bill_to_street   String // "501 Wythe Street"
  bill_to_locality String // "Alexandria VA 22314"
  sales_id         String // "34"
  payment_terms    String // "Net 30"
  updated_by       String? // bare audit-actor column
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@map("gp_billing_config")
}

/// ADR-0041 amendment §4.2 — per-site GP identifiers. `customer_id` (CA MRC =
/// MRCL001; OR MRC = NULL, pending Mary) and `po_site_suffix` (Woodland = DR3W;
/// Eugene = NULL, pending Mary). NULLs are honest unknowns the v2 export renders
/// as null — the identifier is NEVER invented. `pending_note` records why a NULL
/// is a NULL so a future confirmation is a one-row edit, never a code change.
model GpSiteBillingConfig {
  id             String   @id @default(uuid())
  site_id        String   @unique // FK → sites.id (constraint in migration)
  customer_id    String? // CA=MRCL001; OR=null (pending Mary)
  po_site_suffix String? // Woodland=DR3W; Eugene=null (pending Mary)
  pending_note   String? // why a null is a null
  updated_by     String? // bare audit-actor column
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@map("gp_site_billing_config")
}

// ────────────────────────────────────────────────────────────────────────
// ADR-0037 amendment (rollup §2/§5.2/§14) — provenance agencies + unit-status ledger
// ────────────────────────────────────────────────────────────────────────

/// ADR-0037 amendment (rollup §2, Rick 2026-07-19) — the AGENCY of origin that
/// delivered mattresses to the shop (e.g. "Sponsors", a halfway house on Hwy 99
/// next to Lindholm; Eugene Mattress Company; U-Haul). Rick: *"they are treated
/// the same as Eugene Mattress Company or U-Haul … no billing on our side."*
/// ORTHOGONAL to `sources` (collection sites / MyMRC billing entities): a
/// provenance agency NEVER produces a billing line. `inbound_loads.provenance_agency_id`
/// (bare scalar FK) references this table. `Sponsors` moved here FROM the old
/// drop-off classification — it is no longer a source or a drop-off kind.
model ProvenanceAgency {
  id         String   @id @default(uuid())
  name       String   @unique
  notes      String?
  active     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("provenance_agencies")
}

/// ADR-0037 amendment (rollup §5.2/§14, Rick 2026-07-19) — status-bucketed unit
/// ledger. Rick's model REPLACES Kelsey's Addendum-A §A.2 "immediate subtraction":
/// *"Saved units are not removed from inventory until they are sent to a store."*
///
/// The ADR-0037 inventory is an AGGREGATE-LEDGER architecture (there is NO per-unit
/// `unit_records` table — the spec's `unit_records.*` is idealized). The faithful
/// shape here is an aggregate MOVEMENT ledger: each row records a count of units
/// crossing between status buckets (on_floor → saved, saved → sold, on_floor →
/// processed / landfilled, …). A live per-status floor count is the signed sum of
/// movements into vs out of each bucket. Intake rows carry `from_status = null`.
///
/// Divergence documented in docs/adr/0037-*.md amendment:
///   • `to_status = saved` does NOT decrement the live floor pool (units stay on the
///     floor per Rick) — this SUPERSEDES the `processed_units_daily.saved_units`
///     LIVE-subtraction semantics (running-balance.ts). The `saved_units` COLUMN is
///     retained: it is the workbook daily-log capture field and the HISTORICAL
///     closed-month audit reconciliation (inventory-close.ts / June 3,977 oracle)
///     depends on the workbook's own subtraction — that historical parity is
///     unchanged. The running-balance rewire (consume this ledger; stop subtracting
///     saved_units in onHand) is flagged for the inventory feature agent.
///   • `landfilled_reason` REUSES the existing `LandfilledReason` enum; the handoff's
///     "wet" maps to `water_logged` (no duplicate enum introduced).
/// Bare scalar FKs (site_id → sites.id, store_destination_id → sources.id),
/// constraints in migration — matches the self-contained collection_events pattern.
model UnitStatusMovement {
  id                   String            @id @default(uuid())
  site_id              String // FK → sites.id (constraint in migration)
  movement_date        DateTime          @db.Date
  units                Int
  from_status          UnitStatus? // null = intake into a bucket
  to_status            UnitStatus
  status_changed_at    DateTime          @default(now())
  // Set ONLY when to_status = landfilled (whole-unit disposal reason, §11).
  landfilled_reason    LandfilledReason?
  // Set ONLY on a saved → sold store transfer: the destination svdp_internal_store
  // source. Bare scalar FK → sources.id (constraint in migration).
  store_destination_id String?
  retrac_id            String?
  slip_number          String?
  source               RecordSource      @default(manual)
  import_id            String? // ADR-0048 — workbook_promotions.id when promoted from staging
  locked_at            DateTime? // edit-before-any-lock guard (CRUD-lite)
  note                 String?
  created_by           String?
  created_at           DateTime          @default(now())
  updated_at           DateTime          @updatedAt

  @@index([site_id, movement_date])
  @@index([site_id, to_status])
  @@index([store_destination_id])
  @@map("unit_status_movements")
}

/// ADR-0037 amendment (rollup §5.2/§14) — unit lifecycle status buckets. `saved`
/// stays ON the floor (Rick's model) until a `saved → sold` store transfer.
enum UnitStatus {
  on_floor
  saved
  processed
  sold
  landfilled
}

// ────────────────────────────────────────────────────────────────────────
// ADR-0056 — Event Billing + TONU line handling (rollup §5.3)
// ────────────────────────────────────────────────────────────────────────

/// ADR-0056 (rollup §5.3, Rick 2026-07-19) — per-leg event freight. A drop +
/// next-day pickup is TWO legs, each Event-Mile-Rate-tier priced separately
/// (`tier_lookup_miles` resolves against the CA transport_rate_tiers set — the
/// same table ADR-0040 already uses; NO second table). A same-day loaded event is
/// one `same_day` leg on the standard mileage rate. `rate_cents` is the resolved
/// per-leg amount (null until the generator resolves it). Bare scalar FK
/// event_id → collection_events.id (constraint in migration; ON DELETE CASCADE).
model EventLeg {
  id                String       @id @default(uuid())
  event_id          String // FK → collection_events.id (constraint in migration, CASCADE)
  leg_type          EventLegType
  tier_lookup_miles Int?
  rate_cents        Int?
  note              String?
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt

  @@index([event_id])
  @@map("event_legs")
}

/// ADR-0056 (rollup §5.3) — event freight leg kind. `drop` and `pickup` are the
/// two legs of a drop + next-day-pickup event (each tier-priced); `same_day` is a
/// same-day loaded event (standard mileage rate).
enum EventLegType {
  drop
  pickup
  same_day
}

/// ADR-0056 (rollup §5.3 item 6) — per-vehicle IRS mileage for an event
/// (facility→event→facility, IRS-guideline rate NOT the SVDP rate). There is no
/// vehicles master table; `vehicle_label` is a free-text identifier (document).
/// Bare scalar FK event_id → collection_events.id (constraint in migration, CASCADE).
model EventVehicle {
  id            String   @id @default(uuid())
  event_id      String // FK → collection_events.id (constraint in migration, CASCADE)
  vehicle_label String? // free-text vehicle identifier (no vehicles master)
  miles_driven  Int?
  note          String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([event_id])
  @@map("event_vehicles")
}

/// ADR-0056 (rollup §5.3, Rick 2026-07-19) — TONU (Trailer Order Not Used). Driver
/// dispatched but could not drop the trailer. Rick: cancelled BEFORE dispatch → NO
/// bill (no row); cancelled AFTER dispatch OR diverted → billed at the haul rate
/// (Woodland Primary rate per PR #128 §3.5). `haul_rate_cents` and `billed_cents`
/// are stored as resolved/entered (never invented). Bare scalar FK event_id →
/// collection_events.id (constraint in migration; a TONU may reference the event
/// it was dispatched for).
model TonuBilling {
  id              String       @id @default(uuid())
  event_id        String? // FK → collection_events.id (constraint in migration)
  site_id         String // FK → sites.id (constraint in migration)
  dispatched_at   DateTime?
  cancelled_at    DateTime?
  diverted        Boolean      @default(false)
  haul_rate_cents Int? // Woodland Primary haul rate applied (null until resolved)
  billed_cents    Int? // final billed amount (null until resolved)
  note            String?
  source          RecordSource @default(manual)
  locked_at       DateTime?
  created_by      String?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  @@index([event_id])
  @@index([site_id])
  @@map("tonu_billing")
}

/// ADR-0068 §3 — employee reimbursement requests.
///
/// WHY THIS TABLE EXISTS, stated so it is never "simplified" away: Mary Scott
/// (SVdP accounting) reported that Janette was approving her own reimbursement
/// submissions. The old path was paper → scan → email Mary → Mary forwards into
/// the AP mailbox → the shared AP queue, where the ORIGINATOR was invisible to
/// Vision. It knew who forwarded (Mary) and who approved (Janette); the
/// originator existed only as ink inside a scanned PDF. First-action-wins then
/// did exactly what it was designed to do and let her claim her own submission.
/// The approval stamp was manufacturing audit evidence for a review that never
/// happened — worse than having no control at all.
///
/// Structured intake is what fixes it: the submitter is AUTHENTICATED, so
/// "who originated this" is a stored fact rather than an inference, and
/// "the submitter cannot approve" becomes a constraint rather than a detection
/// problem.
///
/// Deliberately SEPARATE from `ap_requests`: a vendor invoice is an arm's-length
/// transaction whose invoice is independent evidence, and "originator" is
/// meaningless because vendors are not in the org chart. A reimbursement pays an
/// insider against a form an insider wrote.
model ReimbursementRequest {
  id      String @id @default(uuid())
  site_id String // bare FK → sites.id; auto-filled from the submitter, never client-chosen
  site    Site   @relation(fields: [site_id], references: [id], onDelete: Restrict)

  // ── Beneficiary (D2) ─────────────────────────────────────────────────────
  /// Set when chosen from the roster picker. Exactly one of this and
  /// `employee_name_freeform` is non-null (DB CHECK).
  employee_user_id       String?
  employee_user          User?   @relation("ReimbursementBeneficiary", fields: [employee_user_id], references: [id], onDelete: Restrict)
  /// Set when the reimbursed person has no Vision account. The fallback matters —
  /// not every reimbursed person is a user.
  employee_name_freeform String?

  amount_cents         Int
  expense_date         DateTime // the EXPENSE date, not the submission date
  category             ReimbursementCategory
  purpose              String // business purpose, required
  receipt_file_key     String // R2 object key — receipts NEVER live in this DB
  receipt_content_type String

  // ── First signature = submission (D4) ────────────────────────────────────
  submitted_by String
  submitter    User     @relation("ReimbursementSubmitter", fields: [submitted_by], references: [id], onDelete: Restrict)
  submitted_at DateTime @default(now())

  // ── Second signature ─────────────────────────────────────────────────────
  status             ReimbursementStatus @default(pending_second_approval)
  second_approver_id String?
  second_approver    User?               @relation("ReimbursementSecondApprover", fields: [second_approver_id], references: [id], onDelete: Restrict)
  second_approved_at DateTime?
  /// REQUIRED on reject and hold (a refusal must say why); unused on approve,
  /// where the substantive data was captured at submission.
  decision_note      String?

  // ── Routing / escalation (D5/D6/D9) ──────────────────────────────────────
  routed_to_user_id String
  routed_to         User                           @relation("ReimbursementRoutedTo", fields: [routed_to_user_id], references: [id], onDelete: Restrict)
  escalated_at      DateTime?
  escalated_to      String? // bare FK → users.id
  escalation_reason ReimbursementEscalationReason?

  // ── Output (D8) ──────────────────────────────────────────────────────────
  decision_pdf_key      String?
  decision_pdf_sha256   String?
  sent_to_accounting_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([status, routed_to_user_id]) // queue + digest reads
  @@index([site_id, expense_date]) // reporting
  @@index([submitted_by])
  @@map("reimbursement_requests")
}

enum ReimbursementCategory {
  mileage
  fuel
  supplies
  meals
  tools
  other
}

enum ReimbursementStatus {
  pending_second_approval
  approved
  rejected
  held
}

/// Why a request left its routed peer. `beneficiary_conflict` is IMMEDIATE (D6) —
/// there is no valid local approver, so waiting 24h accomplishes nothing.
enum ReimbursementEscalationReason {
  timeout
  beneficiary_conflict
  no_routing_row
  ambiguous_beneficiary
}

// ────────────────────────────────────────────────────────────────────────
// Processor production quota alert (ADR-0071).
//
// An EXCEPTION alert over the bonus system's existing per-processor daily
// counts. Strictly READ-ONLY against production: `bonus_daily_entries` is
// written by the bonus entry flow and `processed_units_daily` by workbook-sync
// (ADR-0049/0058). Nothing in this feature writes either. The only rows it owns
// are its own config, recipients, and send log.
// ────────────────────────────────────────────────────────────────────────
model ProcessorQuotaConfig {
  id      String @id @default(uuid())
  site_id String @unique
  site    Site   @relation(fields: [site_id], references: [id])

  /// Born disabled; an operator turns it on (the workbook-sync D9 discipline).
  enabled Boolean @default(false)

  /// Daily minimum. Decimal(5,1) to match `bonus_daily_entries.mattress_count`
  /// exactly — a half-shift entry of 49.9 must compare against the same scale it
  /// was recorded on. Seeded 75; retunable without a deploy.
  quota_units Decimal @default(75) @db.Decimal(5, 1)

  /// Misses in one Monday–Sunday week before a processor is flagged. Seeded 2.
  min_misses Int @default(3)

  /// Pacific wall-clock send time. The week reported on is always the most
  /// recent COMPLETE Mon–Sun week, so the send day is a delivery choice, not a
  /// definition of the window.
  send_time_pt DateTime @db.Time
  /// ISO weekday to send on (1 = Monday … 7 = Sunday). Seeded 1.
  send_dow     Int      @default(1)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  recipients ProcessorQuotaRecipient[]

  @@map("processor_quota_config")
}

model ProcessorQuotaRecipient {
  id               String               @id @default(uuid())
  config_id        String
  config           ProcessorQuotaConfig @relation(fields: [config_id], references: [id], onDelete: Cascade)
  email            String
  added_by_user_id String?
  added_at         DateTime             @default(now())

  @@unique([config_id, email])
  @@index([config_id])
  @@map("processor_quota_recipients")
}

/// One row per (site, week) the digest ACTUALLY decided on — including the weeks
/// it deliberately stayed silent. `suppressed = true` with `flagged_count = 0` is
/// the record that the week was evaluated and nobody missed twice; without it,
/// "no email arrived" and "the cron never ran" are indistinguishable, which is
/// the exact failure shape this codebase keeps having to amend away.
model ProcessorQuotaLog {
  id         String   @id @default(uuid())
  site_id    String
  site       Site     @relation(fields: [site_id], references: [id])
  week_start DateTime @db.Date
  week_end   DateTime @db.Date

  evaluated_at    DateTime  @default(now())
  processors_seen Int       @default(0)
  flagged_count   Int       @default(0)
  /// True when the digest was intentionally NOT sent because nobody flagged.
  suppressed      Boolean   @default(false)
  recipient_count Int       @default(0)
  sent_at         DateTime?
  error_text      String?

  @@unique([site_id, week_start])
  @@index([site_id, week_start])
  @@map("processor_quota_logs")
}

/// ADR-0071 Amendment 1 — the monitor's standing heartbeat.
///
/// `ProcessorQuotaLog` records a WEEK that was evaluated. It can only be written
/// once a config is enabled, so while the feature shipped disabled it recorded
/// nothing at all and a live cron was indistinguishable from a dead one. This
/// table records a RUN — one row every live fire, whether or not any site is
/// enabled and whether or not anything was sent.
///
/// Deliberately NOT keyed on (site, week): that key belongs to
/// `processor_quota_logs`, where it enforces send-idempotency. A heartbeat
/// sharing it would claim the week and permanently suppress the first real
/// digest — the guard would eat the thing it guards.
model ProcessorQuotaRun {
  id     String   @id @default(uuid())
  ran_at DateTime @default(now())

  /// Sites holding a config at all. Zero means unconfigured, not merely off.
  configs_total   Int @default(0)
  /// Of those, how many would actually mail. Zero with a fresh `ran_at` is the
  /// honest reading of "the monitor is alive and the alert is switched off".
  configs_enabled Int @default(0)
  /// Disabled sites are still evaluated read-only, so this counts them too —
  /// the heartbeat can say what the digest WOULD have said without sending it.
  sites_evaluated Int @default(0)
  processors_seen Int @default(0)
  flagged_total   Int @default(0)
  /// Digests DELIVERED to at least one recipient. Per ADR-0095 an attempted send
  /// that reached nobody is never recorded as a send.
  digests_sent    Int @default(0)

  /// Per-site breakdown, for diagnosis without a redeploy.
  detail     Json
  error_text String?

  @@index([ran_at])
  @@map("processor_quota_runs")
}

// ────────────────────────────────────────────────────────────────────────
// Tiered anchor-overwrite guardrail (ADR-0072).
//
// A physical count becomes the inventory ANCHOR every downstream number is
// computed forward from, so a mistyped count silently moves the whole floor.
// These two tables hold the threshold that decides how much friction a given
// overwrite gets, and the counts that were held because they crossed it.
// ────────────────────────────────────────────────────────────────────────
model InventoryAnchorConfig {
  id      String @id @default(uuid())
  site_id String @unique
  site    Site   @relation(fields: [site_id], references: [id])

  /// Swing (|new − prior| / prior, as a percentage) above which a physical count
  /// requires manager approval. Seeded 20 — Bill tightened this from a proposed
  /// 40 because on a 2,483 floor 40% lets ~1,000 units through on a tap.
  /// A setting, not a constant, so it is retunable without a deploy.
  swing_threshold_pct Decimal @default(20) @db.Decimal(5, 2)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("inventory_anchor_config")
}

/// A physical count that crossed the threshold and is waiting for a manager.
///
/// It is NEVER silently dropped and NEVER auto-writes: it persists with the
/// entered values until a manager approves it (which writes the snapshot) or
/// someone explicitly discards it. An operator can do neither — `approved_by`
/// is always a different person from `created_by`, enforced by a CHECK.
model InventoryCountHold {
  id      String @id @default(uuid())
  site_id String
  site    Site   @relation(fields: [site_id], references: [id])

  // The entered count, held verbatim so approval writes exactly what was counted.
  units_indoor        Int?
  units_total         Int?
  units_in_processing Int      @default(0)
  program_units       Decimal? @db.Decimal(7, 1)
  non_program_units   Decimal? @db.Decimal(7, 1)
  pool_attribution    String   @default("measured")

  // What made it Tier 2, captured at hold time. Recomputed on approval — these
  // are the record of why it was held, not the authority for writing it.
  prior_snapshot_id String?
  prior_total       Int
  new_total         Int
  swing_pct         Decimal @db.Decimal(7, 2)
  threshold_pct     Decimal @db.Decimal(5, 2)

  status     InventoryHoldStatus @default(pending)
  created_by String
  created_at DateTime            @default(now())

  approved_by   String?
  approved_at   DateTime?
  /// How the release happened: on-device manager PIN, or remote approval.
  approval_path String?

  discarded_by          String?
  discarded_at          DateTime?
  discard_reason        String?
  /// The snapshot this hold produced once approved.
  resulting_snapshot_id String?

  @@index([site_id, status, created_at])
  @@map("inventory_count_holds")
}

enum InventoryHoldStatus {
  pending
  approved
  discarded
}

// ────────────────────────────────────────────────────────────────────────
// ADR-0069 Amendment 1 — ABSORBED trailer-list rows.
//
// The first document kind whose parsed values become typed, queryable Vision
// data. Real columns, not a JSON blob.
//
// SINGLE-WRITER RULE: this table is written ONLY by the doc-ingest absorption
// bridge. It is reference data — it never overwrites an operational table, and
// no operational read depends on it. `site_inventory_snapshots`,
// `processed_units_daily` and the loads tables all keep their existing sole
// writers.
//
// Rows are keyed to the VERSION they came from rather than mutated in place, so
// a re-ingest appends a new generation and the previous one stays readable. The
// surface reads the newest absorbed version per source.
// ────────────────────────────────────────────────────────────────────────
model DocTrailerRow {
  id                    String  @id @default(uuid())
  doc_source_id         String
  doc_source_version_id String
  /// From the source. NULL is UNCLASSIFIED, never a guess (hard rule #2) — and
  /// absorption refuses a NULL-site source before reaching here.
  site_id               String?
  site                  Site?   @relation(fields: [site_id], references: [id])

  sheet_name String
  /// 1-based row number in the sheet — provenance straight back to the cell.
  row_index  Int

  entry_date   DateTime? @db.Date
  trailer_no   String
  /// VERBATIM. The live file mixes "pocket coil"/"Pocketcoil" and uses the column
  /// for origins ("Recology SF") as often as materials. Normalising here would
  /// invent a taxonomy nobody agreed to.
  material_raw String?

  /// NULL when the sheet recorded no weight. NEVER 0 for a blank or a "-":
  /// 19 of the live file's 96 rows have no weight, and zeroing them would invent
  /// nineteen trailers weighing nothing.
  weight_lbs Decimal? @db.Decimal(10, 1)
  /// What the weight cell actually said, so "-" survives and is recoverable.
  weight_raw String?

  driver             String?
  /// The SHEET's own formula result, stored as-is and never recomputed —
  /// recomputing would show a number the spreadsheet does not.
  days_in_yard_sheet Int?

  exit_date DateTime? @db.Date
  /// A non-date exit cell kept verbatim rather than dropped.
  exit_raw  String?
  notes     String?

  absorbed_at DateTime @default(now())

  @@unique([doc_source_version_id, sheet_name, row_index])
  @@index([doc_source_id, absorbed_at])
  @@index([site_id, entry_date])
  @@map("doc_trailer_rows")
}

// ────────────────────────────────────────────────────────────────────────
// ADR-0069 Amendment 2 — ABSORBED TEREX maintenance rows.
//
// MONEY-TOUCHING, therefore STAGED. `Estimated cost`, `Actual Repair Cost` and
// `Amount Credited` are real dollars, so rows land `staged` and a human confirms
// the batch before it counts. The trailer list went straight in because it
// carries weights; this does not.
//
// SINGLE-WRITER RULE: reference data, written only by the absorption bridge. It
// never touches `processed_units_daily` (workbook-sync), the AP tables, or any
// billing figure — and deliberately does not absorb the workbook's monthly
// operating tabs, which carry per-day processed units that workbook-sync owns.
// ────────────────────────────────────────────────────────────────────────
model DocTerexMaintenanceRow {
  id                    String  @id @default(uuid())
  doc_source_id         String
  doc_source_version_id String
  site_id               String?
  site                  Site?   @relation(fields: [site_id], references: [id])

  sheet_name String
  row_index  Int

  /// Set ONLY when the cell held a real date in a plausible range. The live
  /// file's date column contains "09/16 or 17" (deliberately ambiguous), "Jan",
  /// a "1/14/202601" typo and one 1900-01-14 Excel epoch artefact.
  event_date     DateTime? @db.Date
  /// ALWAYS what the cell said, so an unparsed date is still readable.
  event_date_raw String?
  time_raw       String?

  issue               String?
  measures_taken      String?
  /// Free text in the real file ("2 weeks"), so it stays text.
  estimated_time_cost String?
  notes               String?

  /// Blank means NOT RECORDED. Never 0 — a repair with no recorded cost is not
  /// a free repair.
  estimated_cost     Decimal? @db.Decimal(12, 2)
  actual_repair_cost Decimal? @db.Decimal(12, 2)
  amount_credited    Decimal? @db.Decimal(12, 2)

  /// Identity used to drop the same event appearing on two sheets. The live
  /// workbook's `Maintenance Log 2025` is a strict SUBSET of `Maintenance
  /// Log2026`, and both total $77,067.94 — absorbing both without this would
  /// report $154,135.88.
  dedup_key String

  status         DocAbsorptionStatus @default(staged)
  confirmed_at   DateTime?
  confirmed_by   String?
  discarded_at   DateTime?
  discarded_by   String?
  discard_reason String?

  absorbed_at DateTime @default(now())

  @@unique([doc_source_version_id, sheet_name, row_index])
  @@index([doc_source_id, status])
  @@index([site_id, event_date])
  @@map("doc_terex_maintenance_rows")
}

/// Preview-then-confirm lifecycle for money-touching absorption.
enum DocAbsorptionStatus {
  staged
  confirmed
  discarded
}

// ────────────────────────────────────────────────────────────────────────
// ADR-0080 — discovery reachability + commodity audit-coverage absorption
//
// Appended at the END of this file on purpose: two other builds were editing
// schema.prisma concurrently on 2026-08-07, and end-appending is the shape that
// merges without a conflict.
// ────────────────────────────────────────────────────────────────────────

/// One run of the reachable-vs-watched comparison (ADR-0080 Phase 1).
///
/// The COUNTS are kept as history so "the gap opened on Tuesday" is answerable;
/// the per-document rows are pruned to the newest scans because they are a
/// snapshot of a question, not a ledger.
model DocIngestReachabilityScan {
  id         String   @id @default(uuid())
  scanned_at DateTime @default(now())

  /// The EXACT KQL issued. Stored rather than re-derived so a historical count
  /// can never be read under a scope that has since been widened or narrowed —
  /// a number whose bound is unknown is not evidence of anything.
  scope_query String

  reachable_count Int
  watched_count   Int
  gap_count       Int

  /// Graph still had results when the cap was reached, so `gap_count` is a
  /// LOWER BOUND. Recorded because an under-stated gap presented as complete is
  /// the exact failure this table exists to end.
  truncated Boolean @default(false)

  /// Non-null when the probe could not run. A failed scan is NOT a gap of zero:
  /// "we could not look" and "there is nothing to see" must never render alike.
  error String?

  items DocIngestReachableItem[]

  @@index([scanned_at])
  @@map("doc_ingest_reachability_scans")
}

/// A document Vision could READ but was not WATCHING, at one scan.
///
/// Deliberately NOT a `doc_sources` row and never promoted to one automatically.
/// The probe runs on tenant search, which returns everything this identity can
/// reach — auto-adopting it would ingest case-management and HR material. Bill
/// registers what belongs, through the existing operator path (O-2).
model DocIngestReachableItem {
  id      String                    @id @default(uuid())
  scan_id String
  scan    DocIngestReachabilityScan @relation(fields: [scan_id], references: [id], onUpdate: Cascade, onDelete: Cascade)

  /// The D8 identity pair — the same key `doc_sources` uses, so the comparison
  /// is on identity and never on a display name.
  drive_id String
  item_id  String

  name       String
  web_url    String?
  /// `createdBy` when search supplied it — who to ask about this document.
  owner_hint String?

  last_modified_at DateTime?
  size_bytes       Int?

  first_seen_at DateTime @default(now())

  @@unique([scan_id, drive_id, item_id])
  @@index([scan_id])
  @@map("doc_ingest_reachable_items")
}

/// One (commodity stream × month) audit-coverage cell (ADR-0080 Phase 2).
///
/// ── What this table is NOT ────────────────────────────────────────────────
/// It holds NO tonnage and NO money. The "Woodland Data Auditing Tracker" was
/// expected to carry commodity figures cross-referenced against vendor invoices;
/// read against the live bytes on 2026-08-07 it carries none. It records WHETHER
/// a month's audit was performed, by whom, and when. So there is nothing here to
/// reconcile against `processed_units_daily`, and nothing here writes it.
///
/// Version-scoped from the first row (ADR-0077's lesson): the unique key is
/// `(version, sheet, stream, month)`, so two confirmed revisions of one workbook
/// coexist, each a COMPLETE copy. Any read that aggregates must first pin the
/// winning revision — summing every confirmed row across revisions is precisely
/// how the TEREX ledger reported $231,203.82 for a $77,067.94 document.
model DocCommodityAuditRow {
  id String @id @default(uuid())

  /// Plain scalars, matching `doc_trailer_rows` / `doc_terex_maintenance_rows`:
  /// the absorbed-row tables in this schema carry the source/version ids without
  /// a Prisma relation, and only `site` is a real relation.
  doc_source_id         String
  doc_source_version_id String

  /// NULL is UNCLASSIFIED, never a guess (hard rule #2) — absorption refuses a
  /// NULL-site source before a row ever reaches here.
  site_id String?
  site    Site?   @relation(fields: [site_id], references: [id])

  sheet_name String
  /// The sheet's own banner year ("2026"). NULL when the banner was unreadable —
  /// never inferred from the ingest date.
  sheet_year Int?

  /// Forward-filled row-2 / row-3 banners: "METAL" / "METAL - GreenZone".
  stream_group String
  stream_label String

  /// VERBATIM as the sheet wrote it ("Sept", "March") — the labels are
  /// inconsistent in the real file and normalising them would quietly merge two
  /// distinct columns.
  month_label  String
  /// 1–12, or NULL when the label was not recognised. Never guessed.
  month_number Int?

  /// NULL = NOT RECORDED (the cell was empty). Never coerced to false: an
  /// un-filled checkbox and a deliberate "not audited" are different claims.
  audited        Boolean?
  initials       String?
  /// Set ONLY when the cell held a real date in a plausible range.
  audit_date     DateTime?
  /// ALWAYS what the cell said. The live file carries the literal "working" in
  /// three Date cells; rendering that as a date would invent an audit.
  audit_date_raw String?

  second_audit          Boolean?
  second_initials       String?
  second_audit_date     DateTime?
  second_audit_date_raw String?

  row_index Int
  status    DocAbsorptionStatus @default(staged)

  confirmed_at   DateTime?
  confirmed_by   String?
  discarded_at   DateTime?
  discarded_by   String?
  discard_reason String?

  absorbed_at DateTime @default(now())

  @@unique([doc_source_version_id, sheet_name, stream_label, month_label])
  @@index([doc_source_id, status])
  @@index([site_id, sheet_year])
  @@map("doc_commodity_audit_rows")
}

// ────────────────────────────────────────────────────────────────────────
// ADR-0104 §D2 — absorbed OUTBOUND LOAD rows.
// ────────────────────────────────────────────────────────────────────────
//
/// One shipped load, as "Woodland Outbound Auditing 2026.xlsx" recorded it.
///
/// ── Why this table exists ──────────────────────────────────────────────────
/// `mymrc_outbound_mirror` holds 4,673 outbound loads and `weight_lbs` is NULL
/// on 4,673 of them (measured against prod 2026-08-16). The system knows every
/// load left, when, on what BOL, to whose account — and does not know what any
/// of them weighed. This workbook is that missing column, joinable on
/// `external_materials_id`, which is UNIQUE-indexed on the mirror.
///
/// ── REFERENCE, never operational (§D1) ─────────────────────────────────────
/// This is NOT `outbound_materials`. Writing that table needs a
/// `vendor_id -> outbound_vendors` and a rate keyed `(vendor_id, commodity,
/// ship_date)` to satisfy ADR-0055's `recycled_lbs + landfilled_lbs ==
/// weight_lbs`, and the workbook contains neither master. Standing them up from
/// `Disposition` strings would be fabrication. All six operational vendor-leg
/// tables stay at 0 rows; that is AK-4b.
///
/// ── Version-scoped from the first row (ADR-0080 §D8, ADR-0077) ─────────────
/// The unique key is `(version, external_materials_id)`, so N confirmed
/// revisions coexist, each a COMPLETE copy. Every read pins one revision before
/// it aggregates. Summing across revisions is how the TEREX ledger reported
/// $231,203.82 for a $77,067.94 document.
model DocOutboundLoadRow {
  id String @id @default(uuid())

  /// Plain scalars, matching the other absorbed-row tables: only `site` is a
  /// declared Prisma relation.
  doc_source_id         String
  doc_source_version_id String

  /// NULL is UNCLASSIFIED, never a guess (hard rule #2) — absorption refuses a
  /// NULL-site source before a row ever reaches here.
  site_id String?
  site    Site?   @relation(fields: [site_id], references: [id])

  /// Provenance back to the cell. NOT identity — see the unique key.
  sheet_name String
  row_index  Int

  /// The join key. `Materials: Materials ID`, e.g. "M-160053". Matches
  /// `mymrc_outbound_mirror.external_materials_id`.
  external_materials_id String
  bol_id                String?
  /// The sheet's `Account Name`. ABSENT on both April sheets (the column is
  /// literally headed "Column1" there), so it is NEVER the source of site —
  /// site comes from the doc_source. Stored only to assert against.
  account_name_raw      String?
  /// "Active" / "Inactive" in the live file.
  materials_status      String?
  /// "Outbound" on every measured row.
  materials_record_type String?

  /// Set only when the cell resolved to a real date.
  shipment_date     DateTime? @db.Date
  /// ALWAYS what the cell said. The SAME shipment appears as an Excel Date on
  /// one sheet, the serial 46055 on its duplicate, and the text "1/2/2026" on
  /// the January sheet. Measured across the 831 distinct loads: 561 real Dates,
  /// 139 serials, 131 text.
  shipment_date_raw String?

  /// From `Total Outbound Weight` — the POSITIVE figure, which reconciles to
  /// the sum of the 13 commodity columns exactly (0 drift on 831 of 831 rows).
  total_weight_lbs       Decimal? @db.Decimal(12, 2)
  /// From `Total Outbound Materials Weight`, which is its NEGATION. Stored ONLY
  /// so the guardrail can assert the sign relationship and fail loudly if the
  /// workbook's convention changes. NEVER read as a weight: an extractor that
  /// picked this most-official-sounding right-most column would ingest every
  /// weight in the operation with the wrong sign, and because it is internally
  /// consistent nothing downstream would look wrong until a total met reality.
  total_weight_check_lbs Decimal? @db.Decimal(12, 2)

  /// NULL when the sheet recorded nothing. Never 0 for a blank — a recorded 0
  /// and an unrecorded figure are different claims.
  program_units     Int?
  non_program_units Int?

  status         DocAbsorptionStatus @default(staged)
  confirmed_at   DateTime?
  confirmed_by   String?
  discarded_at   DateTime?
  discarded_by   String?
  discard_reason String?

  absorbed_at DateTime @default(now())

  /// The DEDUP MECHANISM, in the schema. The key is the Materials ID and NOT
  /// `(sheet, row_index)`: the workbook has four sheet pairs that are exact
  /// duplicates of each other plus one filtered subset sheet, so 556 of 1,387
  /// candidate rows are the same load twice. Keying on the load makes the
  /// collision impossible rather than merely unlikely.
  @@unique([doc_source_version_id, external_materials_id], map: "doc_outbound_load_rows_version_matid_key")
  @@index([doc_source_id, status], map: "doc_outbound_load_rows_source_status_idx")
  @@index([site_id, shipment_date], map: "doc_outbound_load_rows_site_ship_idx")
  @@index([external_materials_id], map: "doc_outbound_load_rows_matid_idx")
  @@map("doc_outbound_load_rows")
}

/// One (load x commodity) weight, written only where the `(lbs)` cell held a
/// number.
///
/// A 26-column-wide parent would encode the commodity vocabulary in the SCHEMA,
/// where adding a commodity becomes a migration. The vocabulary is data.
model DocOutboundCommodityRow {
  id String @id @default(uuid())

  doc_source_id         String
  doc_source_version_id String

  site_id String?
  site    Site?   @relation(fields: [site_id], references: [id])

  external_materials_id String
  /// VERBATIM column stem: "Foam", "Shoddy/Felt", "Whole Mattresses and
  /// Foundations". Not normalised.
  commodity             String
  /// The cell as a number. A recorded 0 is KEPT as 0 — the export writes 0 for
  /// a commodity this load did not carry, and turning that into "not recorded"
  /// would be the inverse of the blank-is-not-zero rule.
  weight_lbs            Decimal? @db.Decimal(12, 2)
  /// Live vocabulary measured 2026-08-16 is FIVE values, not four: Recycling,
  /// Landfill, Biomass, Renovation, and the case variant "landfill". Stored
  /// verbatim, NEVER mapped — mapping "Landfill" onto `landfilled_units`
  /// semantics is exactly the operational write §D1 forbids.
  disposition           String?

  sheet_name String
  row_index  Int

  /// Mirrors the parent's, flipped by the same decide call in the same
  /// transaction. A child that could outlive its parent's decision would let a
  /// discarded batch's weights stay readable.
  status      DocAbsorptionStatus @default(staged)
  absorbed_at DateTime            @default(now())

  @@unique([doc_source_version_id, external_materials_id, commodity], map: "doc_outbound_commodity_rows_version_matid_commodity_key")
  @@index([doc_source_id, status], map: "doc_outbound_commodity_rows_source_status_idx")
  @@index([site_id, commodity], map: "doc_outbound_commodity_rows_site_commodity_idx")
  @@map("doc_outbound_commodity_rows")
}

// ────────────────────────────────────────────────────────────────────────
// ADR-0108 — the editable per-commodity outlier bound.
// ────────────────────────────────────────────────────────────────────────
//
/// Where the "look at this load" line sits, for one commodity at one site.
///
/// ── This is a CONFIG TABLE and not a constant, deliberately ───────────────
/// The numbers below were measured from one revision of one workbook on one
/// date. They are a starting point, not a finding. Rick and Janette will retune
/// them once they have looked at what the first pass surfaces, and a threshold
/// that needs a deploy to move is a threshold nobody moves — it silently
/// becomes the definition of "normal" instead of a question somebody asked.
/// Same reasoning, same shape, as `processor_quota_config` (ADR-0071).
///
/// ── Why the bound is MULTIPLICATIVE and not ±k×MAD in pounds ──────────────
/// Load weights are strictly positive and right-skewed, and that breaks a
/// symmetric bound in linear pounds in a way that is invisible until you look
/// for it: the largest LOW-side deviation any row can physically have is the
/// median itself, so the low side is capped at `median / MAD` deviations. For
/// Wood that cap is **4.01 MAD** (median 3,170, MAD 790) — meaning a linear
/// bound at any k >= 4.01 can never flag a low Wood weight however absurd, and
/// the real keying-error-shaped `Wood 40 lb` row sits at 3.96, just inside. A
/// detector that cannot report the defect it was built for is worse than none.
///
/// So the deviation is measured in LOG space. That makes the bound a RATIO
/// rather than a difference, which is both correct for this shape of data and
/// far easier to retune: `spread_ratio` is one MAD step expressed as a
/// multiplier, and the band is `median / ratio^k  ..  median * ratio^k`.
model OutboundVarianceConfig {
  id      String @id @default(uuid())
  site_id String
  site    Site   @relation(fields: [site_id], references: [id])

  /// VERBATIM workbook stem, matching `doc_outbound_commodity_rows.commodity`
  /// byte for byte ("Shoddy/Felt", "Quilt and Toppers"). Normalising here would
  /// silently stop matching the rows this is supposed to bound.
  commodity String

  /// Off switches this commodity's flagging entirely. The floor below does the
  /// same job automatically; this is the manual override for a commodity whose
  /// spread an operator knows to be meaningless.
  enabled Boolean @default(true)

  /// The typical load weight for this commodity, in pounds. The GEOMETRIC
  /// median (exp of the median of ln lbs), which is what the log-space bound is
  /// centred on. Decimal(12,2) matches `weight_lbs` exactly.
  median_lbs Decimal @db.Decimal(12, 2)

  /// One median-absolute-deviation step, as a MULTIPLIER. 1.2235 means "a
  /// typical Waste load is within a factor of 1.2235 of the median". Must be
  /// > 1 for a band to exist: a ratio of exactly 1 is a zero-width spread and
  /// flagging is refused rather than firing on every row that is not precisely
  /// the median.
  spread_ratio Decimal @db.Decimal(8, 4)

  /// How many MAD steps out the line sits. Seeded 6. See the ADR for the
  /// measured flag volume at 3/4/5/6/8.
  k Decimal @db.Decimal(4, 2) @default(6.00)

  /// Below this many observations the spread is not estimable and flagging is
  /// OFF for this commodity — stated on screen rather than silently absent.
  /// Seeded 20.
  min_sample_n Int @default(20)

  /// PROVENANCE, not a control. How many rows the seeded median and spread were
  /// measured from, and out of which revision on which date. Kept so that a
  /// future reader can tell a tuned number from a seeded one, and can see that
  /// a `sample_n` of 3 is why Cotton never flags.
  sample_n              Int
  seeded_from_version_id String?
  seed_measured_on       DateTime? @db.Date

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([site_id, commodity], map: "outbound_variance_config_site_commodity_key")
  @@map("outbound_variance_config")
}

// ────────────────────────────────────────────────────────────────────────
// ADR-0104 §D4 — absorbed FACILITY EXPENSE rows.
// ────────────────────────────────────────────────────────────────────────
//
/// One line of "Woodland Invoices tracking.xlsx" — a hand-kept desk log of
/// facility expenses already paid.
///
/// NOT `invoices` (ADR-0041). That table carries an immutable-version
/// discipline, a lifecycle state machine and delivery planning; this is a log of
/// things already paid with no lifecycle at all, and writing it there would
/// manufacture payable-looking records that were never payables.
///
/// The two STOCKTON sheets are refused per-sheet with the reason
/// `site_not_registered`: Stockton is not a row in `sites`, and hard rule #2
/// says a NULL site never reaches a site-scoped surface.
model DocFacilityExpenseRow {
  id String @id @default(uuid())

  doc_source_id         String
  doc_source_version_id String

  site_id String?
  site    Site?   @relation(fields: [site_id], references: [id])

  sheet_name String
  /// The sheet's own banner year, from the sheet name ("WOODLAND 2026" -> 2026).
  sheet_year Int?
  row_index  Int

  present_on_daily_log String?
  /// Header differs by sheet: `desk receipt` on three, `receipt date` on
  /// STOCKTON 2025.
  receipt_raw          String?

  /// Set ONLY when the cell itself held a real date. Measured against the live
  /// bytes 2026-08-16: that is ZERO rows on both Woodland sheets. The
  /// `Invoice Date` column does NOT hold dates — it holds DAY-OF-MONTH numbers
  /// (5, 6, 12, 27) under month banner rows written in the sheet body. See
  /// `invoice_month_label` / `invoice_day` below.
  invoice_date        DateTime? @db.Date
  /// ALWAYS what the cell said ("5").
  invoice_date_raw    String?
  /// The forward-filled month BANNER row above this row, verbatim ("February").
  /// NULL for the rows above the first banner — 25 of 138 on WOODLAND 2026 and
  /// 15 of 194 on WOODLAND 2025 sit in an unbannered opening block, and
  /// inferring "January" from position would be a guess.
  invoice_month_label String?
  /// 1-31 when `Invoice Date` held a plain day number, else NULL.
  invoice_day         Int?

  /// NULL when the cell was blank. NEVER 0 — an expense with no recorded amount
  /// is not a free expense (the ADR-0069 Am.2 rule for `actual_repair_cost`).
  amount        Decimal? @db.Decimal(12, 2)
  credit_amount Decimal? @db.Decimal(12, 2)

  /// VERBATIM. The live sheets hold 15 and 17 distinct values including case
  /// variants of one category ("Transportation"/"transportation",
  /// "Diesel"/"diesel", "Supplies"/"supplies").
  category_raw  String?
  /// Trimmed + lower-cased, for grouping. A CONVENIENCE, not a taxonomy —
  /// nobody has agreed a taxonomy.
  category_norm String?

  invoice_number String?
  notes          String?
  machine_id_raw String?
  day_raw        String?

  /// VERBATIM. The column is overloaded: real commodities ("wood", "trash",
  /// "pocket coils") and 6 H-haul references, all on WOODLAND 2026.
  commodity_raw String?
  /// Set ONLY when `commodity_raw` matches ^H-?\d+. Null otherwise.
  haul_ref      String?
  /// Present only on the WOODLAND 2026 sheet (9 rows).
  gallons       Decimal? @db.Decimal(10, 2)

  status         DocAbsorptionStatus @default(staged)
  confirmed_at   DateTime?
  confirmed_by   String?
  discarded_at   DateTime?
  discarded_by   String?
  discard_reason String?

  absorbed_at DateTime @default(now())

  @@unique([doc_source_version_id, sheet_name, row_index], map: "doc_facility_expense_rows_version_sheet_row_key")
  @@index([doc_source_id, status], map: "doc_facility_expense_rows_source_status_idx")
  @@index([site_id, invoice_date], map: "doc_facility_expense_rows_site_date_idx")
  @@map("doc_facility_expense_rows")
}
