// ────────────────────────────────────────────────────────────────────────
// Bonus Management System (ADR-0019) — Woodland processor daily bonus.
// Site-scoped so Eugene can be enabled in V2.1+ with no migration.
// ────────────────────────────────────────────────────────────────────────

enum BonusPayPeriodState {
  draft // current period, daily entries being added
  pending_signatures // period closed, awaiting first signature
  partially_signed // one signature in, awaiting second
  signed // both signatures captured, PDF generated
  paid // PDF sent to payroll@svdp.us via M365 Graph
  amended // post-signature edit (Bill-only override)
  skipped // NEW (ADR-0019.1): pre-cutover periods with no data; terminal, no PDF
  historical_imported // ADR-0023 — periods loaded from the historical spreadsheet
}

model BonusEmployee {
  id      String @id @default(uuid())
  site_id String
  site    Site   @relation(fields: [site_id], references: [id])

  // Display name — see ADR-0019 §9b for retroactive display behavior
  full_name      String
  previous_names Json? // [{ name: "...", changed_at: "..." }, ...]

  // Legacy roster employee number extracted from full_name (ADR-0026).
  // Nullable: only the 21 imported DR3 Woodland legacy rows carry one;
  // production-created processors have none. Uniqueness is enforced
  // per-site at the application layer, NOT in the DB — see ADR-0026.
  employee_number String?

  is_active Boolean @default(true)

  // Optional link to a system user — most processors are NOT system users
  user_id String?
  user    User?   @relation("BonusEmployeeUser", fields: [user_id], references: [id])

  notes      String?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime? // soft delete; rehire reactivates per ADR-0019 §9a

  daily_entries BonusDailyEntry[]
  aliases       BonusEmployeeAlias[]

  // Bonus amendment workflow (ADR-0028)
  amendment_requests BonusAmendmentRequest[]

  @@index([site_id, is_active])
  @@index([site_id, employee_number])
  @@map("bonus_employees")
}

model BonusDailyEntry {
  id                  String         @id @default(uuid())
  bonus_employee_id   String
  bonus_employee      BonusEmployee  @relation(fields: [bonus_employee_id], references: [id])
  bonus_pay_period_id String // was bonus_month_id
  bonus_pay_period    BonusPayPeriod @relation(fields: [bonus_pay_period_id], references: [id])

  entry_date     DateTime @db.Date
  mattress_count Decimal  @db.Decimal(5, 1) // 0..999 valid, soft-warn above 200; Decimal(5,1) per ADR-0023 (historical half-shift values + decimal UI going forward)
  note           String? // optional HR annotation, does NOT affect math

  // Sprint 3 / ADR-0023: provenance for historical imports. NULL for
  // production entries; populated for every row loaded via the historical
  // spreadsheet import. See bonus_imports for the session this row belongs
  // to; import_provenance is the raw forensic payload.
  legacy_total_cents Int?
  import_session_id  String?
  import_provenance  Json?
  bonus_import       BonusImport? @relation(fields: [import_session_id], references: [id])

  // Who actually keyed this entry — could be Janette, Morena, or Bill per ADR-0019 §4
  entered_by_user_id String
  entered_by         User     @relation("BonusEntryAuthor", fields: [entered_by_user_id], references: [id])
  entered_at         DateTime @default(now())

  @@unique([bonus_employee_id, entry_date])
  @@index([bonus_pay_period_id])
  @@index([entry_date])
  @@index([import_session_id])
  @@map("bonus_daily_entries")
}

// ────────────────────────────────────────────────────────────────────────
// Reporting-only production adjustments (ADR-0032).
//
// A SEPARATE, additive layer of signed per-day unit deltas that correct the
// Woodland production TOTALS (daily-report MTD + annual year-over-year quantity)
// to the operator's true paper figures — WITHOUT touching any bonus/payout
// dollars. Every bonus-DOLLAR read path queries `bonus_daily_entries` and never
// this table, so an adjustment can NEVER leak into payroll math; only
// production-QUANTITY read paths sum these rows. See ADR-0032.
//
// `created_by` is a scalar FK (ON DELETE SET NULL in SQL) with no Prisma relation
// field on User, intentionally — these rows are operator-loaded and we do not
// need to navigate user → adjustments.
// ────────────────────────────────────────────────────────────────────────
model BonusReportingAdjustment {
  id      String @id @default(uuid())
  site_id String
  site    Site   @relation(fields: [site_id], references: [id])

  entry_date DateTime @db.Date // UTC-midnight key for the Pacific calendar day
  units      Int // signed unit delta (+add / -subtract); whole mattresses
  reason     String
  created_by String?
  created_at DateTime @default(now())

  @@unique([site_id, entry_date])
  @@index([site_id, entry_date])
  @@map("bonus_reporting_adjustments")
}

model BonusPayPeriod {
  id      String @id @default(uuid())
  site_id String
  site    Site   @relation(fields: [site_id], references: [id])

  // ─── Period identity (NEW columns per ADR-0019.1) ──────────────────
  period_number Int // 1..26
  period_year   Int // e.g. 2026
  pay_date      DateTime @db.Date // Fri, ~4 days after period_end

  // ─── Boundaries (was month_start / month_end) ──────────────────────
  period_start DateTime            @db.Date // Tue
  period_end   DateTime            @db.Date // Mon (14 days after period_start, inclusive boundary)
  state        BonusPayPeriodState @default(draft)

  // ─── Facility signature (was janette_*; facility manager attestation) ──
  facility_signed_by_user_id String?
  facility_signed_by         User?     @relation("BonusFacilitySigner", fields: [facility_signed_by_user_id], references: [id])
  facility_signed_at         DateTime?
  facility_signed_ip         String?
  facility_signed_user_agent String?
  // Set when an override actor signed in the facility signer's place per ADR-0019 §5
  facility_override_actor_id String?
  facility_override_reason   String?
  // NEW (ADR-0019.1 §4): when the system auto-signed this slot. NULL = human signed.
  facility_auto_override_at  DateTime?

  // ─── Ops signature (was morena_*; operations manager attestation) ──
  ops_signed_by_user_id String?
  ops_signed_by         User?     @relation("BonusOpsSigner", fields: [ops_signed_by_user_id], references: [id])
  ops_signed_at         DateTime?
  ops_signed_ip         String?
  ops_signed_user_agent String?
  // Set when an override actor (Bill) signed in the ops signer's place per ADR-0019 §5
  ops_override_actor_id String?
  ops_override_reason   String?
  // NEW (ADR-0019.1 §4): when the system auto-signed this slot. NULL = human signed.
  ops_auto_override_at  DateTime?

  // ─── PDF artifact ──────────────────────────────────────────────────
  pdf_storage_key  String? // R2 key
  pdf_generated_at DateTime?

  // ─── Payroll delivery (M365 Graph mail-send per ADR-0021) ──────────
  payroll_sent_at     DateTime?
  payroll_message_id  String? // Graph request ID for audit correlation
  payroll_retry_count Int       @default(0)

  // ─── Amendment tracking per ADR-0019 §6 ────────────────────────────
  // If this period was created by amending an earlier period, points to it
  amended_from_period_id String?         @unique
  amended_from           BonusPayPeriod? @relation("BonusAmendment", fields: [amended_from_period_id], references: [id])
  amended_into           BonusPayPeriod? @relation("BonusAmendment")
  amendment_reason       String?
  amended_by_user_id     String?
  amended_by             User?           @relation("BonusAmender", fields: [amended_by_user_id], references: [id])
  amended_at             DateTime?

  // Computed at sign time, locked thereafter (re-computed only on amendment).
  // For historical_imported periods, this stores the corrected-formula
  // calculator output (threshold_high=74 for Woodland).
  total_payout_cents Int?

  // Sprint 3 / ADR-0023: dual-total storage for historical_imported periods.
  // legacy_total_payout_cents is the sum of as-paid spreadsheet Total cells.
  // When imported_with_legacy_formula = true, PDF and payroll-export read from
  // legacy_total_payout_cents; the corrected total is informational only.
  legacy_total_payout_cents    Int?
  imported_with_legacy_formula Boolean      @default(false)
  import_session_id            String?
  bonus_import                 BonusImport? @relation(fields: [import_session_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  daily_entries BonusDailyEntry[]

  // Bonus amendment workflow (ADR-0028)
  amendment_requests BonusAmendmentRequest[]

  @@unique([site_id, period_start]) // semantically same as old (site_id, month_start)
  @@unique([site_id, period_year, period_number]) // NEW — fast canonical period lookup
  @@index([site_id, state])
  @@index([pay_date]) // NEW — upcoming-deadline queries
  @@map("bonus_pay_periods")
}

// ────────────────────────────────────────────────────────────────────────
// NEW table: bonus_signature_chains (per ADR-0019.2 §2)
// Per-site configuration of who signs which slot and who can override.
// Seeded for both sites at deploy time (T-201).
// ────────────────────────────────────────────────────────────────────────

model BonusSignatureChain {
  id      String @id @default(uuid())
  site_id String @unique
  site    Site   @relation(fields: [site_id], references: [id])

  // Facility slot
  facility_signer_user_id     String
  facility_signer             User   @relation("BonusFacilitySignerConfig", fields: [facility_signer_user_id], references: [id])
  // Comma-separated list of user UUIDs that may override the facility slot.
  // Stored as a string for portability; parsed at use site (cardinality <= 3).
  facility_override_actor_ids String // e.g. "uuid-bill,uuid-morena" for Woodland

  // Ops slot
  ops_signer_user_id     String
  ops_signer             User   @relation("BonusOpsSignerConfig", fields: [ops_signer_user_id], references: [id])
  ops_override_actor_ids String // e.g. "uuid-bill" for Woodland (Bill-only override)

  // The user who fires the auto-override at Tue 08:30 PT per ADR-0019.1 §4.
  // Same across all sites today (Bill); future-flexible.
  auto_override_actor_user_id String
  auto_override_actor         User   @relation("BonusAutoOverrideActor", fields: [auto_override_actor_user_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("bonus_signature_chains")
}

// ────────────────────────────────────────────────────────────────────────
// NEW tables: historical import session tracking + name aliases (ADR-0023).
// ────────────────────────────────────────────────────────────────────────

model BonusImport {
  id                      String   @id
  source_filename         String
  source_sha256           String   @unique
  source_archive_path     String? // repo-relative path; promoted to R2 key in follow-up ticket
  imported_by_user_id     String
  imported_by             User     @relation(fields: [imported_by_user_id], references: [id])
  imported_at             DateTime @default(now())
  total_entries           Int
