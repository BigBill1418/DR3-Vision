// ════════════════════════════════════════════════════════════════════════
// Loads & inventory foundations (ADR-0037)
//
// P1 groundwork that takes the loads/inventory/commodity layer from
// built-but-dormant to production, CA-first. Every rate and program rule is
// DATA (`state_program_rules`), never code; every table carries a business
// date + `source` provenance so the ADR-0039 retro-audit can run over ANY
// historical window (D8). Money is integer CENTS (bonus-system convention);
// weights are integer lbs (charter Q22); unit counts that can be fractional
// use Decimal(x,1) (bonus half-unit precision).
// ════════════════════════════════════════════════════════════════════════

/// Provenance of a loads/inventory record. `manual` = keyed by office/manager;
/// `mymrc` = ingested from the MyMRC feed (ADR-0038); `import` = historical
/// workbook load (ADR-0039). Present on every ADR-0037 table for retro-audit
/// compatibility (D8).
enum RecordSource {
  manual
  mymrc
  import
}

/// ADR-0037 D1 — program-rule kinds. `fuel_surcharge` is CA-only: it is never
/// seeded for an Oregon site AND the resolver throws for an OR jurisdiction,
/// so a future seeding mistake still can't silently bill it. The labor/per-diem
/// and `unit_weight_estimate` kinds are Addendum B5 parameterized constants
/// (never code, never retyped); `unit_weight_estimate` carries a null rate and an
/// `estimate_only` param (MRC weight reporting uses actual scale weights).
enum StateProgramRuleKind {
  processing_rate
  satellite_collection_rate
  collector_incentive
  fuel_surcharge
  driver_hourly
  general_labor_hourly
  per_diem_nightly
  unit_weight_estimate
  // ADR-0056 (rollup §5.3/§14) — event-billing IRS mileage rate (per-vehicle,
  // facility→event→facility, IRS-guideline NOT SVDP rate). The labor / driver /
  // per-diem event constants REUSE the existing `general_labor_hourly`,
  // `driver_hourly`, `per_diem_nightly` kinds (no duplicate kinds). NO rate rows
  // are seeded — the current-year IRS figure is not in the handoff; the resolver
  // fails loud until Rick/Bill provide it (never invent a monetary value).
  irs_mileage_rate
}

/// ADR-0037 D4 (Addendum B1) — outbound commodity taxonomy: the daily-log 9,
/// verbatim from `list!I`. This CORRECTS the accepted ADR-0037 taxonomy
/// (landfill/steel/biomass/wte/… were billing-workbook blocks, not the daily-log
/// commodities the office actually captures). The daily-log-9 → billing-workbook-11
/// block mapping is destination-driven (trash→Landfill vs WTE by vendor) and stays
/// OPEN pending Kelsey/Janette (Addendum B10-5); it is NOT built here.
enum OutboundCommodity {
  trash
  toppers
  foam
  metal
  wood
  cardboard
  plastic
  shoddy
  cotton
}

/// ADR-0037 D4 (Addendum B1) — outbound sub-category (`list!K`). `renovation` is
/// the whole-unit renovator channel (folded in here, replacing the accepted
/// ADR-0037 `renovator_shipments` table); `baled`/`shredded` are the weight-based
/// commodity-sale forms.
enum OutboundSubCategory {
  renovation
  baled
  shredded
}

/// ADR-0037 D3 (Addendum B1) — consumer drop-off kind. Incentive is computed
/// ONLY for `incentive`; `unpaid` and `illegal` rows never carry an
/// `incentive_cents`.
enum ConsumerDropoffKind {
  incentive
  unpaid
  illegal

  /// ADR-0085 — the iPad walk-up flow's two LABEL-ONLY kinds. Identical to each
  /// other in every respect except the word the operator tapped; neither carries
  /// money, a name, or a check. They are separate enum values (rather than a
  /// reuse of `unpaid`) precisely because `defaultIncentiveAmountCents` stamps
  /// units × 300¢ on every kind that is not `incentive` — the label is what
  /// keeps the money off. Enforced by the `consumer_dropoffs_floor_no_money_or_pii`
  /// CHECK constraint, which is in the migration and not expressible here.
  floor_public
  floor_incentive
}

/// ADR-0037 D4 — landfilled whole-unit disposal reasons (workbook block).
enum LandfilledReason {
  bed_bug
  soiled
  water_logged
  other
}

/// ADR-0037 D6 — inventory snapshot origin. `physical` counts anchor the
/// running balance; `computed` marks a system-derived snapshot.
enum InventorySnapshotKind {
  physical
  computed
}

/// ADR-0037 D1 — effective-dated, site-scoped program rules. Same resolution
/// pattern as `processor_bonus_rules`: a strict named resolver picks the row
/// whose `effective_from <= onDate` and `effective_to` is null or `>= onDate`.
/// `rate_cents` is null for rules whose amount is formula-driven (CA fuel
/// surcharge, formula pending); `params` carries rule-kind-specific config
/// (e.g. `daily_cap_units` for `collector_incentive`, `formula` for fuel).
model StateProgramRule {
  id             String               @id @default(uuid())
  site_id        String
  site           Site                 @relation(fields: [site_id], references: [id])
  rule_kind      StateProgramRuleKind
  effective_from DateTime             @db.Date
  effective_to   DateTime?            @db.Date
  rate_cents     Int? // integer cents; null when formula-driven
  params         Json? // rule-kind config: daily_cap_units, formula, …
  notes          String?
  created_by     String?
  created_at     DateTime             @default(now())
  updated_at     DateTime             @updatedAt

  @@index([site_id, rule_kind, effective_from])
  @@map("state_program_rules")
}

/// ADR-0037 D3 — public consumer drop-offs (workbook Paid-Unpaid tab; CA CIP).
/// NOT dock loads — a separate table. `person_name` is MRC Personal Data
/// (charter Exhibit I / ADR-0010): PII, excluded from exports by default,
/// breach-notification scope, 10-business-day deletion-on-termination.
/// `incentive_cents` is computed via D1 (`units × collector_incentive`, capped
/// at `daily_cap_units` per person per day — see dropoffs/incentive.ts).
model ConsumerDropoff {
  id                     String              @id @default(uuid())
  site_id                String
  site                   Site                @relation(fields: [site_id], references: [id])
  dropoff_date           DateTime            @db.Date
  // ADR-0037 Addendum B1 — drop-off kind drives incentive: only `incentive` rows
  // are ever paid; `unpaid`/`illegal` rows never carry an incentive_cents.
  kind                   ConsumerDropoffKind
  /// CIP PII — Exhibit I / ADR-0010; never exported.
  ///
  /// ADR-0085 relaxed this to NULLABLE for the two `floor_*` kinds only, which
  /// deliberately capture no identity. The old NOT NULL invariant still holds
  /// for `incentive`/`unpaid`/`illegal` — enforced by the
  /// `consumer_dropoffs_non_floor_requires_person` CHECK constraint, because an
  /// unscoped loosening is just a hole. Both constraints live in
  /// `20260838a_adr0085_ipad_dropoff`; Prisma cannot express a CHECK.
  person_name            String?
  // ADR-0037 amendment (rollup §1.3, Kelsey Q4) — optional traceable consumer name on
  // UNPAID records. Distinct from the required incentive-payee `person_name`; also CIP PII.
  consumer_name          String?
  slip_number            String?
  units                  Int
  incentive_cents        Int? // computed via D1 (incentive kind only); capped per person per day
  // ADR-0037 amendment (rollup §1.3) — explicit dollar/check amount for UNPAID Bye-Bye-
  // Mattress drop-offs (distinct from the rule-capped, incentive-kind-only `incentive_cents`).
  // Default at capture = `units × 300`¢ ($3/unit), overridable. Null when not captured.
  incentive_amount_cents Int?
  check_number           String?
  paid_at                DateTime?
  retrac_id              String?
  source                 RecordSource        @default(manual)
  import_id              String? // ADR-0048 — workbook_promotions.id when promoted from staging

  /// ADR-0085 — the required drop-off photo, mirroring `load_photos` (including
  /// `uploaded_by`). Columns rather than a side table: exactly one photo, always
  /// present, and a CHECK constraint can enforce "no floor drop-off without a
  /// photo" against a column in a way it cannot against another table's absence.
  /// Null for the manager-entered kinds, which have never carried a photo.
  photo_storage_key      String?
  photo_content_type     String?
  photo_byte_size        Int?
  /// The operator whose SESSION submitted the row — never a name typed by
  /// anyone, never the consumer. ADR-0078 Am.1's lesson, applied from row one.
  photo_uploaded_by      String?
  photo_captured_at      DateTime?

  locked_at              DateTime? // edit-before-any-lock guard (CRUD-lite)
  created_by             String?
  created_at             DateTime            @default(now())
  updated_at             DateTime            @updatedAt

  @@index([site_id, dropoff_date])
  @@index([site_id, person_name, dropoff_date]) // daily-cap aggregation
  @@index([retrac_id])
  @@map("consumer_dropoffs")
}

/// ADR-0037 D4 (Addendum B1) — outbound materials on two axes: commodity ×
/// sub-category. The `renovator_shipments` table of the accepted ADR is folded in
/// here as `sub_category = renovation` (a whole-unit sale), replacing the separate
/// channel.
///
/// - `renovation` rows carry whole units + a program/non-program split
///   (`program_units + non_program_units == whole_units` when `whole_units` is
///   present) and feed the running balance's WholeUnitsSold term. They are the
///   recovery-rate-workable shape.
/// - `baled` / `shredded` rows are weight-based commodity SALES: `whole_units` and
///   both unit-split columns are NULL; only `weight_lbs` is meaningful. They do
///   NOT subtract from the running balance (post-deconstruction commodities;
///   deconstruction is what `processed` already counts).
///
/// `allocation_pct` stays a NULLABLE placeholder (semantics pending Kelsey —
/// nothing computes from it). Avg-per-bale is derived at read time
/// (`weight_lbs / bale_count`), NEVER stored — one source of truth.
model OutboundMaterial {
  id                        String              @id @default(uuid())
  site_id                   String
  site                      Site                @relation(fields: [site_id], references: [id])
  ship_date                 DateTime            @db.Date
  commodity                 OutboundCommodity
  sub_category              OutboundSubCategory
  weight_lbs                Int
  // Renovation (whole-unit) rows only; null for baled/shredded commodity sales.
  // When `whole_units` is set, `program_units + non_program_units == whole_units`
  // (validated). Program units sold to renovation come out of PROGRAM inventory
  // and can NEVER be billed as processed.
  whole_units               Int?
  program_units             Int?
  non_program_units         Int?
  ticket_number             String?
  retrac_id                 String?
  bale_count                Int?
  allocation_pct            Decimal?            @db.Decimal(5, 2) // placeholder; nothing computes from it
  buyer                     String?
  // ADR-0055 — first-class recycler (outbound vendor) this load shipped to.
  // Nullable & additive: the free-text `buyer` above stays the legacy/reconciliation
  // field; `vendor_id` is the structured reference the recycling-rate derivation
  // resolves against. Backfilled separately (buyer string → vendor row).
  vendor_id                 String?
  vendor                    OutboundVendor?     @relation(fields: [vendor_id], references: [id])
  // ADR-0055 — CalRecycle stewardship split, DERIVED at entry time from
  // recycling_rates(vendor_id, commodity, ship_date). Reported SEPARATELY for
  // stewardship (O-7); NOT part of the MRC invoice (ADR-0041). Both are null when
  // no rate row covers (vendor, commodity, ship_date) — never silently assumed.
  // Invariant: recycled_lbs + landfilled_lbs == weight_lbs (complement-by-subtraction).
  recycled_lbs              Int?
  landfilled_lbs            Int?
  // Snapshot of the recycling_percent actually applied (Decimal(5,4), 0..1), plus a
  // provenance FK to the exact rate row that resolved. The snapshot is the DURABLE
  // audit value — it survives later edits/deletes of the rate row.
  recycling_percent_applied Decimal?            @db.Decimal(5, 4)
  recycling_rate_id         String?
  recycling_rate            RecyclingRate?      @relation(fields: [recycling_rate_id], references: [id], onDelete: SetNull)
  source                    RecordSource        @default(manual)
  import_id                 String? // ADR-0048 — workbook_promotions.id when promoted from staging
  locked_at                 DateTime?
  created_by                String?
  created_at                DateTime            @default(now())
  updated_at                DateTime            @updatedAt

  // ADR-0052 — optional payment-tracking companion (financial reconciliation
  // stays out of the operational capture row).
  payment OutboundMaterialPayment?

  @@index([site_id, ship_date])
  @@index([site_id, commodity, ship_date])
  @@index([site_id, sub_category, ship_date]) // renovation WholeUnitsSold query (running balance)
  @@index([vendor_id]) // ADR-0055 — per-recycler stewardship rollups
  @@index([retrac_id])
  @@map("outbound_materials")
}

/// ADR-0055 — outbound recycler / commodity buyer master. GLOBAL (not site-scoped):
/// a recycler's recovery rate is a property of the RECYCLER, org-wide, not of the
/// collection site that shipped the load — so this mirrors the global `Transporter`
/// master (unique name), NOT the site-scoped `Source` (inbound collection site).
/// Formalizes the free-text `outbound_materials.buyer` (SA Recycling, Green Zone,
/// Xtraction, Biomass, …) into a referenceable entity for rate configuration.
model OutboundVendor {
  id         String   @id @default(uuid())
  name       String   @unique // verbatim recycler name (reconciliation match)
  is_active  Boolean  @default(true)
  notes      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  recycling_rates    RecyclingRate[]
  outbound_materials OutboundMaterial[]

  @@index([is_active])
  @@map("outbound_vendors")
}

/// ADR-0055 — effective-dated recycler recovery rate per (vendor, commodity).
/// `recycling_percent` is the fraction of a load's weight the recycler counts as
/// RECYCLED (steel→`metal` in the existing taxonomy; the balance is landfilled).
/// Green Zone × metal = 1.0000; Xtraction × metal = 0.8100; Biomass × wood = 1.0000.
///
/// Resolution mirrors the `state_program_rules` / `processor_bonus_rules` pattern
/// (a strict named resolver picks the row whose `effective_from <= onDate` and whose
/// `effective_to` is null or `>= onDate`). Overlap is guarded THREE ways so a bad
/// seed can't silently double-resolve a rate (see recycling-rates.ts):
///   1. partial UNIQUE index on (vendor_id, commodity) WHERE effective_to IS NULL —
///      at most ONE open-ended "current" rate per (vendor, commodity);
///   2. a transactional overlap check at write time (advisory-locked) rejecting any
///      proposed window that overlaps an existing one for the same (vendor, commodity);
///   3. the resolver throws AmbiguousRecyclingRateError if >1 row ever covers a date.
/// A GiST/`btree_gist` EXCLUDE constraint would be the textbook DB-level guard, but
/// the fleet uses no Postgres extensions and it risks the ADR-0035 clean-replay
/// invariant — rejected in the ADR's Alternatives.
///
/// `recycling_percent` is Decimal(5,4) — represents 0.8100 exactly, holds 1.0000,
/// and a CHECK constraint (migration) fences it to [0, 1]. NOT part of the MRC
/// invoice (ADR-0041); feeds CalRecycle stewardship reporting only (O-7 seam).
model RecyclingRate {
  id                String            @id @default(uuid())
  vendor_id         String
  vendor            OutboundVendor    @relation(fields: [vendor_id], references: [id])
  commodity         OutboundCommodity
  recycling_percent Decimal           @db.Decimal(5, 4) // [0,1]; 0.8100 = 81% recycled
  effective_from    DateTime          @db.Date
  effective_to      DateTime?         @db.Date
  notes             String?
  created_by        String?
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt

  derived_outbounds OutboundMaterial[]

  @@index([vendor_id, commodity, effective_from])
  @@map("recycling_rates")
}

// ADR-0052 — commodity payment reconciliation (v1). One row per tracked load;
// a load with NO row is implicitly `awaiting_invoice`. Status changes are
// forward transitions with provenance; history is append-only in audit_log.
enum CommodityPaymentStatus {
  awaiting_invoice
  invoiced
  paid
  disputed
}

model OutboundMaterialPayment {
  id                   String                 @id @default(uuid())
  outbound_material_id String                 @unique
  outbound_material    OutboundMaterial       @relation(fields: [outbound_material_id], references: [id])
  status               CommodityPaymentStatus @default(awaiting_invoice)
  buyer_invoice_ref    String?
  // D2 — optional at `invoiced`; Decimal at every money edge (never float).
  expected_amount      Decimal?               @db.Decimal(12, 2)
  invoiced_at          DateTime?              @db.Date
  paid_at              DateTime?              @db.Date
  notes                String?
  created_by           String?
  updated_by           String?
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt

  @@index([status])
  @@map("outbound_material_payments")
}

/// ADR-0037 D4 — whole-unit landfill disposal (workbook Landfilled Units
/// block). `units` subtract from the inventory running balance.
model LandfilledUnit {
  id                String           @id @default(uuid())
  site_id           String
  site              Site             @relation(fields: [site_id], references: [id])
  disposal_date     DateTime         @db.Date
  units             Int
  // ADR-0037 D6 + survey amendment (2026-07-03): pool-aware inventory —
  // `program_units + non_program_units == units` (validated). Defaulting all to
  // one pool is wrong; the entry surface captures the split.
  program_units     Int              @default(0)
  non_program_units Int              @default(0)
  slip_number       String?
  reason            LandfilledReason
  source            RecordSource     @default(manual)
  import_id         String? // ADR-0048 — workbook_promotions.id when promoted from staging
  locked_at         DateTime?
  created_by        String?
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt

  @@index([site_id, disposal_date])
  @@map("landfilled_units")
}

/// ADR-0037 D5 — the number billing bills from: processed units per site per
/// day. DISTINCT from per-processor `bonus_daily_entries` (those drive payroll;
/// this is the site-level billing basis). One row per site per day. Entry is
/// office-desktop, super-admin gated; closing a day writes an audit row;
/// post-close corrections follow the amendment pattern (never in-place edits).
/// Decimal(7,1) matches the bonus system's half-unit precision.
model ProcessedUnitsDaily {
  id              String   @id @default(uuid())
  site_id         String
  site            Site     @relation(fields: [site_id], references: [id])
  production_date DateTime @db.Date

  // ADR-0037 D5 (Addendum B4) — the STRIPPED (deconstructed) quantities entered at
  // the daily close, split program vs non-program (the billing basis: on a 175-unit
  // day with 150 program units on the floor MRC is billed ONLY the 150). Billing
  // (P2) reads `stripped_program` only. The total is DERIVED at read time (never
  // stored). Decimal(7,1) matches the bonus system's half-unit precision. These are
  // the equation's `Stripped` term: End = Start + Inbound − Stripped − WholeUnitsSold − Landfilled.
  stripped_program     Decimal @db.Decimal(7, 1)
  stripped_non_program Decimal @default(0) @db.Decimal(7, 1)

  // ADR-0037 Addendum B4 + amendment (rollup §A.2, Kelsey 2026-07-17) — the `Saved`
  // (workbook I42) mattresses set aside, not processed. Kelsey confirmed: SUBTRACTED from
  // inventory, NOT counted as processed, drawn from the NON-PROGRAM pool. Now wired into
  // the running balance (inventory/running-balance.ts). Defensible default until Rick
  // confirms OR practice (Woodland saves very few).
  saved_units Decimal? @db.Decimal(7, 1)

  // ADR-0037 Addendum B4 — daily-close metadata (workbook fields). Display-only in
  // P1; no computation reads them yet.
  material_ticket_number String? // workbook M-xxxxxx
  employees_count        Int?
  processors_count       Int?
  pocketcoil_estimate    Int?

  source     RecordSource @default(manual)
  import_id  String? // ADR-0048 — workbook_promotions.id when promoted from staging
  entered_by String?
  closed_at  DateTime? // set on close; post-close edits are blocked
  notes      String?
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  @@unique([site_id, production_date])
  @@index([site_id, production_date])
  @@map("processed_units_daily")
}

// ADR-0038 — MyMRC mirrors
//
// Raw mirror of the MyMRC (Salesforce Experience Cloud) portal feeds. These
// are AUDIT-EVIDENCE tables, not operational tables: the 3-way audit (ADR-0039)
// compares daily-logs ↔ MyMRC ↔ billing, so MyMRC data must land in its own
// independent leg. Only Hauls additionally feed `expected_loads` (operational
// queue) via the existing scrape upsert path. `processed`/`outbound` feed
// nothing operational.
//
// Keying: `id` is the Salesforce record id (stable portal external id, always
// present from the list feed — the upsert key). `external_*_id` is the human
// portal number (Haul "H-…" / Materials "M-…"), populated on the detail pass
// (nullable until then; unique-when-present). `payload` retains the full raw
// record representation for audit + future column needs.
//
// `site_id` is a scalar FK (constraint added in the migration SQL) — no Prisma
// relation field, deliberately, so this block stays self-contained and does not
// edit the Site model.
// ────────────────────────────────────────────────────────────────────────

enum MymrcSyncStatus {
  ok
  auth_failed
  contract_drift
  // The scrape completed, but the mirror it maintains is not current — the
  // feed's newest business record is older than the freshness threshold
  // (src/lib/mymrc/freshness.ts). Added 2026-07-31 so `ok` can no longer mean
  // "listed rows, learned nothing, mirror frozen".
  stale_mirror
  error
}

model MymrcHaulsMirror {
  id                            String    @id // Salesforce record id (Haul_Request__c, a2K…) — upsert key
  // site_id is NULLABLE (ADR-0057 Phase-1): getItems returns record ids only, so the
  // site is unknown at list-upsert time. It is derived on the DETAIL pass from
  // `recycler_name` (Recycling_Center_Lookup__r.Name) → sites.code and stamped then.
  // Nullable FK: NULL rows are simply unresolved-until-detail (never a broken ref).
  site_id                       String?
  external_haul_id              String?   @unique // Name, portal Haul number e.g. "H-900001" (detail pass)
  status                        String? // Status__c, e.g. "Confirmed"
  type                          String? // Type__c — splits docking-appointment vs consumer/illegal drop-off
  rate_id                       String? // Rate_ID__c (landfill - transporter - recycler descriptor)
  recycler_name                 String? // Recycling_Center_Lookup__r.Name — SITE DISCRIMINATOR (→ site_id)
  recycler_account_id           String? // Recycling_Center_Lookup__c — 18-char Account id (structured join)
  transporter_name              String? // Transporter__c — account-name string (denormalized, not an FK)
  collection_site               String? // Collection_Site__c — expected_loads source-name join key
  collection_source             String? // Collection_Source__c
  commodity                     String? // Commodity__c
  container_type                String? // Container_Type__c (typographic apostrophe — normalize before compare)
  // Billing-relevant unit counts (read from `value`, not displayValue).
  program_unit_count            Int? // Recycler_Program_Unit_Count__c
  non_program_unit_count        Int? // Recycler_Non_Program_Unit_Count__c
  unpaid_consumer_dropoff_units Int? // Unpaid_Consumer_Drop_Off_Units__c
  docking_appointment_date      DateTime? // Docking_Appointment_Date__c (Date)
  docking_appointment_at        DateTime? // parsed from free-text Docking_Appointment_Time__c ("2026/07/20 12:00 PT")
  door                          String? // Docking_Appointment_Dock_Door__c
  // ADR-0089 Am.1 — the TRUE delivery date (primary inbound key; the dock date is a
  // scheduling field, null on the whole collection network and up to a week wrong even
  // when present). Proven populated live 2026-08-10. Transporter date is defensive
  // (null in practice); unload count is the F-3 physical-receipt cross-check input.
  recycler_reported_delivery_date    DateTime? // Recycler_Reported_Delivery_Date__c (Date)
  transporter_reported_delivery_date DateTime? // Transporter_Reported_Delivery_Date__c (Date)
  unit_count_at_unload               Int? // Unit_Count_at_Unload__c
  units                         Int? // legacy generic unit count (back-compat; program_unit_count is authoritative)
  weight_lbs                    Decimal?  @db.Decimal(12, 2) // Recycler_Weight__c
  retrac_id                     String? // Re-TRAC id; 1:1 with external_haul_id per ADR post-note (UNVERIFIED)
  payload                       Json? // FULL raw record representation (ADR-0038 D2 audit evidence)
  first_seen_at                 DateTime  @default(now())
  last_seen_at                  DateTime  @default(now())
  disappeared_at                DateTime? // stamped when absent from a full list fetch
  detail_fetched_at             DateTime? // stamped when the getRecordWithFields detail pass succeeds
  created_at                    DateTime  @default(now())
  updated_at                    DateTime  @updatedAt

  @@index([site_id])
  @@index([disappeared_at])
  @@index([detail_fetched_at])
  @@index([recycler_account_id]) // structured site/customer join
  // ADR-0074 — the iPad portal-haul list filters on site and orders by docking
  // date descending over the whole 7,285-row mirror; the site-only index left the
  // sort unindexed. `sort: Desc` is NOT decoration: the hand-written migration
  // creates the column DESC, and expressing it here is what keeps
  // `prisma migrate diff` clean (a plain `@@index` reports a spurious
  // drop-and-recreate against the real index forever).
  @@index([site_id, docking_appointment_date(sort: Desc)])
  @@map("mymrc_hauls_mirror")
}

// Materials__c (a2L) rows where Type__c = 'Processing'. The Processed/Outbound
// split is by Type__c at ingest (NOT by list view) — both views live in the same
// a2L id space. `type` records the raw Type__c for traceability.
model MymrcProcessedMirror {
  id                     String    @id // Salesforce record id (Materials__c, a2L…) — upsert key
  site_id                String? // NULLABLE — derived on detail pass from account_name (see hauls note)
  external_materials_id  String?   @unique // Name, portal Materials number e.g. "M-000300"
  type                   String? // Type__c (expected 'Processing')
  account_name           String? // Account__r.Name — SITE DISCRIMINATOR (→ site_id)
  account_id             String? // Account__c — 18-char Account id (structured join)
  materials_status       String? // Materials_Status__c, e.g. "Active"
  bol_id                 String? // BOL_ID__c
  entry_date             DateTime? // Entry_Date__c
  processed_date         DateTime? // Processed_Date__c
  program_unit_count     Int? // Number_of_Program_Units__c (billable count)
  non_program_unit_count Int? // Number_of_Non_Program_Units__c
  units                  Int? // legacy generic unit count (back-compat; program_unit_count authoritative)
  weight_lbs             Decimal?  @db.Decimal(12, 2) // Materials__c has NO weight field — stays null
  retrac_id              String?
  payload                Json? // FULL raw record representation (ADR-0038 D2 audit evidence)
  first_seen_at          DateTime  @default(now())
  last_seen_at           DateTime  @default(now())
  disappeared_at         DateTime?
  detail_fetched_at      DateTime?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  @@index([site_id])
  @@index([disappeared_at])
  @@index([detail_fetched_at])
  @@index([account_id])
  @@map("mymrc_processed_mirror")
}

// Materials__c (a2L) rows where Type__c = 'Outbound'. Same object/id space as
// the processed mirror — a record whose Type__c flips can appear in both tables;
// the sync must classify by Type__c, not by which list view produced the id.
model MymrcOutboundMirror {
  id                     String    @id // Salesforce record id (Materials__c, a2L…) — upsert key
  site_id                String? // NULLABLE — derived on detail pass from account_name (see hauls note)
  external_materials_id  String?   @unique // Name, portal Materials number e.g. "M-000264"
  type                   String? // Type__c (expected 'Outbound')
  account_name           String? // Account__r.Name — SITE DISCRIMINATOR (→ site_id)
  account_id             String? // Account__c — 18-char Account id (structured join)
  materials_status       String? // Materials_Status__c
  bol_id                 String? // BOL_ID__c (e.g. "125829"), populated on outbound rows
  vendor                 String? // Outbound_Vendor_Name__c — LIST-ONLY column (captured from getItems, absent from detail)
  entry_date             DateTime? // Entry_Date__c
  shipment_date          DateTime? // no real Shipment_Date__c field exists on Materials — stays null (kept, not dropped)
  program_unit_count     Int? // Number_of_Program_Units__c
  non_program_unit_count Int? // Number_of_Non_Program_Units__c
  weight_lbs             Decimal?  @db.Decimal(12, 2) // Materials__c has NO weight field — stays null
  retrac_id              String?
  payload                Json? // FULL raw record representation (ADR-0038 D2 audit evidence)
  first_seen_at          DateTime  @default(now())
  last_seen_at           DateTime  @default(now())
  disappeared_at         DateTime?
  detail_fetched_at      DateTime?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  @@index([site_id])
  @@index([disappeared_at])
  @@index([detail_fetched_at])
  @@index([account_id])
  @@map("mymrc_outbound_mirror")
}

// ────────────────────────────────────────────────────────────────────────
// Dock_Availability_Schedule__c (a1t) — NEW mirror (ADR-0057 Phase 1)
// ────────────────────────────────────────────────────────────────────────
//
// Scheduling object (14 detail fields), NON-billing. Record count is exact
// (14, not windowed). NO site discriminator exists in the field set, so this
// mirror carries no site_id. displayValue/value divergence is severe here —
// the sync must read `value`: Day_of_Week__c value is numeric codes ("1;2;…"),
// Dock_Door__c value ("Dock Door 1") ≠ displayValue ("Schedule 1"). Multipicklist
// fields (Container_Type__c, Day_of_Week__c) are one ";"-joined string — stored
// RAW here (membership splitting is a read-side concern). Slot_Start/End_Time__c
// are Salesforce Time values ("07:00:00.000Z") — stored as TEXT (NOT a datetime;
// never Date.parse). Same list→detail two-pass lifecycle as the other mirrors.
model MymrcDockAvailabilityMirror {
  id                      String    @id // Salesforce record id (Dock_Availability_Schedule__c, a1t…)
  external_schedule_id    String?   @unique // Name, e.g. "DA-900001"
  status                  String? // Status__c, e.g. "Active"
  day_of_week             String? // Day_of_Week__c — RAW ";"-joined numeric codes ("1;2;3;4;5")
  container_type          String? // Container_Type__c — RAW ";"-joined multipicklist
  dock_door               String? // Dock_Door__c value ("Dock Door 1"), NOT displayValue
  slot_start_time         String? // Slot_Start_Time__c — SF Time text ("07:00:00.000Z"), NOT a datetime
  slot_end_time           String? // Slot_End_Time__c — SF Time text
  available_appointments  Int? // Number_of_Available_Appointments__c
  availability_start_date DateTime? // Availability_Start_Date__c (Date)
  payload                 Json? // FULL raw record representation (ADR-0038 D2 audit evidence)
  first_seen_at           DateTime  @default(now())
  last_seen_at            DateTime  @default(now())
  disappeared_at          DateTime?
  detail_fetched_at       DateTime?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  @@index([disappeared_at])
  @@index([detail_fetched_at])
  @@map("mymrc_dock_availability_mirror")
}

// ────────────────────────────────────────────────────────────────────────
// MyMRC backfill cursors (ADR-0057 D3) — resumable windowed backfill
// ────────────────────────────────────────────────────────────────────────
//
// getItems paginates by offset/page-number (pageSize + currentPage, 0-based);
// `hasMoreData:true` means the page is a FLOOR → keep paging until false. A full
// historical backfill must page every list view of an object to completion and
// dedupe ids across views. This table persists per-(object, list-view) progress
// so a crashed/interrupted backfill resumes from `last_page_index` instead of
// restarting. Self-contained: no FKs (matches the mirror/queue blocks).
//
// Key: (object_api_name, list_view_api_name). `list_view_api_name` defaults to ''
// for an object-level cursor when a caller is not yet list-view-aware. `completed_at`
// is stamped when hasMoreData:false is reached (cursor drained). `error` holds the
// last human failure text (never credentials).
model MymrcBackfillCursor {
  id                      String    @id @default(uuid())
  object_api_name         String // e.g. "Haul_Request__c"
  list_view_api_name      String    @default("") // which list view is being paged ('' = object-level)
  last_page_index         Int       @default(0) // 0-based currentPage of the last COMPLETED page
  last_record_id          String? // last record id seen (audit/debug)
  total_records_estimated Int? // floor estimate while windowed; null until known
  records_completed       Int       @default(0)
  started_at              DateTime  @default(now())
  completed_at            DateTime? // set when hasMoreData:false reached (backfill drained)
  error                   String? // last human failure text (never credentials)
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  @@unique([object_api_name, list_view_api_name])
  @@index([object_api_name])
  @@map("mymrc_backfill_cursors")
}

model MymrcSyncRun {
  id              String          @id @default(uuid())
  site_id         String
  feed            String // 'hauls' | 'processed' | 'outbound'
  started_at      DateTime        @default(now())
  finished_at     DateTime?
  status          MymrcSyncStatus
  rows_listed     Int             @default(0)
  rows_upserted   Int             @default(0)
  details_fetched Int             @default(0)
  error           String? // human error text (never contains credentials)
  run_id          String? // per-run correlation id (crypto.randomUUID); ties every log line of a run to this ledger row
  created_at      DateTime        @default(now())

  @@index([site_id, feed, started_at])
  @@index([feed, status, started_at])
  @@map("mymrc_sync_runs")
}

// ────────────────────────────────────────────────────────────────────────
// MyMRC admin credential store (ADR-0057 D1/D9)
// ────────────────────────────────────────────────────────────────────────
//
// Single encrypted row holding Bill's MyMRC (Salesforce Experience Cloud)
// admin login. Replaces the retired per-site env-var scheme (ADR-0057 D1):
// creds are entered through the admin surface and read by the scrape from
// this table — never from a `.env` file (operator rule).
//
// The password is AES-256-GCM encrypted at rest; only
// `src/lib/mymrc/credential-store.ts` ever decrypts it, and the plaintext
// NEVER crosses a client boundary, an API response, or a log line. `username`
// is stored plaintext (a login id, not a secret). Exactly one row exists:
// `id = 'singleton'`, enforced by a CHECK constraint in the migration and by
// keying every write on that id via upsert. `updated_by` is a bare
// audit-actor user id (no FK; mirrors FileDrop.uploaded_by / AP decided_by).
model MymrcAdminCredential {
  id                  String   @id @default("singleton")
  username            String
  password_ciphertext String // base64(AES-256-GCM ciphertext)
  password_iv         String // base64(12-byte GCM nonce)
  password_auth_tag   String // base64(16-byte GCM auth tag)
  key_version         Int      @default(1) // pins KDF+salt+cipher; bump to rotate scheme
  updated_by          String // bare audit-actor user id (no FK)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@map("mymrc_admin_credentials")
}

// ────────────────────────────────────────────────────────────────────────
// MyMRC reconciliation queue (ADR-0057 D4 — the canonical write gate)
// ────────────────────────────────────────────────────────────────────────
//
// Vision NEVER auto-updates operational tables (`sources`, `source_aliases`,
// `state_program_rules`, …) from MyMRC. Mirror sync instead writes candidate
// changes here; an admin approves/rejects/snoozes each one at
// `/admin/mymrc/reconcile` (mirrors the AP approval note pattern, ADR-0046).
// On Approve, Vision writes the change to the target operational table and
// stamps `decided_at`/`decided_by`. The pending row is preserved after a
// decision (audit evidence).
//
// This is a NEW, separate model — do NOT confuse it with the pre-existing
// `MymrcReconciliation`/`MymrcReconciliationItem` (the ADR-0038-era CSV
// weight/count compliance upload). Different feature, different table.
//
// Bare scalar references (no Prisma relations): `mirror_record_id` /
// `target_record_id` point at heterogeneous-PK rows across many mirror and
// operational tables, so no FK is declared — the block stays self-contained,
// matching the `mymrc_*_mirror` / `collection_events` pattern. `decided_by`
// is a bare audit-actor user id (mirrors MymrcAdminCredential.updated_by / AP
// decided_by). `mymrc_value` is required (the classifier always has the
// MyMRC-side value, storing JSON `null` for `disappeared`); `vision_value` is
// null for `new_record` (no matched Vision entity yet). `snooze_until` carries
// the 7-day snooze wake time (NULL unless status = snoozed).
enum ReconChangeKind {
  new_record // mirror record with no matching Vision entity (name miss verbatim + alias)
  field_update // mirror field differs from the linked Vision entity
  disappeared // mirror row has disappeared_at; linked Vision entity may need deactivation
}

enum ReconStatus {
  pending
  approved
  rejected
  snoozed
}

model MymrcReconciliationQueue {
  id               String          @id @default(uuid())
  mirror_table     String // e.g. 'mymrc_accounts_mirror'
  mirror_record_id String // bare reference to the mirror row (no FK; heterogeneous PKs)
  target_table     String // operational target, e.g. 'sources'
  target_record_id String? // existing Vision row if matched (null for new_record)
  field_name       String // 'name' | 'address' | 'category' | ...
  mymrc_value      Json // MyMRC-side value (JSON null for disappeared)
  vision_value     Json? // Vision-side value (null for new_record)
  change_kind      ReconChangeKind
  status           ReconStatus     @default(pending)
  created_at       DateTime        @default(now())
  decided_at       DateTime?
  decided_by       String? // bare audit-actor user id (no FK)
  decision_note    String? // required at the API boundary on approve/reject (mirrors AP)
  snooze_until     DateTime? // 7-day snooze wake time (set only when status = snoozed)

  @@index([status, mirror_table, change_kind]) // pending queue filtered view (D4)
  @@index([mirror_table, mirror_record_id]) // per-mirror-row lookups + classifier dedup pre-check
  @@index([target_table, target_record_id]) // "what pending changes target this Vision row"
  @@map("mymrc_reconciliation_queue")
}

// ════════════════════════════════════════════════════════════════════════
// 3-way audit engine + retro-audit (ADR-0039)
//
// Three structurally-independent legs are compared by pure comparators
// (src/lib/audit/): Vision operational data (ADR-0037 tables), MyMRC mirrors
// (ADR-0038), and billing (P2 / historical workbooks). Findings are durable,
// deduplicated by fingerprint, and carry a review lifecycle. All tables are
// additive — none feed the operational tables (findings never mutate source
// data; fixing happens in the source records via their own audited flows).
// ════════════════════════════════════════════════════════════════════════

enum AuditCheckCode {
  c1_inbound
  c2_processed
  c3_outbound
  c4_billing_basis
  c5_conservation
  c6_inventory_continuity
  c7_deadline
  summary_recompute
  // ADR-0043 (P3) — rate alerts + missing-record detection. Registered on the
  // same engine as C1–C7 (comparator fn + audit_check_config row + fingerprinted
  // findings). R = rate below contract floor + margin; M = a required record is
  // missing past its grace/cadence.
  r1_recycling_rate
  r2_recovery_rate
  m1_missing_close
  m2_missing_snapshot
  // ADR-0052 — commodity payment reconciliation aging (per-buyer rollup).
  m3_commodity_payment_aging
}

enum AuditFindingKind {
  missing_counterpart
  value_mismatch
  date_mismatch
  unresolved_site
  dropped_row
}

enum AuditFindingStatus {
  open
  acknowledged
  resolved
  not_an_issue
}

// Separates data-entry mistakes from real operational causes (Morena Q5/Q8).
enum AuditFindingCause {
  data_entry
  operational
  external_mymrc
  template_defect
  unknown
  // ADR-0039 Amendment 1 / ADR-0047 — a finding auto-resolved because its leg
  // had not gone live (bootstrap artifact, not a real discrepancy). Never
  // deleted; the ledger stays honest.
  bootstrap_suppression
}

enum AuditSeverity {
  low
  medium
  high
  critical
}

enum AuditRunStatus {
  ok
  partial
  error
}

enum WorkbookImportStatus {
  uploaded
  parsing
  parsed
  failed
}

// A single durable discrepancy. Re-runs upsert by `fingerprint` (check_code +
// normalized refs + window semantics): unchanged → refresh last_seen_at;
// corrected → auto-resolve. Findings NEVER mutate the underlying data.
model AuditFinding {
  id                  String             @id @default(uuid())
  site_id             String
  site                Site               @relation(fields: [site_id], references: [id])
  check_code          AuditCheckCode
  window_start        DateTime           @db.Date
  window_end          DateTime           @db.Date
  severity            AuditSeverity
  finding_kind        AuditFindingKind
  // Opaque references into the two legs (Vision row id / external id / cell ref).
  leg_a_ref           String?
  leg_b_ref           String?
  expected            Json? // what leg A / the invariant expected
  actual              Json? // what leg B / the data actually showed
  detail_json         Json? // provenance + evidence payload rendered in the review UI
  fingerprint         String             @unique
  status              AuditFindingStatus @default(open)
  // Nullable until a reviewer classifies the discrepancy.
  cause_category      AuditFindingCause?
  resolution_note     String?
  resolved_by_user_id String?
  resolved_by         User?              @relation("AuditFindingResolver", fields: [resolved_by_user_id], references: [id])
  resolved_at         DateTime?
  // Set for retro-audit findings sourced from a historical workbook import.
  import_id           String?
  workbook_import     WorkbookImport?    @relation(fields: [import_id], references: [id])
  first_detected_at   DateTime           @default(now())
  last_seen_at        DateTime           @default(now())
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt

  @@index([site_id, status])
  @@index([site_id, check_code, window_start])
  @@index([import_id])
  @@map("audit_findings")
}

// Per-check tolerance/severity data — tolerances are DATA, not code (ADR-0039
// D1). A row with `site_id = null` is the global default; a per-site row (same
// check_code, site set) overrides it.
model AuditCheckConfig {
  id                   String         @id @default(uuid())
  site_id              String?
  site                 Site?          @relation(fields: [site_id], references: [id])
  check_code           AuditCheckCode
  enabled              Boolean        @default(true)
  severity             AuditSeverity  @default(medium)
  unit_tolerance       Int            @default(0)
  weight_tolerance_lbs Int            @default(0)
  // Grace business days before a same-day gap becomes a finding (C3 EOD+1 = 1).
  grace_business_days  Int            @default(0)
  // Long open window for slow-settling legs (vendor invoices — Kelsey Q8 45 days).
  open_window_days     Int?
  // Whether a finding from this check contributes to the P2 billing trust gate.
  blocks_billing       Boolean        @default(true)
  params               Json?
  created_at           DateTime       @default(now())
  updated_at           DateTime       @updatedAt

  @@unique([site_id, check_code])
  @@map("audit_check_config")
}

// Retro-audit staging: an admin uploads a historical monthly workbook (xlsx);
// the parser maps the §4 tab structure into staging rows tagged `import_id`
// (NEVER into operational tables). The original file is retained in R2 for
// evidence (`storage_key`).
model WorkbookImport {
  id                  String               @id @default(uuid())
  site_id             String
  site                Site                 @relation(fields: [site_id], references: [id])
  original_filename   String
  storage_key         String? // R2 evidence key (workbook-imports/ prefix)
  // Which of the ≥3 template generations the parser detected (Janette Q8).
  template_generation String? // 'no_calc' | 'calc' | 'eod_carryover' | 'unknown'
  period_label        String? // e.g. 'June 2026'
  status              WorkbookImportStatus @default(uploaded)
  uploaded_by_user_id String
  uploaded_by         User                 @relation("WorkbookImportUploader", fields: [uploaded_by_user_id], references: [id])
  parse_error         String?
  sheet_count         Int?
  row_count           Int                  @default(0)
  created_at          DateTime             @default(now())
  updated_at          DateTime             @updatedAt

  rows     WorkbookImportRow[]
  findings AuditFinding[]

  @@index([site_id, created_at])
  @@map("workbook_imports")
}

// One parsed cell/record with full tab/row/col provenance (ADR-0039 D4:
// "every parsed cell keeps its tab/row/col provenance for evidence").
model WorkbookImportRow {
  id               String         @id @default(uuid())
  import_id        String
  workbook_import  WorkbookImport @relation(fields: [import_id], references: [id], onDelete: Cascade)
  tab_name         String
  row_index        Int
  col_ref          String // 'N85', a column letter, or a logical key
  section          String? // 'inbound' | 'outbound' | 'summary' | 'inventory' | ...
  field_key        String? // normalized field name
  raw_value        String?
  numeric_value    Decimal?       @db.Decimal(14, 2)
  // Verbatim site name for alias resolution (workbook lists carry spelling drift).
  site_name_raw    String?
  resolved_site_id String?
  provenance       Json? // { tab, row, col, formula? }
  created_at       DateTime       @default(now())

  @@index([import_id, tab_name])
  @@map("workbook_import_rows")
}

// Run ledger — every sweep / on-demand / retro run writes a row (freshness +
// deadman + summary surface; mirrors ADR-0038's mymrc_sync_runs). A green run
// with no findings is normal; a thrown run is `error` and pages ntfy.
model AuditRun {
  id                   String         @id @default(uuid())
  site_id              String?
  site                 Site?          @relation(fields: [site_id], references: [id])
  trigger              String // 'nightly_sweep' | 'on_demand' | 'retro_workbook'
  window_start         DateTime       @db.Date
  window_end           DateTime       @db.Date
  status               AuditRunStatus @default(ok)
  checks_run           String[]
  findings_opened      Int            @default(0)
  findings_updated     Int            @default(0)
  findings_resolved    Int            @default(0)
  // ADR-0039 Amendment 1 — per-check count of findings withheld this run because
  // the check's leg had not gone live (bootstrap gating). Shape: { checkCode: n }.
  // Null/absent = nothing suppressed. Surfaced in the admin audit page; never silent.
  suppressed_bootstrap Json?
  error_text           String?
  started_at           DateTime       @default(now())
  finished_at          DateTime?

  @@index([site_id, started_at])
  @@map("audit_runs")
}

// ════════════════════════════════════════════════════════════════════════
// ADR-0047 — staff-output rollout gate + ADR-0039 A1 leg-liveness bootstrap gate
// ════════════════════════════════════════════════════════════════════════

enum RolloutSurfaceKind {
  notification
  ui
  // ADR-0049 — the Woodland workbook→Vision sync/cutover surface. Semantics are
  // INVERTED vs a UI gate: `pilot` = sync ACTIVE (workbook wins, engine upserts),
  // `live` = CUT OVER (sync no-ops, Vision owns its own data). Interpreted by the
  // sync engine, never by `isUiSurfaceLive`. Per-site (Woodland day 1).
  workbook_sync
}

enum RolloutState {
  pilot
  live
}

/// One registered staff-facing surface (a notification path or a UI surface)
/// per site. Default `pilot`: output/visibility is admin-only until an admin
/// flips it `live` (audited, criteria noted). `site_id` null = an org-wide
/// surface (no per-site scope, e.g. the AP module). FK columns are plain
/// scalars (repo convention, mirrors ADR-0040) — the constraints live in the
/// migration so this block never edits the shared Site/User relation lists.
model RolloutSurface {
  id            String             @id @default(uuid())
  kind          RolloutSurfaceKind
  surface_code  String
  site_id       String? // null = org-wide surface
  rollout_state RolloutState       @default(pilot)
  flipped_by    String? // user id of the admin who last flipped state (bare FK column)
  flipped_at    DateTime?
  criteria_note String? // the evidence/criteria recorded at the last flip (directive §8 rule 2)
  created_at    DateTime           @default(now())
  updated_at    DateTime           @updatedAt

  // surface_code is globally unique per site scope; the (code, site) pair is the
  // stable identity notifyStaff()/the UI gate resolve against. Postgres treats
  // NULL site_id rows as distinct, so a partial unique index also guards the
  // org-wide (site_id IS NULL) case — created in the migration.
  @@unique([surface_code, site_id])
  @@index([kind])
  @@map("rollout_surfaces")
}

/// ADR-0039 Amendment 1 — admin-editable per-(site, leg) go-live override for
/// bootstrap gating. A missing-counterpart check (c4/m1/m2 + future) emits
/// findings only once its leg has EVER had data OR this `go_live_date` has
/// passed. Absence of a row ⇒ derived liveness only (leg-has-ever-had-data).
model AuditBootstrapGate {
  id           String    @id @default(uuid())
  site_id      String // bare FK column (constraint in migration)
  leg          String // 'billing' | 'close' | 'snapshot' (registry-defined)
  go_live_date DateTime? @db.Date
  note         String?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@unique([site_id, leg])
  @@map("audit_bootstrap_gates")
}

// ════════════════════════════════════════════════════════════════════════
// ADR-0043 (P3) — rate alerts + missing-record detection
// ════════════════════════════════════════════════════════════════════════

/// The digest recipient roster (D3). One row per (site, email); `active`
/// toggles a recipient without deleting the row (keeps an audit trail).
/// Seeded Morena + Janette → Woodland, Rick → Eugene; admin-editable.
model AlertRecipient {
  id         String   @id @default(uuid())
  site_id    String
  site       Site     @relation(fields: [site_id], references: [id])
  email      String
  active     Boolean  @default(true)
  created_by String? // bare audit-actor column (mirrors invoices.generated_by)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([site_id, email])
  @@index([site_id, active])
  @@map("alert_recipients")
}

/// Idempotency ledger for the daily alert digest (D3/D5). The unique
/// (site_id, digest_date) makes a same-day re-fire a no-op, mirroring the
/// `bonus_daily_report_log` pattern.
model AlertDigestLog {
  id               String   @id @default(uuid())
  site_id          String
  site             Site     @relation(fields: [site_id], references: [id])
  digest_date      DateTime @db.Date
  finding_count    Int
  recipient_count  Int
  delivered_count  Int
  graph_message_id String?
  last_status      Int?
  created_at       DateTime @default(now())

  @@unique([site_id, digest_date])
  @@index([site_id, digest_date])
  @@map("alert_digest_logs")
}

// ADR-0040 — billing rate infrastructure
//
// Every rate the P2 invoice layer (ADR-0041) reads that is NOT already in
// `state_program_rules` lives here, in effective-dated tables, so invoice
// generation is pure computation. All money is integer CENTS; effective
// windows are `@db.Date` with the same strict resolver semantics as
// `state_program_rules` / `processor_bonus_rules`.
//
// COORDINATION (ADR-0040): this whole block is self-contained at the end of
// the schema (sibling agents own audit/mymrc/loads models). To avoid touching
// the shared `Source`/`Site` models with back-relation fields, the FK columns
// below (`source_id`, `site_id`, `created_by`) are declared as plain scalars —
// the referential-integrity constraints are created at the DB level in the
// migration `20260706_billing_rate_infrastructure`, exactly as
// `state_program_rules.created_by` is a bare column today.
// ────────────────────────────────────────────────────────────────────────

/// ADR-0040 D1 (Addendum B2) — freight is a ZONE table, not $/mile: the mileage
/// band a haul falls in determines the flat freight charge. Jurisdiction is CA|OR
/// (the freight table's own key, distinct from the site `Jurisdiction` enum). Tiers
/// for a jurisdiction+effective window MUST be contiguous from 0 and non-overlapping
/// — the writer validates the whole effective set (`tier-validation.ts`); no DB
/// constraint expresses it cleanly. A renegotiation lands as NEW rows with a new
/// `effective_from`; history is never edited. No OR tiers are seeded (unknown until
/// Rick provides them — the resolver returns a typed error for OR freight meanwhile).
enum TransportRateJurisdiction {
  CA
  OR
}

model TransportRateTier {
  id             String                    @id @default(uuid())
  jurisdiction   TransportRateJurisdiction
  min_miles      Int // inclusive lower bound
  max_miles      Int // inclusive upper bound
  rate_cents     Int // flat freight charge for a haul in this band
  effective_from DateTime                  @db.Date
  effective_to   DateTime?                 @db.Date
  note           String?
  created_by     String? // users.id of the actor; bare column (see block header)
  created_at     DateTime                  @default(now())
  updated_at     DateTime                  @updatedAt

  @@index([jurisdiction, effective_from])
  @@map("transport_rate_tiers")
}

/// ADR-0040 D2 (Addendum B2 `variables!H1:Q~86`) — per-account freight override. In
/// the freight resolver an override in force for a source's date beats the tier
/// table. Seeded EMPTY (populated from the workbook variables sheet only after Rick
/// confirms which overrides are current — ADR-0040 consequences).
model AccountHaulRate {
  id             String    @id @default(uuid())
  source_id      String // FK → sources.id (constraint in migration)
  rate_cents     Int
  effective_from DateTime  @db.Date
  effective_to   DateTime? @db.Date
  note           String?
  created_by     String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@index([source_id, effective_from])
  @@map("account_haul_rates")
}

/// ADR-0040 D3 (mission §3.1) — monthly trailer/container rentals. Monthly total =
/// Σ active rows in force for the month. Seeded EMPTY (Rick settles the
/// $10,800-vs-$10,500 June/July discrepancy when he enters real rows — seeding
/// contested numbers would launder a discrepancy into "truth", ADR-0040 D3).
model ContainerRentalSite {
  id                 String    @id @default(uuid())
  site_id            String // FK → sites.id (which DR3 facility carries the cost)
  location_name      String // human label for the rental location
  source_id          String? // optional FK → sources.id (rental tied to a source)
  trailer_count      Int
  trailer_size       String? // e.g. "53ft", "40ft"; free text, sizes vary
  monthly_rate_cents Int
  active             Boolean   @default(true)
  effective_from     DateTime  @db.Date
  effective_to       DateTime? @db.Date
  note               String?
  created_by         String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  @@index([site_id, effective_from])
  @@map("container_rental_sites")
}

/// ADR-0040 D4 (Addendum B3) — weekly diesel index for the CA fuel surcharge. One
/// row per ISO week (`week_of` = the Monday of that week, UNIQUE). `source=manual`
/// wins over a later `eia_api` fetch for the same week only via an explicit, audited
/// overwrite. A missing week's price at invoice time is a typed error, never a
/// silent $0 (`fuel.ts` `MissingFuelPriceError`).
enum FuelPriceSource {
  eia_api
  manual
}

model FuelPrice {
  id          String          @id @default(uuid())
  week_of     DateTime        @unique @db.Date // Monday of the ISO week
  usd_per_gal Decimal         @db.Decimal(5, 3)
  source      FuelPriceSource
  fetched_at  DateTime // when this price was fetched/entered
  note        String?
  created_by  String?
  created_at  DateTime        @default(now())
  updated_at  DateTime        @updatedAt

  @@map("fuel_prices")
}

/// ADR-0040 amendment (2026-07-18, rollup §3.3) — per-source, effective-dated service
/// rates for the OR program billing components (trans / trailer / per-mattress / MRC
/// unit). Parallels `account_haul_rates` (the existing per-source effective-dated rate
/// pattern): ONE row per (source, rate_kind, effective window). Seeded EMPTY here — the
/// §7 seed PR loads the OR source rows AFTER this schema merges (The Dalles effective
/// 2026-06-01; the rest 2026-01-01). The resolver (`service-rates.ts`) picks the row
/// whose `effective_from <= date` and `effective_to` is null or `>= date`, and fails
/// LOUD (typed error) when none is in force — an OR billing component MUST NOT silently
/// bill $0 (ADR-0040 D7). `mrc_unit` is included so the per-site-type composer
/// (`site-type-billing.ts`) has a single per-source home for the MRC unit rate.
enum SourceServiceRateKind {
  trans
  trailer
  per_mattress
  mrc_unit
}

model SourceServiceRate {
  id             String                @id @default(uuid())
  source_id      String // FK → sources.id (constraint in migration; bare column per block header)
  rate_kind      SourceServiceRateKind
  rate_cents     Int
  effective_from DateTime              @db.Date
  effective_to   DateTime?             @db.Date
  note           String?
  created_by     String?
  created_at     DateTime              @default(now())
  updated_at     DateTime              @updatedAt

  @@index([source_id, rate_kind, effective_from])
  @@map("source_service_rates")
}

// ─────────────────────────────────────────────────────────────────────────
// ADR-0041 — events capture + sequences (CAPTURE HALF; the sibling half owns
// invoices/invoice_lines and the generation/approval/render pipeline). Every
// addition below lives in this ONE contiguous block (the `dr3_number` column on
// `inbound_loads` above is the sole exception — a scalar can't live here).
//
// FK columns (`site_id`) carry DB-level FOREIGN KEY constraints created in the
// migration rather than Prisma relations, mirroring the ADR-0040 block — so this
// block adds NO back-relation fields on the sibling-touched `Site` model.
// Money is integer CENTS; dates are @db.Date.
// ─────────────────────────────────────────────────────────────────────────

/// ADR-0041 D3 — collection_events: the daily-log Events tab (satellite/collection
/// runs the office bills as freight + labor). Wage/per-diem/misc amounts are STORED
/// AS ENTERED; the B5 rules (`driver_hourly`, `general_labor_hourly`,
/// `per_diem_nightly`) only DEFAULT the wage cents when the operator leaves them
/// blank — deviation-from-default is derivable (hours × resolved rate vs stored
/// wages), never flagged. `mileage` is informational miles; `mileage_cents` is the
/// billed mileage dollars that feeds the §3.1 B8 formula (see the operator doc).
model CollectionEvent {
  id                  String       @id @default(uuid())
  site_id             String // FK → sites.id (constraint in migration)
  event_date          DateTime     @db.Date
  customer            String
  county              String?
  slip_number         String?
  units               Int?
  freight_cents       Int? // load-level freight charge for the event (CA)
  driver_hours        Decimal?     @db.Decimal(5, 2)
  driver_wages_cents  Int?
  labor_hours         Decimal?     @db.Decimal(5, 2)
  labor_wages_cents   Int?
  mileage             Int? // miles driven — informational (workbook Events "Mileage" col)
  mileage_cents       Int? // billed mileage dollars — the value that feeds B8
  per_diem_cents      Int?
  misc_cents          Int?
  // ADR-0056 (rollup §5.3, Rick 2026-07-19) — event-billing component captures.
  // `driver_onsite_hours` = ON-SITE time only (drive time already lives in
  // `labor_hours`; driver wages bill only on-site — §5.3 item 4). `per_diem_days`
  // counts overnight days (§5.3 item 5, rare — Happy Camp); `overnight` flags the
  // rare stay. Per-leg tier pricing lives in `event_legs`; per-vehicle IRS mileage
  // in `event_vehicles`. Amounts stored-as-entered; the generator derives cents.
  driver_onsite_hours Decimal?     @db.Decimal(5, 2)
  per_diem_days       Int?
  overnight           Boolean      @default(false)
  // ADR-0056 amendment (Addendum A §A.3) — did DR3 perform the haul for this
  // event? Gates whether the event's freight folds into the invoice's
  // `event_transportation_total` (MILES 0 member). Default `true`: existing
  // rows predate the distinction and were all DR3-hauled (they carry billed
  // `freight_cents`), and unconditional summing is the CURRENT invoice
  // behaviour — defaulting true preserves it and avoids a silent revenue drop.
  // `false` is the new, explicitly-flagged exception (customer/third-party haul).
  dr3_hauled          Boolean      @default(true)
  retrac_id           String?
  notes               String?
  source              RecordSource @default(manual)
  locked_at           DateTime? // edit-before-any-lock guard (CRUD-lite)
  created_by          String?
  created_at          DateTime     @default(now())
  updated_at          DateTime     @updatedAt

  @@index([site_id, event_date])
  @@index([retrac_id])
  @@map("collection_events")
}

/// ADR-0041 D3 — Oregon satellite collection-site unit counts, hand-entered monthly
/// (the OR program bills $2.25/unit — rate stays in `state_program_rules`; NO
/// invoice math here, the sibling consumes at merge). Eugene-scoped: the service
/// rejects a non-OR site with a typed jurisdiction error. `billing_month` is the
/// first-of-month anchor.
model OrCollectionSiteCount {
  id            String       @id @default(uuid())
  site_id       String // FK → sites.id (Eugene/OR only — enforced in the service)
  billing_month DateTime     @db.Date // first-of-month anchor
  location      String
  units         Int
  source        RecordSource @default(manual)
  locked_at     DateTime? // edit-before-any-lock guard (CRUD-lite)
  created_by    String?
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt

  @@index([site_id, billing_month])
  @@map("or_collection_site_counts")
}

/// ADR-0041 D3 (Addendum B6 / B10-6) — per-(site, sequence_code) atomic document
/// counter. `issueDocumentNumber` hands out `next_value` and increments it in a
/// single `UPDATE … RETURNING`, atomic under concurrency (row lock serializes
/// concurrent issues). Woodland's `dr3_number` counter is seeded at a SAFE HIGH
/// start (> the observed June ceiling) and MUST be aligned to the real current
/// counter before go-live. Material # is MyMRC-owned and is NEVER issued here.
model DocumentSequence {
  id            String   @id @default(uuid())
  site_id       String // FK → sites.id (constraint in migration)
  sequence_code String // e.g. 'dr3_number'
  next_value    Int // the next number to hand out
  created_by    String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@unique([site_id, sequence_code])
  @@map("document_sequences")
}

// ADR-0041 — invoices
//
// The P2 invoice set: six invoice kinds/month across CA+OR (D1). An invoice is
// an immutable-once-approved, line-itemized artifact whose every number is a
// query result with provenance (mission §4 — "generated, never hand-entered";
// Rick's typo class dies at the root). Drafts regenerate freely (prior draft
// voided, version+1); an APPROVED invoice is corrected only by a NEW version in
// a `supersedes_id` chain — both rows retained (the audit trail IS the point).
//
// `total_cents` is a DERIVED value (Σ of the line `amount_cents`) stored on the
// row for query efficiency (a list surface must not N+1 the lines to show a
// total). The store is a denormalization, so the service layer enforces the
// invariant `total_cents == Σ lines.amount_cents` on EVERY write, and the
// approval path re-asserts it before freezing the row (ADR-0033 tripwire
// philosophy: a money total that silently disagrees with its lines is a defect,
// never a rounding footnote). See `src/lib/invoices/lifecycle.ts`.
//
// COORDINATION (mirrors the ADR-0040 block header): this block is self-contained
// at the end of the schema. The FK columns to sibling-owned models (`site_id`,
// and the audit-actor columns `generated_by`/`approved_by`/`voided_by`) are
// plain scalars — their referential-integrity constraints are created at the DB
// level in the migration `20260707_invoice_generation`, exactly as
// `state_program_rules.created_by` / the ADR-0040 tables do. The ONE Prisma
// relation here is internal (`invoice_lines` → `invoices`) plus the `invoices`
// self-relation for the supersede chain — both wholly owned by this ADR.
// ────────────────────────────────────────────────────────────────────────

/// ADR-0041 D1 — the six invoice kinds. There is NO `or_processing_mid_month`
/// value BY CONSTRUCTION: Oregon bills end-of-month only (BillingCadence
/// `end_of_month_only`), so a mid-month OR invoice is structurally impossible —
/// the generator can never be asked to build one.
enum InvoiceKind {
  ca_processing_mid_month
  ca_processing_eom
  ca_transportation_eom
  or_processing_eom
  or_transportation_eom
  or_collection_site_count
}

enum InvoiceStatus {
  draft
  approved
  void
}

/// ADR-0041 D1 — an immutable-versioned, line-provenance invoice. One (site,
/// kind, billing_month) may have many versions; at most one is not-void at a
/// time within a supersede chain. `window_start`/`window_end` are the billing
/// window the lines were generated over (the mid-month window is the 1st–15th
/// inclusive; EOM is the whole month). `billing_month` is the first-of-month
/// @db.Date the invoice belongs to.
model Invoice {
  id                                  String        @id @default(uuid())
  site_id                             String // FK → sites.id (constraint in migration)
  kind                                InvoiceKind
  billing_month                       DateTime      @db.Date // first-of-month @db.Date
  window_start                        DateTime      @db.Date
  window_end                          DateTime      @db.Date
  version                             Int
  // Self-relation: a new version SUPERSEDES the approved row it corrects. The
  // chain is append-only; nothing in it is ever edited or deleted.
  supersedes_id                       String?
  supersedes                          Invoice?      @relation("InvoiceSupersede", fields: [supersedes_id], references: [id])
  superseded_by                       Invoice[]     @relation("InvoiceSupersede")
  status                              InvoiceStatus @default(draft)
  // DERIVED = Σ lines.amount_cents. Stored for query efficiency; the service
  // layer asserts the invariant on every write and re-asserts at approval.
  total_cents                         Int
  generated_by                        String? // users.id (bare column — see block header)
  generated_at                        DateTime      @default(now())
  approved_by                         String?
  approved_at                         DateTime?
  voided_by                           String?
  voided_at                           DateTime?
  // Set on an approvable generation that proceeded past a BLOCKED trust gate via
  // a super-admin override (D4). Null for a clean-gate or draft-preview invoice.
  gate_override_note                  String?
  // 2026-07-09 rollup §1.3 (ADR-0041 addendum) — the GP "Trade discount" made
  // explicit. Populated ONLY on ca_processing_eom drafts: the mid-month amount
  // already invoiced (positive cents; the stored B22.offset line carries the
  // negative) + the mid-month invoice it references. Mary types the GP EOM
  // invoice as gross → Trade discount → balance due; these fields are that
  // structure as data, so the GP adapter/verify surface never re-derives it
  // from line JSON. Null on every other kind, and null when the offset was
  // recomputed with no mid-month invoice on file (reference only).
  trade_discount_cents                Int?
  trade_discount_reference_invoice_id String?
  trade_discount_reference            Invoice?      @relation("InvoiceTradeDiscountRef", fields: [trade_discount_reference_invoice_id], references: [id])
  trade_discount_referenced_by        Invoice[]     @relation("InvoiceTradeDiscountRef")
  // ADR-0041 amendment (2026-07-18, §3.4) — pilot/production launch safety net.
  // DEFAULT pilot: a pilot invoice's delivery plan can NEVER resolve to MRC
  // (`planInvoiceDelivery` in src/lib/invoices/delivery.ts is a total function on
  // `mode` with no branch that yields MRC recipients / sendsToMrc for pilot).
  // Pilot previews route to `invoice_pilot_recipients` (Bill + Rick) ONLY. Flip a
  // (site, kind) to production via `invoice_mode_config`; every pre-existing row
  // backfills to pilot in the migration, so nothing already on file can reach MRC
  // until an admin explicitly flips it.
  mode                                InvoiceMode   @default(pilot)
  // ADR-0041 amendment (§8.3) — program vs non-program split on the invoice
  // basis. `program_units_processed` is the BILLABLE basis (Σ stripped_program;
  // it EQUALS the B6/B20 processing-line quantity — MRC pays on program units
  // only). `non_program_units_processed` (Σ stripped_non_program) is tracked for
  // reconciliation but NEVER billed. Both null on non-processing kinds.
  program_units_processed             Decimal?      @db.Decimal(9, 1)
  non_program_units_processed         Decimal?      @db.Decimal(9, 1)
  notes                               String?
  created_at                          DateTime      @default(now())
  updated_at                          DateTime      @updatedAt

  lines        InvoiceLine[]
  credit_memos CreditMemo[]

  // One version number per (site, kind, month) chain — the DB backstop for the
  // service's max+1 computation (two concurrent generates now conflict at the
  // DB instead of minting duplicate versions / two live drafts).
  @@unique([site_id, kind, billing_month, version])
  @@index([site_id, kind, billing_month])
  @@index([site_id, status])
  @@index([supersedes_id])
  @@map("invoices")
}

/// ADR-0041 D1 — one priced line with full provenance. `line_code` is the
/// workbook §3.1 map code — LEAF lines only ('B6','B7','B8','B20','B22.offset','B16.freight',
/// 'B16.fuel','B16.rentals','B16.event_freight','satellite'). `rate_ref` records
/// WHICH rule/tier/override row priced it; `source` records the query window +
/// the row ids/counts that produced the number (drill-down provenance). A line
/// amount may be NEGATIVE (the B20 offset line on the CA EOM invoice).
model InvoiceLine {
  id           String   @id @default(uuid())
  invoice_id   String
  invoice      Invoice  @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  line_code    String
  description  String
  quantity     Decimal? @db.Decimal(14, 2)
  rate_ref     Json? // which rule/tier/override row priced this line
  amount_cents Int // integer cents; may be negative (offset line)
  source       Json? // query window + row ids/counts + provenance flags
  position     Int
  created_at   DateTime @default(now())

  @@index([invoice_id, position])
  @@map("invoice_lines")
}

/// 2026-07-09 rollup §1.4 (ADR-0041 addendum) — the over-billed correction path.
/// Mary's GP reality: under-billed → void-and-reissue (the existing supersede
/// chain); over-billed → a credit memo IF MRC agrees, else void-and-reissue.
/// MRC's acceptance is REQUIRED for the credit path, so a credit memo cannot be
/// applied unilaterally — hence the state machine (transitions enforced in
/// `src/lib/invoices/credit-memos.ts`, every step audited):
///   proposed → sent_to_mrc → accepted | rejected;
///   accepted → applied (Mary confirms MRC applied the credit);
///   rejected → void_and_reissue_triggered (a superseding draft is generated
///   via the ADR-0041 supersede chain; its id is recorded here).
enum CreditMemoStatus {
  proposed
  sent_to_mrc
  accepted
  rejected
  applied
  void_and_reissue_triggered
}

/// One credit memo against an APPROVED invoice. `amount_cents` is POSITIVE (the
/// credit owed back to MRC). Rows are append-only through the state machine —
/// no deletes; a wrong proposal is walked to rejected/void_and_reissue. Audit
/// actor columns are bare user-id scalars (block-header convention).
model CreditMemo {
  id                     String           @id @default(uuid())
  invoice_id             String
  invoice                Invoice          @relation(fields: [invoice_id], references: [id])
  site_id                String // FK → sites.id (constraint in migration; scoping reads)
  amount_cents           Int
  reason                 String
  status                 CreditMemoStatus @default(proposed)
  // Set when status = void_and_reissue_triggered: the superseding DRAFT that
  // replaces the over-billed invoice (ADR-0041 supersede chain).
  superseding_invoice_id String?
  created_by             String? // users.id (bare audit-actor column)
  sent_at                DateTime?
  decided_at             DateTime?
  decided_note           String?
  applied_at             DateTime?
  created_at             DateTime         @default(now())
  updated_at             DateTime         @updatedAt

  @@index([invoice_id])
  @@index([site_id, status])
  @@map("credit_memos")
}

// ADR-0042 — COR
//
// Exhibit 5: the Certificate of Recycling, Employment and Inventory. Monthly,
// per CA facility (Woodland — CA jurisdiction only; there is NO Exhibit 5 in
// Oregon and the service throws a typed error for an OR site). Currently
// hand-written and signed under penalty of perjury; the motivating defect is the
// June copy whose headcount reads "15 or 18" depending on who squints. Vision
// pre-fills every number it can prove (D2), a human reviews, and a human signs.
// Governing principle (mission, verbatim): Vision pre-fills and renders; a human
// always reviews and signs; Vision NEVER auto-certifies. The rendered PDF's
// signature block is therefore EMPTY (Rick prints, signs, submits) — D3.
//
// Same immutable-version discipline as ADR-0041 invoices (D1): a draft
// regenerates freely (prior draft voided, version+1); a FINALIZED certificate is
// immutable and is corrected only by a NEW version in a `supersedes_id` chain,
// both rows retained (the audit trail IS the point). The three pre-filled numbers
// each carry provenance JSON (`inventory_source` / `headcount_source`): the
// inventory figure is the ONE pool-aware running balance (ADR-0037 D6) cross-
// referenced to the nearest physical snapshot; the FT/PT split is the ONE human
// judgment, entered at review with the daily-close pre-fill retained.
//
// COORDINATION (mirrors the ADR-0040 / ADR-0041 block headers): this block is
// self-contained at the end of the schema. The FK columns to sibling-owned models
// (`site_id`, and the audit-actor columns `prepared_by`/`finalized_by`) are plain
// scalars — their referential-integrity constraints are created at the DB level in
// the migration `20260708_cor_certificates`, exactly as the ADR-0041 invoices
// block does. The ONE Prisma relation here is the `cor_certificates` self-relation
// for the supersede chain, wholly owned by this ADR. `signer_name`/`signer_title`
// are DENORMALIZED onto each certificate at generation from the site config
// (`cor_site_config`) so a title change never rewrites a finalized artifact.
// ────────────────────────────────────────────────────────────────────────

/// ADR-0042 D1 — draft regenerates freely; finalized is immutable (supersede
/// chain for corrections); void discards. Parallels `InvoiceStatus`.
enum CorStatus {
  draft
  finalized
  void
}

/// ADR-0042 amendment (2026-07-18) — the COR form (Exhibit 5) serves BOTH the
/// end-of-month close AND a mid-month filing. `end_of_month` is the full,
/// reconciled certificate (inventory + FT/PT required, D3 tripwire + capacity
/// banner). `mid_month` is Rick's blank-figures filing: inventory, FT, and PT are
/// left BLANK (signature + date only), so the reconcile tripwire and capacity
/// banner do NOT apply. Default `end_of_month` preserves every pre-amendment row.
enum CorPeriod {
  end_of_month
  mid_month
}

/// ADR-0042 D2.3 — site-scoped signer config for the COR. Standardized, NOT typed
/// per certificate: Rick Albritton, title seeded "Transportation Manager" (what
/// the June COR read) — flagged TBC with MRC. A confirmed title is ONE row edit,
/// never a code change and never retyped per certificate. One row per CA site.
model CorSiteConfig {
  id           String   @id @default(uuid())
  site_id      String   @unique // FK → sites.id (constraint in migration)
  signer_name  String
  signer_title String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("cor_site_config")
}

/// ADR-0042 D1 — an immutable-versioned Certificate of Recycling, Employment and
/// Inventory. One (site, cover_month) may have many versions; at most one is
/// not-void within a supersede chain. `cover_month` is the first-of-month
/// @db.Date the certificate covers. Every printed number is provable: the three
/// pre-filled figures each carry a provenance JSON (D2); the FT/PT split is the
/// single human judgment, null until entered at review and REQUIRED at finalize.
model CorCertificate {
  id            String           @id @default(uuid())
  site_id       String // FK → sites.id (constraint in migration)
  cover_month   DateTime         @db.Date // first-of-month @db.Date
  version       Int
  // Self-relation: a new version SUPERSEDES the finalized row it corrects. The
  // chain is append-only; nothing in it is ever edited or deleted.
  supersedes_id String?
  supersedes    CorCertificate?  @relation("CorSupersede", fields: [supersedes_id], references: [id])
  superseded_by CorCertificate[] @relation("CorSupersede")
  status        CorStatus        @default(draft)

  // ADR-0042 amendment (2026-07-18) — end-of-month vs mid-month filing. The chain
  // (site, cover_month) is scoped BY period: a mid-month and an end-of-month
  // certificate for the same month are independent version chains and never void
  // one another. Default `end_of_month` preserves every existing row and caller.
  period CorPeriod @default(end_of_month)

  // D2.1 — unprocessed inventory at month close = the pool-aware running balance
  // (ADR-0037 D6) as of the month's last day, cross-referenced to the nearest
  // physical snapshot. `inventory_source` records the anchor snapshot id, the
  // computed figure, and any reconcile delta in between (drill-down provenance).
  // NULLABLE (amendment): a `mid_month` certificate files inventory BLANK — the
  // figure genuinely does not exist yet, so no placeholder zero is ever stored.
  // `inventory_source` still carries a typed marker so provenance stays honest.
  inventory_units  Int?
  inventory_source Json

  // D2.2 — FT/PT headcount. The daily close captures TOTALS, not an FT/PT split;
  // the preparer enters the split at review (they know the roster). Null until
  // entered; BOTH are REQUIRED at finalize. `headcount_source` retains the daily-
  // close pre-fill (month-end counts + the month's consulted close-row ids + method).
  ft_headcount     Int?
  pt_headcount     Int?
  headcount_source Json

  // D2.3 — signer block, denormalized from `cor_site_config` at generation.
  signer_name  String
  signer_title String

  prepared_by  String? // users.id (bare column — see block header)
  prepared_at  DateTime  @default(now())
  finalized_by String?
  finalized_at DateTime?

  // D3 — rendered artifact key in R2 (`cor/…`). Null until rendered.
  pdf_storage_key String?
  notes           String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([site_id, cover_month])
  @@index([site_id, status])
  @@index([supersedes_id])
  @@map("cor_certificates")
}

// ADR-0044 — equipment
//
// P4: the Terex equipment module. ONE additive capture table (`equipment_events`)
// plus two derived read surfaces (a trend page + a dashboard tile). Throughput is
// NOT captured here — it is DERIVED from `processed_units_daily` (ADR-0037 D5),
// the one number the office already closes daily (D2, one source of truth). This
// block adds only the downtime/cost/maintenance/note log.
//
// COORDINATION (mirrors the ADR-0040/0041/0042 block headers): this block is
// self-contained at the end of the schema. The `site_id` FK and the audit-actor
// columns (`created_by`/`voided_by`) are plain scalars — their referential-
// integrity constraint (site_id) is created at the DB level in the migration
// `20260710_equipment_events`, exactly as the ADR-0042 COR block does, so no
// back-relation field is added to the shared `Site` model.
//
// `equipment_code` is a plain string (seeded UI filter 'terex'), NOT an enum — a
// second machine is a data value, never a migration (D1). There is NO `locked_at`:
// events are freely editable; the complete history lives in `audit_log` (an audit
// row on every write). Hard delete is forbidden (CLAUDE.md hard rule #6 audit
// discipline) — removal is a soft-void (`voided_at`), itself audited.
// ────────────────────────────────────────────────────────────────────────

/// ADR-0044 D1 — equipment event kinds. `hours_down` is only meaningful for the
/// operational-interruption kinds (downtime/maintenance/repair); `cost` and `note`
/// never carry it (service-enforced). `cost` is the pure spend-context kind
/// (`cost_cents`); any kind MAY additionally carry a cost (e.g. a repair with a
/// vendor invoice). Terex-first but not Terex-hardcoded (see `equipment_code`).
enum EquipmentEventKind {
  downtime
  maintenance
  repair
  cost
  note
}

/// ADR-0044 D1 — the Terex-first equipment log: downtime, maintenance, repair,
/// cost, and free notes. Site-scoped (CLAUDE.md hard rule #2), manager-entered,
/// every write audited. Freely editable (no lock); removal is a soft-void
/// (`voided_at` set, row retained) — never a hard delete. Throughput is derived
/// elsewhere and never captured here (D2).
model EquipmentEvent {
  id             String             @id @default(uuid())
  site_id        String // FK → sites.id (constraint in migration)
  equipment_code String             @default("terex")
  event_date     DateTime           @db.Date
  kind           EquipmentEventKind

  // hours_down: operational-interruption kinds only (service-enforced). Decimal(5,2)
  // → up to 999.99 hours, quarter/tenth-hour precision.
  hours_down Decimal? @db.Decimal(5, 2)
  // cost_cents: integer cents, >= 0 (service-enforced). Operational spend context
  // (D4 — NOT depreciation/asset accounting; GP remains the ledger of record).
  cost_cents Int?
  vendor     String?
  notes      String?

  source     RecordSource @default(manual)
  import_id  String? // ADR-0048 — equipment_history_imports.id when promoted from a Terex upload
  created_by String? // users.id (bare column — see block header)

  // Soft-void (no hard delete). A voided row is excluded from every derived series
  // and the tile, but retained for the audit trail.
  voided_at DateTime?
  voided_by String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([site_id, event_date])
  @@index([site_id, equipment_code, event_date])
  @@index([site_id, kind])
  @@map("equipment_events")
}

/// ADR-0079 D1 — the manager's DAILY Terex capture: units processed + run hours.
///
/// ADR-0044 D2 derived throughput as `stripped_program + stripped_non_program` and
/// called it the Terex's. That number is the WHOLE FLOOR's output — it cannot tell
/// the machine from hand-stripping — and production makes the scale of the lie
/// plain: Woodland's derived "Terex" day runs 1,000–1,250 units. The sheet this
/// product replaces carried an authoritative manager-entered Terex number, daily,
/// and Vision has to carry it too. Entered REPLACES derived (D3).
///
/// A DEDICATED TABLE, not a sixth `equipment_events` kind (D2). Three reasons, each
/// verified against the live code rather than assumed:
///
///  1. `equipment_events` is many-rows-per-day BY DESIGN (several downtime/repair/
///     cost rows share a date), so "one entry per machine per day" cannot be a
///     table-level unique there — only a partial index carving out one kind.
///  2. Three read paths query `equipment_events` with NO kind filter and would
///     silently absorb a daily row: `tile.ts` `findFirst` (the daily row, written
///     every working day, would permanently become "the LAST equipment event" and
///     bury the downtime the tile exists to surface), `service.ts`
///     `listEquipmentEvents` (~250 rows/yr flooding the maintenance log), and
///     `terex-ledger.ts` (selects `hours_down` with no kind filter and sums it into
///     `downtime.totalHours`). That last one is the sharp edge: carrying RUN hours
///     in `hours_down` would report the hours the machine RAN as the hours it was
///     DOWN — ADR-0077's defect class inverted, and worse, because it manufactures
///     a measurement instead of merely mis-rendering a missing one.
///  3. `equipment_events` has NO equipment FK at all — `equipment_code` is a free
///     string (ADR-0044 D1, "a second machine is a data value"). The handoff
///     requires uniqueness per EQUIPMENT ROW, which a string code cannot express
///     and which the ADR-0075 merge machinery (`merged_into_id`) depends on.
///
/// `run_hours` and `hours_down` are deliberately in DIFFERENT TABLES so no query can
/// ever confuse the two. They are near-opposites and one of them has already been
/// mis-rendered once (ADR-0077 D4).
model EquipmentDailyThroughput {
  id String @id @default(uuid())

  /// Bare FK → sites.id (constraint in the migration), matching every sibling.
  site_id      String
  /// A REAL relation to the equipment registry — this is what makes "unique per
  /// machine per day" mean the machine and not a typed-in string, and what keeps a
  /// merged-away row (ADR-0075) from quietly collecting its own parallel history.
  /// `onDelete: Restrict` matches every other equipment reference: nothing in this
  /// registry is ever hard-deleted.
  equipment_id String
  equipment    Equipment @relation(fields: [equipment_id], references: [id], onDelete: Restrict)

  /// The PRODUCTION day, Pacific (`appTodayISO`), stored as a pure `@db.Date`.
  throughput_date DateTime @db.Date

  /// Units the MACHINE processed. `0` is a legitimate recorded value (the machine
  /// ran and produced nothing); "nobody entered a number" is the ABSENCE of a row.
  /// The two are never the same thing — ADR-0077 D4, restated for units.
  units_processed Int

  /// Hours the machine actually RAN. The whole reason to capture rather than
  /// derive: units-per-hour was computed against an ASSUMED 8-hour day
  /// (`ASSUMED_DAY_HOURS`), a guess standing in for a measurement. Decimal(5,2)
  /// mirrors `equipment_events.hours_down`. Service-enforced `> 0` and `<= 24` —
  /// a machine cannot run more than 24 hours in a calendar day.
  run_hours Decimal @db.Decimal(5, 2)

  /// ADR-0107 — the two cumulative hour-METER readings `run_hours` is the
  /// difference between. NOT clock times: the sheet's `Jul26` tab runs
  /// 2,462.75 → 2,608.05 and `Aug26` continues 2,685 → 2,804.8, each day's
  /// Start carried from the prior day's End by formula.
  ///
  /// NULLABLE, and never backfilled. Every pre-ADR-0107 row keeps its
  /// `run_hours` with both of these NULL, because a difference does not
  /// determine the pair it came from and inventing one would put two
  /// fabricated meter readings into the table whose whole purpose is that the
  /// number is authoritative. REQUIREDNESS FOR MANAGER ENTRY IS ENFORCED IN THE
  /// SERVICE — the columns stay nullable so the ADR-0081 workbook importer can
  /// still project sheet rows whose meter cells are legitimately blank.
  ///
  /// `Decimal(8,2)`, wider than `run_hours`: a meter is cumulative and only
  /// climbs (~2,805 h today, ~1,400 h/yr), so a (6,2) ceiling would be reached
  /// inside the asset's service life.
  ///
  /// Four DB CHECKs back these up — the pair is all-or-nothing, `end > start`,
  /// `start >= 0`, and `run_hours = end - start` whenever both are present.
  start_hours Decimal? @db.Decimal(8, 2)
  end_hours   Decimal? @db.Decimal(8, 2)

  notes String?

  /// ADR-0036 / ADR-0077 actor discipline. A human entry carries the REAL
  /// `users.id` in `created_by` and leaves `actor_label` NULL; a write with no
  /// signed-in human (a script under written instruction) sets `actor_label` and
  /// leaves `created_by` NULL rather than borrowing a person's id and writing a
  /// false claim into an append-only trail.
  created_by  String?
  actor_label String?

  /// Soft-void (hard rule #6 — no hard delete). A voided row is excluded from every
  /// series and from the unique index, so a day can be re-entered after a mistaken
  /// entry is reversed.
  voided_at DateTime?
  voided_by String?

  /// ADR-0081 — WHERE this day came from. `'manager'` | `'workbook_import'`.
  ///
  /// The two are drawn differently on the page (solid vs striped) and are
  /// adjudicated differently in the database: the import's `ON CONFLICT ... DO
  /// UPDATE` carries `WHERE source = 'workbook_import'`, so a manager's row is
  /// never overwritten by the sheet, while a manager entry overwrites an
  /// imported one through the ordinary write path. That asymmetry IS Bill's
  /// "starting today JT takes over".
  ///
  /// Constrained to the two spellings by a DB CHECK — a typo'd third value would
  /// be silently unprotected by the JT-wins guard and silently undrawn by the UI.
  source String @default("manager")

  /// ADR-0081 — `doc_source_versions.id` for an imported row; NULL for a
  /// manager's. Deliberately carries NO foreign key: `doc_source_versions`
  /// cascade-deletes from `doc_sources`, so a real FK would make removing a
  /// document either impossible or destructive to production throughput. A DB
  /// CHECK pairs it with `source` so an imported row can never lose its
  /// provenance and become invisible to version-scoped supersession.
  import_version_id String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  /// The uniqueness guarantee lives in the MIGRATION as a PARTIAL unique index
  /// (`WHERE voided_at IS NULL`), which Prisma's schema language cannot express.
  /// It is declared here as a plain index so the client still has the lookup path;
  /// the constraint itself is DDL. Note the key columns `equipment_id` and
  /// `throughput_date` are both NOT NULL — only the PREDICATE reads a nullable
  /// column, so this genuinely constrains (a unique index whose KEY is nullable
  /// constrains nothing, which is a trap this repo has been bitten by elsewhere).
  @@index([equipment_id, throughput_date])
  @@index([site_id, throughput_date])
  @@map("equipment_daily_throughput")
}

/// ADR-0088 — the idempotency ledger for the throughput-gap watchdog.
///
/// The Terex sheet went unfilled for nine working days and no instrument said
/// so. The absence of a row in `equipment_daily_throughput` was ALREADY the
/// honest answer ("not recorded", ADR-0079/ADR-0077 D4) — what was missing is
/// anything that READS that absence and speaks. This table is what stops the
/// watchdog from speaking twice about the same silence.
///
/// The key is the MISSED DAY, not the run day. One row per (site, gap_date)
/// means a given working day is nudged about exactly once, ever — which is
/// strictly stronger than the ADR-0037 ≥24h cooldown the policy asks for, and
/// it survives a container restart, a manual re-fire, and a duplicated cron
/// container in a way an in-process cooldown cannot. Modelled on
/// `alert_digest_logs` (ADR-0043 D5), which solves the same problem the same way.
///
/// A row is written only after a real send DECISION (see `runThroughputGapScan`):
/// an M365-disabled no-op and an empty recipient set write nothing, so the nudge
/// is still owed once the config gap is closed.
model EquipmentThroughputGapAlert {
  id String @id @default(uuid())

  /// Bare FK → sites.id (constraint in the migration), matching every sibling.
  site_id String

  /// The WORKING DAY that had no live throughput row — the thing being reported.
  /// `@db.Date`, same Pacific calendar-day representation as
  /// `equipment_daily_throughput.throughput_date`, so the two are directly
  /// comparable without a zone shift.
  gap_date DateTime @db.Date

  /// The machine the gap was about, resolved from the registry at scan time
  /// (`resolveSiteThroughputMachine`) — never a literal id. Recorded so a future
  /// reader can tell WHICH machine's silence was reported at a site that one day
  /// has two.
  equipment_id String

  /// The Pacific day the scan actually ran. Normally `gap_date` + 1 working day;
  /// it differs after an outage, and the difference is the only evidence that the
  /// watchdog itself was late.
  scanned_on DateTime @db.Date

  /// `live` | `pilot` — the ADR-0047 state the nudge resolved to. In pilot the
  /// mail went to admins with the would-have-sent header, NOT to the roster, and
  /// this column is how that is answerable later without re-deriving it.
  notify_mode String

  recipient_count Int
  delivered_count Int
  last_status     Int?

  created_at DateTime @default(now())

  /// One nudge per site per missed day. The uniqueness is on two NOT NULL
  /// columns, so it genuinely constrains.
  @@unique([site_id, gap_date])
  @@index([site_id, gap_date])
  @@map("equipment_throughput_gap_alerts")
}

/// ADR-0092 — one row per load this watchdog has reported, ever.
///
/// The idempotency key is the LOAD, not the run day, and that choice is the
/// whole guarantee: a given stranded load is reported exactly once no matter how
/// many times the cron fires, whether a second cron container exists, or what
/// restarted in between. An in-process cooldown could not deliver that — it
/// lives in the app container's memory and is keyed on wall time rather than on
/// the fact being reported (the ADR-0088 D6 argument, restated because it is the
/// reason this table exists at all rather than a `setTimeout`).
///
/// The deliberate consequence: a load reported, then worked, then abandoned
/// AGAIN is not reported a second time. That is accepted rather than overlooked
/// — the in-app badge is continuous and always current, so the second strand is
/// visible even though it is not mailed, and the alternative (re-nudging on a
/// load somebody already knows about) is the nagging that gets a sender filtered.
model StaleClaimAlert {
  id String @id @default(uuid())

  /// Bare FK -> inbound_loads.id (constraint in the migration), matching the
  /// newer sibling convention. ONE row per load, ever.
  load_id String

  /// Bare FK -> sites.id. Denormalised so a per-site report never has to join
  /// back through the load, which may since have been voided.
  site_id String

  /// The holder's NAME as it stood when the nudge went out, not a user FK.
  /// A takeover (ADR-0082) moves the claim, and this column is a record of what
  /// the mail said — re-deriving it later through the FK would silently rewrite
  /// history to name whoever holds the load now.
  holder_name String?

  /// The dock stage the load was stuck at. Text, not the enum: this is a
  /// historical record of a message that was sent, and it must not become
  /// unreadable if a future migration renames a `LoadStatus` member.
  load_status String

  /// How long the load had been silent when it was reported. Minutes, because
  /// the threshold is hours and storing millis would invite false precision.
  idle_minutes Int

  /// `live` | `pilot` — the ADR-0047 state the nudge resolved to.
  notify_mode String

  recipient_count Int
  delivered_count Int
  last_status     Int?

  created_at DateTime @default(now())

  /// One nudge per load, ever. Single NOT NULL column, so it genuinely constrains.
  @@unique([load_id])
  @@index([site_id, created_at])
  @@map("stale_claim_alerts")
}

// ADR-0045 — ops ledger + intake
//
// P5: the weekly meeting-notes / task-follow-up ledger (D1), the DR3 Updates +
// board-pack digest generator (D2 — Vision DRAFTS, a human SENDS; there is no
// mail path in the digest module), and the website contact-form intake + routing
// (D3). Five small, additive tables.
//
// COORDINATION (mirrors the ADR-0040/0041/0042 block headers, and shares the
// schema tail with the parallel ADR-0044 equipment build): this whole block is
// self-contained at the end of the schema. FK columns to SIBLING-owned models
// (`site_id`, and the audit-actor columns `author_user_id` / `assignee_user_id` /
// `created_by` / `completed_by` / `generated_by` / `finalized_by`) are declared
// as plain scalars — their referential-integrity constraints are created at the
// DB level in the migration `20260711_ops_ledger_intake`, exactly as
// `alert_recipients` / `cor_certificates` do it. The Prisma relations declared
// here (`ops_tasks.note` → `ops_notes`, `contact_intakes.task` → `ops_tasks`) are
// WHOLLY within this block, so they add no back-relation field to any shared
// model. Reach rules (hard rule #2): a row with `site_id` set is site-scoped; a
// `site_id = NULL` row is org-wide (Bill/Morena cross-site follow-ups), visible
// only to admin or an all_sites manager. Enforced in `src/lib/ops/reach.ts`.
// ────────────────────────────────────────────────────────────────────────

/// ADR-0045 D1 — task lifecycle. `open` on creation; `done` records
/// completed_at/completed_by; `dropped` closes without completion. Transitions
/// are audited (`writeAudit` on `ops_tasks`).
enum OpsTaskStatus {
  open
  done
  dropped
}

/// ADR-0045 D1 — task provenance. `manual` (typed in the queue), `meeting` (born
/// from a note's action-items, same transaction), `contact_form` (born from a D3
/// intake).
enum OpsTaskSource {
  manual
  meeting
  contact_form
}

/// ADR-0045 D2 — digest lifecycle. A `draft` regenerates freely (idempotent per
/// (kind, period_start)); `finalized` records finalized_by/finalized_at and is the
/// copy-ready artifact Morena/Bethany sends by hand. Vision NEVER sends it.
enum UpdateDigestStatus {
  draft
  finalized
}

/// ADR-0045 D2 — which generator produced the digest. `weekly` = the DR3 Updates
/// digest (Monday tick). `board_pack` = Bethany's board cadence (2nd Wednesday +
/// the preceding Monday). Not in the ADR's illustrative DDL; added so both live
/// in one table with per-kind, per-period idempotency (post-acceptance note).
enum UpdateDigestKind {
  weekly
  board_pack
}

/// ADR-0045 D1 — a meeting/ops note. `site_id = NULL` is an org-wide note. A note
/// can spawn N tasks in one motion (meeting → action items), linked via
/// `ops_tasks.note_id`.
model OpsNote {
  id             String   @id @default(uuid())
  site_id        String? // null = org-wide; FK constraint in the migration
  note_date      DateTime @db.Date
  title          String?
  body           String
  author_user_id String? // bare audit-actor column (see block header)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  tasks OpsTask[]

  @@index([site_id, note_date])
  @@map("ops_notes")
}

/// ADR-0045 D1 — a task/follow-up. Reminders are in-app + digest, NEVER push
/// (hard rule #5): overdue/due-today tasks surface on the dashboard tile and ride
/// the ADR-0043 daily digest as a second section.
model OpsTask {
  id               String        @id @default(uuid())
  site_id          String? // null = org-wide; FK constraint in the migration
  title            String
  body             String?
  assignee_user_id String? // bare column
  due_date         DateTime?     @db.Date
  status           OpsTaskStatus @default(open)
  source           OpsTaskSource @default(manual)
  note_id          String?
  note             OpsNote?      @relation(fields: [note_id], references: [id])
  created_by       String? // bare column
  completed_at     DateTime?
  completed_by     String? // bare column
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  contact_intake ContactIntake? // back-relation for contact_intakes.task_id

  @@index([site_id, status, due_date])
  @@index([note_id])
  @@map("ops_tasks")
}

/// ADR-0045 D2 — a generated digest DRAFT (weekly Updates or board pack). The
/// review surface edits `body_md`; finalize renders copy-ready HTML + a copy
/// button. There is deliberately NO send column and NO mail call anywhere in the
/// digest module (the locked disposition: a human owns the send).
model UpdateDigest {
  id           String             @id @default(uuid())
  kind         UpdateDigestKind   @default(weekly)
  period_start DateTime           @db.Date
  period_end   DateTime           @db.Date
  body_md      String
  status       UpdateDigestStatus @default(draft)
  generated_by String? // bare column ('system:update-digest' for the tick)
  finalized_by String? // bare column
  finalized_at DateTime?
  created_at   DateTime           @default(now())
  updated_at   DateTime           @updatedAt

  @@unique([kind, period_start])
  @@index([status, period_start])
  @@map("update_digests")
}

/// ADR-0045 D3 — a received website contact-form submission. `name`/`email`/
/// `phone` are visitor PII: excluded from every export surface, retained per a
/// documented window (default 2 years), and NEVER logged (row ids in logs only).
model ContactIntake {
  id              String   @id @default(uuid())
  received_at     DateTime @default(now())
  topic           String
  name            String?
  email           String?
  phone           String?
  message         String
  routed_to_email String
  route_id        String? // the contact_routes row that matched (logged, not the address)
  task_id         String?  @unique
  task            OpsTask? @relation(fields: [task_id], references: [id])
  source_form     String
  created_at      DateTime @default(now())

  @@index([received_at])
  @@map("contact_intakes")
}

/// ADR-0045 D3 — a topic→email routing rule. `topic_match` supports an exact
/// match or a `*`-suffix glob (`tour*`) or the catch-all `*`; first ACTIVE match
/// by ascending `priority` wins. Seeded (migration): `tour*` → Rick, `*` → Morena.
model ContactRoute {
  id             String   @id @default(uuid())
  topic_match    String   @unique
  route_to_email String
  active         Boolean  @default(true)
  priority       Int      @default(100) // lower matches earlier; catch-all is highest
  created_by     String? // bare column
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@index([active])
  @@map("contact_routes")
}

// ════════════════════════════════════════════════════════════════════════
// ADR-0046 — Vendor-invoice approval via Graph mailbox ingestion.
//
// Accounting mails an approval request to approvals-dr3@svdp.us; Vision polls
// the mailbox by Graph delta (or a mock transport until IT delivers creds),
// turns each valid message into an ap_request, Morena/Janette (as data: org
// reach approvers) decide inside Vision (first-action-wins, atomic), and Vision
// mails the decision to a FIXED configured recipient list for Mary's Great
// Plains filing. These records are ORG-level AP — deliberately NOT site-scoped
// (no site_id / Site relation): they belong to accounting, not a facility.
// PII discipline (ADR-0045): attachments + bodies stay in R2 / this DB; logs and
// notifications carry row ids + sender DOMAIN only, never amounts/vendor/bank.
// ════════════════════════════════════════════════════════════════════════

enum ApRequestStatus {
  pending
  // AP go-live features — 2026-07-09 (ADR-0046 Amendment 3): an approver may place
  // a pending request on HOLD ("pending review") with a required hold note, so
  // accounting can see it is actively being held before a final decision. From
  // pending_review any approver may still approve/reject (first-action-wins).
  pending_review
  // ADR-0046 Amendment 5 (D-M5-3) — dual-approval hop. An Approve whose
  // confirmed_amount_cents >= 100000 ($1,000) does NOT terminate at `approved`;
  // it moves to `pending_second_approval` with the first approver's four required
  // fields (vendor_freeform / explanation / confirmed_amount_cents /
  // equipment link) + first_approver_id/first_approved_at stamped, awaiting the
  // site-appropriate second approver (Woodland→Bill, Eugene→Shannon). Sub-$1K
  // Approves and every Reject/Hold/NOT-DR3 disposition are unchanged
  // (single-action, first-action-wins). Placed BEFORE `approved` so the Postgres
  // enum value order (migration uses `ADD VALUE ... BEFORE 'approved'`) matches
  // this declaration — keeps `prisma migrate diff` clean.
  pending_second_approval
  approved
  rejected
  quarantined
}

/// ADR-0046 Amendment 5 (D-M5-4) — variance-flag lifecycle on an Approve. Set on
/// the `ap_requests` row at decide time. `not_applicable`: the disposition isn't a
/// site Approve, or the vendor has no ESTABLISHED baseline (invoice_count < 3).
/// `below_threshold`: baseline exists and confirmed_amount is within the flat +
/// percent bounds — Approve flows normally. `above_threshold`: baseline exists and
/// confirmed_amount trips a threshold — the RED variance banner shows and Approve
/// is BLOCKED until acknowledged. `acknowledged`: the approver clicked "I've
/// verified the variance" (stamps variance_acknowledged_by/at + optional note),
/// unblocking Approve. Default `not_applicable` so every pre-existing row backfills
/// harmlessly.
enum ApVarianceFlagState {
  not_applicable
  below_threshold
  above_threshold
  acknowledged
}

/// ADR-0046 Amendment 5 (D-M5-4) — provenance of an `ap_vendor_baseline_history`
/// row. `bill_upload`: extracted from a Bill-uploaded AP report PDF (GP history
/// dump) via the `/admin/ap/baselines/import` surface. `vision_approval`: written
/// automatically on every Vision `approved` state transition (post-Amendment 5) so
/// baselines stay fresh between Bill's periodic re-uploads.
enum ApBaselineHistorySource {
  bill_upload
  vision_approval
}

/// ADR-0046 Amendment 5 (D-M5-6) — the equipment/asset category on the
/// consolidated `equipment` master. Drives the site-filtered multi-select on the
/// Approve panel. No inline creation from the approver panel (D-M5-6) — the master
/// is admin-managed; the approver only REFERENCES rows via `ap_equipment_links`.
enum EquipmentCategory {
  vehicle
  forklift
  baler
  terex
  other
}

/// ADR-0046 Amendment 9 (§2.3) — lifecycle of an escape-hatch equipment request.
/// `open`: filed by an approver, waiting on a site manager. `resolved`: a real
/// `equipment` row now exists (`resolved_equipment_id`) and the request is closed.
/// `rejected`: a site manager determined it was genuinely not equipment; a
/// `resolution_note` is REQUIRED. NEITHER terminal state ever alters the invoice's
/// approved decision — this lifecycle is bookkeeping cleanup, never a reversal.
enum ApEquipmentRequestStatus {
  open
  resolved
  rejected
}

/// The Graph attachment taxonomy (C10.3). `file` = a downloaded fileAttachment (or
/// an unwrapped one-level itemAttachment file) stored in R2; `nested_message` = an
/// itemAttachment forwarded message (subject/marker recorded; deeper nesting kept
/// as-is with a visible marker); `reference_link` = a referenceAttachment
/// (OneDrive/SharePoint), recorded for the approver but NEVER fetched by Vision.
enum ApAttachmentKind {
  file
  nested_message
  reference_link
}

/// Terminal status of one poll run — mirrors `MymrcSyncStatus` (ADR-0038 shape,
/// C6). A green run that read nothing while mail exists is impossible by
/// construction (delta contract + ledger counts).
enum ApPollRunStatus {
  ok
  auth_failed
  error
}

/// C9-D2 sender-validation mode. `tenant_wide` (default): any authenticated
/// internal `@svdp.us` sender creates an approvable request. `explicit_list`:
/// only `ap_sender_entries` addresses do — tightening is an admin toggle, never a
/// code change.
enum ApSenderMode {
  tenant_wide
  explicit_list
}

/// Which transport produced a poll run — self-reported at startup + in every
/// ledger row (D1). `mock` is the fixture-driven default until Graph creds land.
enum ApTransportMode {
  mock
  graph
}

/// C4/C10 — one ingested approval request. Exactly one terminal state per polled
/// message. `internet_message_id` UNIQUE is the true idempotency guard (a re-poll
/// or a DB/move race can never double-ingest). Raw email HTML is NEVER stored:
/// `body_html_sanitized` holds the allowlist-sanitized HTML (rendered in a
/// sandboxed container), `body_text` the text/plain part.
model ApRequest {
  id                         String          @id @default(uuid())
  status                     ApRequestStatus @default(pending)
  internet_message_id        String          @unique
  conversation_id            String?
  received_at                DateTime
  sender_address             String
  sender_validated           Boolean
  subject                    String?
  body_html_sanitized        String? // allowlist-sanitized at ingest; raw HTML never stored
  body_text                  String?
  vendor                     String? // optional, keyed at decision (C9-D5)
  amount_cents               Int? // optional, keyed at decision (C9-D5)
  decided_by                 String? // bare audit-actor column (user id)
  decided_at                 DateTime?
  decision_note              String?
  decision_mail_sent_at      DateTime?
  quarantine_reason          String? // set iff status=quarantined (external sender / parse failure)
  // AP go-live features — 2026-07-09 (ADR-0046 Amendment 3) — hold / "pending review".
  // Set when an approver places the request on hold (status=pending_review). held_by
  // is a bare audit-actor column (user id), matching decided_by. hold_note is REQUIRED
  // at hold time (a hold must say why it is being held). Cleared conceptually once a
  // terminal decision is made (they remain as the historical hold record).
  held_by                    String?
  held_at                    DateTime?
  hold_note                  String?
  // ADR-0046 §3 amendment (handoff §1.6c) — OPTIONAL site tag set at approve/reject
  // time via a dropdown (Eugene/Woodland/blank). Intake stays untagged (incoming
  // email doesn't inherently know the site). Bare FK column; constraint in migration.
  // Post-go-live (2026-07-15) the site tag became REQUIRED for a DR3-site decision;
  // now (2026-07-20 amendment) a decision is EITHER a real site OR filed_not_dr3.
  site_id                    String?
  // ADR-0046 amendment (2026-07-20, operator-directed) — the third location
  // disposition: "NOT DR3 — See Reason". True when the approver marks the invoice
  // as NOT for a DR3 location at all (mis-addressed, wrong entity, a parent-org
  // bill, etc.); a reason (decision_note) is REQUIRED and site_id stays NULL so it
  // is never filed against a real site's books. INVARIANT (app-enforced in
  // decideRequest; the migration adds a partial CHECK for the "never both" half):
  // a decided row is EITHER site-filed (site_id NOT NULL, filed_not_dr3 = false)
  // OR NOT-DR3 (filed_not_dr3 = true, site_id NULL) — never both. Default false so
  // every pre-existing row backfills as a normal site-filed decision.
  filed_not_dr3              Boolean         @default(false)
  // ADR-0046 §3 amendment (handoff §1.6e) — sha256 of the stamped decision PDF
  // attached to the decision mail (tamper record; visible-stamp only, no crypto).
  decision_pdf_sha256        String?
  // ADR-0046 Amendment 4 — stamped-decision artifacts. decision_pdf_r2_key: the
  // R2 key of the archived stamped decision PDF (private `ap/` prefix).
  // original_attachment_sha256: sha256 of the ORIGINAL attachment bytes — the
  // second half of the dual-sha tamper record (decision_pdf_sha256 is the first).
  decision_pdf_r2_key        String?
  original_attachment_sha256 String?

  // ─── ADR-0046 Amendment 5 (2026-07-22) — structured decide + auto-extraction +
  // dual approval + variance detection + Phase-2 haul hook. All ADDITIVE; the
  // deprecated `vendor`/`amount_cents` columns above are KEPT (hard rule #1) and
  // simply stop being written at decide — the migration backfills their existing
  // values into `vendor_freeform` / `confirmed_amount_cents`.

  // D-M5-1 — structured Approve input. `vendor_freeform` replaces the optional
  // `vendor`; `explanation` replaces the freeform decide `note` on the APPROVE
  // path only (Reject/Hold/NOT-DR3 keep `decision_note`/`hold_note`);
  // `confirmed_amount_cents` is the approver-confirmed amount (pre-filled from
  // extraction, always approver-confirmed — never auto-applied, hard rule #5).
  vendor_freeform        String?
  explanation            String?
  confirmed_amount_cents Int?

  // D-M5-2 — auto-extraction result computed at intake (hybrid local pdf-parse +
  // Claude API fallback). See src/lib/ap/extraction/types.ts (ExtractionResult):
  // { best_amount_cents, best_vendor, confidence, source, candidates,
  // attempted_at, model?, cost_cents?, error? }. Pre-fills the decide panel; the
  // approver still confirms every field.
  extraction Json?

  // D-M5-7 — Phase-2 schema hook ONLY. Ships as an empty text[] (@default([]));
  // NO code populates it in Phase 1. Wire-up (MyMRC haul cross-check against
  // mymrc_hauls_mirror) is gated on ADR-0057 Phase 1 completion (hard rule #2).
  extracted_haul_numbers String[] @default([])

  // D-M5-3 — dual-approval stamps. On an Approve >= $1,000 the first approver's id
  // + time land here and status → pending_second_approval; the site-appropriate
  // second approver's id + time (and, on an override reject, second_approver_note)
  // land on the terminal decision. Sub-$1K approves leave these null. Bare
  // audit-actor columns (no FK — matches decided_by/held_by).
  first_approver_id    String?
  first_approved_at    DateTime?
  second_approver_id   String?
  second_approved_at   DateTime?
  second_approver_note String?

  // D-M5-4 — variance detection state + acknowledgment audit. Default
  // not_applicable; acknowledgment columns populate only when the RED banner was
  // acknowledged.
  variance_flag_state          ApVarianceFlagState @default(not_applicable)
  variance_acknowledged_by     String?
  variance_acknowledged_at     DateTime?
  variance_acknowledgment_note String?

  // ADR-0066 §1.5 — 24h WEEKDAY-clock fallback to the fallback approver (default
  // Bill). Escalation is ADDITIVE, never a transfer: the routed peer stays able to
  // sign and whoever acts first completes it. Set once by the hourly scanner, which
  // is idempotent on `escalated_at IS NULL`.
  escalated_at DateTime?
  escalated_to String? // bare FK → users.id (constraint in migration)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  attachments        ApAttachment[]
  followups          ApFollowup[]
  // D-M5-6 — equipment/vehicle links selected at Approve time (distinct row per
  // equipment; a single is_not_equipment_related row for the explicit-none case).
  equipment_links    ApEquipmentLink[]
  // Amendment 9 (§2.3) — escape-hatch requests filed from this decision (at most
  // one in practice: the hatch is a single free-text choice per decision).
  equipment_requests ApEquipmentRequest[]

  @@index([status, received_at])
  @@index([conversation_id])
  // D-M5-4/5 — history search + baseline lookup by vendor + approver.
  @@index([vendor_freeform])
  @@index([first_approver_id])
  @@index([second_approver_id])
  @@map("ap_requests")
}

/// C10.3 — one attachment on a request. Bank details may live in `file` blobs →
/// R2 only (`storage_key`), never inline in a log/notification.
model ApAttachment {
  id             String           @id @default(uuid())
  request_id     String
  request        ApRequest        @relation(fields: [request_id], references: [id], onDelete: Cascade)
  kind           ApAttachmentKind
  filename       String?
  storage_key    String? // R2 key (kind=file); private `ap/` prefix
  content_type   String?
  link_url       String? // kind=reference_link (recorded, never fetched)
  nested_subject String? // kind=nested_message
  byte_size      Int?
  created_at     DateTime         @default(now())

  @@index([request_id])
  @@map("ap_attachments")
}

/// C4 — a same-conversation follow-up email that arrived while a request is open.
/// Attached as a note; never a second request. `internet_message_id` UNIQUE so a
/// re-poll never double-attaches.
model ApFollowup {
  id                  String    @id @default(uuid())
  request_id          String
  request             ApRequest @relation(fields: [request_id], references: [id], onDelete: Cascade)
  internet_message_id String    @unique
  received_at         DateTime
  sender_address      String
  body_text           String?
  created_at          DateTime  @default(now())

  @@index([request_id])
  @@map("ap_followups")
}

/// C9-D2 — sender-validation mode config (singleton; fixed pk enforces one row).
/// Default `tenant_wide`. Explicit entries live in `ap_sender_entries`.
model ApSenderConfig {
  id         String       @id @default("singleton")
  mode       ApSenderMode @default(tenant_wide)
  updated_by String? // bare audit-actor column
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  @@map("ap_sender_config")
}

/// C9-D2 — explicit sender allowlist, consulted only when mode=explicit_list.
model ApSenderEntry {
  id         String   @id @default(uuid())
  address    String   @unique
  active     Boolean  @default(true)
  note       String?
  created_by String? // bare audit-actor column
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([active])
  @@map("ap_sender_entries")
}

/// C3.3 / C5 — the FIXED decision-mail recipient roster (Mary's Great Plains
/// filing address lands post-Monday-call). Mirrors `alert_recipients`. Seeded
/// EMPTY: with zero active rows a decision REFUSES to mail and pages
/// `dr3-vision-system` (operator action: add Mary's address here). The decision
/// reply NEVER goes to the inbound Reply-To (attacker-controlled).
model ApDecisionRecipient {
  id         String   @id @default(uuid())
  email      String   @unique
  active     Boolean  @default(true)
  created_by String? // bare audit-actor column
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([active])
  @@map("ap_decision_recipients")
}

/// D1 — Graph delta-token persistence per mailbox+folder. A lost token degrades
/// to a full-folder resync; idempotency (internet_message_id UNIQUE) absorbs it.
model ApDeltaToken {
  id          String   @id @default(uuid())
  mailbox     String
  folder      String
  delta_token String
  updated_at  DateTime @updatedAt

  @@unique([mailbox, folder])
  @@map("ap_delta_tokens")
}

/// C6 — poll-run ledger (the `mymrc_sync_runs` shape). ALWAYS written, including
/// on throw. `transport_mode` self-reports mock-vs-live in every row.
model ApPollRun {
  id                String          @id @default(uuid())
  started_at        DateTime        @default(now())
  finished_at       DateTime?
  status            ApPollRunStatus
  transport_mode    ApTransportMode
  mailbox           String?
  folder            String?
  messages_listed   Int             @default(0)
  requests_created  Int             @default(0)
  followups_created Int             @default(0)
  quarantined       Int             @default(0)
  moved             Int             @default(0)
  error             String? // human error text (never contains credentials / PII)
  run_id            String? // per-run correlation id (crypto.randomUUID)
  created_at        DateTime        @default(now())

  @@index([status, started_at])
  @@map("ap_poll_runs")
}

/// ADR-0046 §3 amendment (handoff §1.6a/b) — the EXPLICIT AP-approver roster.
/// The original ADR-0046 build resolved approvers implicitly as "active users with
/// org reach (admin OR all_sites)". The amendment makes the roster explicit so
/// single-site managers (Rick=Eugene, Janette=Woodland) can be approvers who see
/// ALL invoices without granting them all_sites. Approver resolution = active users
/// with a row whose `active_until` is null OR in the future. Admins can ALWAYS act
/// (checked separately), so Bill needs no row. Kelsey's row carries
/// active_until = 2026-08-08 00:00 PT (extended one week from 8/1, rollup §7) and is
/// auto-removed by the daily expiry job
/// (audit + ntfy). `user_id` UNIQUE (one row per user). Bare FK column; constraint
/// in migration 20260715b_rollup_ap_boardpack_yard.
model ApApprover {
  id           String    @id @default(uuid())
  user_id      String    @unique // FK → users.id (constraint in migration)
  active_until DateTime? // null = no expiry; excluded from resolution once <= now()
  created_by   String? // bare audit-actor column
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@map("ap_approvers")
}

// ────────────────────────────────────────────────────────────────────────
// ADR-0046 Amendment 5 (2026-07-22) — approver-side vetting friction: vendor
// baseline + variance detection (D-M5-4), equipment linking (D-M5-6), and the
// $1,000 second-approval roster (D-M5-3). Five self-contained tables at the
// schema tail. FK columns to sibling-owned models (users.id, sites.id) are bare
// scalars whose constraints are created at the DB level in migration
// 20260805_ap_amendment_5_structured_decide_dual_approval_variance_history_equipment
// (mirrors ap_approvers / equipment_events). The `equipment` master + its
// ap_equipment_links back-relation are wholly within this block, so a proper
// Prisma relation is declared for those two.
// ────────────────────────────────────────────────────────────────────────

/// ADR-0046 Amendment 5 (D-M5-4) — raw AP-history rows feeding vendor baselines.
/// Two provenances (`source`): Bill-uploaded AP-report PDFs (bill_upload) and
/// Vision's own approved invoices (vision_approval, inserted on each `approved`
/// transition so baselines stay fresh). `vendor_name_normalized` (lowered,
/// trimmed, whitespace-collapsed) is the aggregation + typeahead key. `site_id` is
/// a bare FK → sites.id (nullable; a combined upload may not resolve a site).
model ApVendorBaselineHistory {
  id                     String                  @id @default(uuid())
  vendor_name            String
  vendor_name_normalized String
  invoice_date           DateTime                @db.Date
  invoice_amount_cents   Int
  site_id                String? // bare FK → sites.id (constraint in migration)
  source                 ApBaselineHistorySource
  imported_at            DateTime                @default(now())
  imported_by            String? // bare audit-actor column (users.id)

  @@index([vendor_name_normalized])
  @@index([site_id])
  @@index([invoice_date])
  @@map("ap_vendor_baseline_history")
}

/// ADR-0046 Amendment 5 (D-M5-4) — COMPUTED per-vendor baseline over the trailing
/// 12 months, refreshed nightly (cron) + on-demand. PK is `vendor_name_normalized`
/// (one row per vendor). A baseline is ESTABLISHED (used for variance flagging)
/// only when `invoice_count >= 3`. Per-vendor admin overrides tighten/loosen the
/// global $50 flat + 15% thresholds; `variance_percent_override` is a fraction
/// (e.g. 0.0625 for Clark Pest's 6.25%).
model ApVendorBaseline {
  vendor_name_normalized       String   @id
  vendor_display_name          String
  invoice_count                Int
  mean_amount_cents            Int
  median_amount_cents          Int
  min_amount_cents             Int
  max_amount_cents             Int
  stddev_amount_cents          Int?
  computed_at                  DateTime @default(now())
  variance_flat_override_cents Int? // admin per-vendor flat override (cents)
  variance_percent_override    Decimal? @db.Decimal(6, 4) // admin per-vendor percent override (fraction)

  @@map("ap_vendor_baselines")
}

/// ADR-0046 Amendment 5 (D-M5-6) — the consolidated equipment/asset master the
/// Approve-panel multi-select reads from (site-filtered by the decision's site
/// tag). No equipment MASTER existed before Amendment 5 (equipment_events is a
/// Terex-first LOG keyed by a plain `equipment_code` string, not a registry); this
/// is that registry. Admin-managed — the approver panel may only REFERENCE rows
/// (no inline creation, hard rule #3). `is_active=false` hides an asset from the
/// picker without deleting its links.
model Equipment {
  id           String            @id @default(uuid())
  site_id      String // bare FK → sites.id (constraint in migration)
  display_name String
  category     EquipmentCategory
  is_active    Boolean           @default(true)
  created_at   DateTime          @default(now())
  updated_at   DateTime          @updatedAt

  /// ADR-0075 D5 — the SURVIVOR this row was merged into, or null for a live row.
  ///
  /// Three near-duplicates of one Terex machine reached production on 2026-08-04
  /// because a name collision dead-ended the AP resolve panel and the approver
  /// retyped around it. Merging repoints their ATTRIBUTION (links + resolved
  /// requests) onto one survivor and stamps the loser here.
  ///
  /// A DEDICATED column rather than overloading `is_active`, because the two facts
  /// are genuinely different: `is_active=false` means "not selectable right now,
  /// may come back", and a returning asset is REACTIVATED. `merged_into_id` means
  /// "this row is not a thing any more — the thing is over there", and it never
  /// comes back. Collapsing them would also hand `scripts/seed-equipment-master.mjs`
  /// a resurrection trap: the seed keys on `(site_id, display_name)`, finds the
  /// loser still carrying its old name, and writes `is_active=true` back onto it —
  /// re-splitting the very rows a merge just joined. The seed follows this column
  /// to the winner instead (ADR-0075 D5).
  ///
  /// `onDelete: Restrict` matches every other equipment reference: nothing in this
  /// registry is ever hard-deleted, and a survivor must not be removable out from
  /// under the rows pointing at it.
  merged_into_id String?
  merged_into    Equipment?  @relation("EquipmentMerge", fields: [merged_into_id], references: [id], onDelete: Restrict)
  merged_from    Equipment[] @relation("EquipmentMerge")
  /// `users.id` of the admin who merged it — a bare FK, matching `resolved_by` on
  /// the sibling request model.
  merged_by      String?
  merged_at      DateTime?

  links ApEquipmentLink[]

  /// ADR-0079 D1 — the manager's daily units+run-hours capture for this machine.
  /// A proper relation (not a bare FK) because, like `links` above, both models
  /// live wholly inside this self-contained block.
  daily_throughput EquipmentDailyThroughput[]

  /// ADR-0046 Amendment 9 (§2.5) — the escape-hatch requests this asset RESOLVED.
  /// A proper relation (not a bare FK) because both models live wholly inside this
  /// self-contained block, same as `links` above.
  resolved_equipment_requests ApEquipmentRequest[]

  /// ADR-0063 D3 — `(site_id, display_name)` is the natural key. It is what
  /// `scripts/seed-equipment-master.mjs` (ADR-0062) keys its idempotency on, and
  /// what keeps two indistinguishable options out of the AP approver's picker.
  /// Deliberately UNCONDITIONAL (covers `is_active=false` rows): equipment has no
  /// `deleted_at`, deactivated rows are retained so historical `ap_equipment_links`
  /// resolve, and a returning asset should be REACTIVATED rather than re-created.
  ///
  /// ADR-0075 D3 deliberately did NOT tighten this to a case-insensitive unique.
  /// Production holds one violating group today ("Terex Machine" / "Terex machine"),
  /// and migrations run in an init container at deploy — a unique index that cannot
  /// build would crash-loop the deploy, not fail a review. Case-folded duplicates
  /// are DETECTED (`canonicalizeName` / `findSimilarEquipment`) and offered as a
  /// choice; they are not refused by the database.
  @@unique([site_id, display_name])
  @@index([site_id, is_active])
  @@index([merged_into_id])
  @@map("equipment")
}

/// ADR-0046 Amendment 5 (D-M5-6) — join of an Approve decision to the equipment it
/// referenced. Distinct row per selected asset; a SINGLE row with
/// `is_not_equipment_related=true` (and `equipment_id` null) records the explicit
/// "Not equipment-related" choice — mutually exclusive with real equipment picks
/// (app-enforced). At least one row is required to Approve.
///
/// ADR-0046 Amendment 9 (§2.2/§2.3) — a THIRD, equally explicit disposition:
/// `equipment_request_id` points at the free-text escape-hatch request the approver
/// filed because the asset was not in the picker. EXACTLY ONE of the three is set
/// per row (`equipment_id` NOT NULL · `is_not_equipment_related` true ·
/// `equipment_request_id` NOT NULL) — enforced by a CHECK constraint in migration
/// `20260815_adr0046_a9_ap_equipment_escape_hatch`, not by app code alone. On
/// resolution the request row's `resolved_equipment_id` may be BACKFILLED onto this
/// row (`equipment_id` set, `equipment_request_id` cleared) so the historical
/// invoice ends up correctly attributed.
model ApEquipmentLink {
  id                       String              @id @default(uuid())
  request_id               String
  request                  ApRequest           @relation(fields: [request_id], references: [id], onDelete: Cascade)
  equipment_id             String? // FK → equipment.id; null when is_not_equipment_related
  equipment                Equipment?          @relation(fields: [equipment_id], references: [id], onDelete: Restrict)
  is_not_equipment_related Boolean             @default(false)
  equipment_request_id     String? // FK → ap_equipment_requests.id (Amendment 9)
  equipment_request        ApEquipmentRequest? @relation(fields: [equipment_request_id], references: [id], onDelete: Restrict)
  created_at               DateTime            @default(now())

  @@index([request_id])
  @@index([equipment_id])
  @@index([equipment_request_id])
  @@map("ap_equipment_links")
}

/// ADR-0046 Amendment 9 (§2.3) — the AP equipment ESCAPE HATCH request.
///
/// WHY IT EXISTS: before Amendment 9 an approver facing an asset the registry did
/// not carry had exactly two lies available — pick the wrong asset, or claim "not
/// equipment-related". Both file the invoice against the wrong thing and leave no
/// trace that the fleet registry is incomplete. This table is the honest third
/// answer: a REQUIRED free-text description that both unblocks the approval AND
/// creates a tracked request for the site managers to add the asset properly.
///
/// It is NOT a bypass. `description` is NOT NULL, the row is always created inside
/// the SAME transaction as the decision it belongs to, and it stays `open` on a
/// worklist until a site manager either RESOLVES it (creating the real `equipment`
/// row and, optionally, repointing the original `ap_equipment_links` row at it —
/// the backfill that makes the historical invoice correct) or REJECTS it with a
/// note. Neither outcome ever touches the invoice's approved state: this is
/// bookkeeping cleanup, never a reversal.
model ApEquipmentRequest {
  id            String                   @id @default(uuid())
  ap_request_id String
  ap_request    ApRequest                @relation(fields: [ap_request_id], references: [id], onDelete: Cascade)
  /// The site the decision was filed against. Bare FK → sites.id (constraint in the
  /// migration). NOT NULL: the hatch is reachable only from a structured real-site
  /// Approve, where the site tag is already required.
  site_id       String
  description   String
  requested_by  String // bare FK → users.id (the approver who filed it)
  requested_at  DateTime                 @default(now())
  status        ApEquipmentRequestStatus @default(open)

  resolved_equipment_id String? // FK → equipment.id, set on resolve
  resolved_equipment    Equipment? @relation(fields: [resolved_equipment_id], references: [id], onDelete: Restrict)
  resolved_by           String? // bare FK → users.id
  resolved_at           DateTime?
  /// REQUIRED to reject (a rejection must say why); optional on resolve.
  resolution_note       String?

  links ApEquipmentLink[]

  @@index([status])
  @@index([site_id, status])
  @@index([ap_request_id])
  @@map("ap_equipment_requests")
}

/// ADR-0046 Amendment 5 (D-M5-3) — the $1,000 second-approval roster, keyed by
/// SITE CODE (not a sites.id FK — the spec pins `site_id` to the literal
/// 'woodland' | 'eugene' codes; a migration CHECK enforces the domain). NOT-DR3
/// has no second approver. A row is ACTIVE when `active=true` AND active_until is
/// null OR in the future. `user_id` is a bare FK → users.id. Seed: Bill (woodland,
/// admin) implicitly; Shannon Rockwell (eugene) provisioned by Bill (§4).
/// ADR-0066 §1.4 — PERSON-TO-PERSON second-approval routing. Supersedes the
/// site-based `ApSecondApprover` roster (Amendment 5 D-M5-3), which is deprecated
/// but retained for audit continuity — we stop READING it, we never drop it.
///
/// WHY THIS REPLACED SITE ROUTING: the authorization path accepted admin-eligibility
/// while the notification path queried the site roster alone. Bill was deliberately
/// never given a `woodland` roster row (admin-eligibility covered him), so every
/// Woodland second-approval resolved to an EMPTY recipient set and — because the
/// notify path is fail-soft — sent nothing and raised nothing, every time. Routing
/// by WHO SIGNED FIRST removes the site dependency entirely and gives better
/// separation of duties: the two people on the same floor check each other.
///
/// The table must be TOTAL. An approver with no row falls back IMMEDIATELY (no 24h
/// wait) to `fallback_approver_id` (NULL ⇒ system admin) and raises a warning line
/// in Bill's 06:00 digest so the missing pair gets configured.
model ApApprovalRouting {
  id                   String   @id @default(uuid())
  first_approver_id    String   @unique // bare FK → users.id
  second_approver_id   String // bare FK → users.id
  fallback_approver_id String? // bare FK → users.id; NULL ⇒ system admin (Bill)
  /// Business HOURS (weekday clock, §1.5) before escalating to the fallback.
  fallback_after_hours Int      @default(24)
  active               Boolean  @default(true)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt
  updated_by           String? // bare audit-actor user id

  // CHECK (first_approver_id <> second_approver_id) lives in the migration —
  // self-approval is never a valid pair.
  @@index([active])
  @@map("ap_approval_routing")
}

/// ADR-0066 §1.6 — per-user, per-event notification scoping. Generalizes what would
/// otherwise be a hardcoded "don't email Shannon" exception: she does not work the
/// daily queue and was buried in new-invoice noise for a queue she has no role in.
///
/// Event semantics (precise — see §1.6):
///   `new_invoice`             → broadcast to every user with the pref on.
///   `second_approval_request` → ONLY the specific person it routed to (plus the
///                               fallback approver on escalation). NEVER a broadcast:
///                               even with the pref on, a user is notified only for
///                               requests routed to THEM.
///   `daily_digest`            → Bill only (§1.7).
///   `decision_outcome`        → NOBODY. Ships as a column, everyone false, for
///                               future flexibility. Bill: "they don't need to know,
///                               it's done."
///
/// Prefs filter WITHIN the ADR-0047 `notifyStaff()` chokepoint and the `ap_notify`
/// rollout gate — they never bypass either.
model ApNotificationPref {
  id                             String   @id @default(uuid())
  user_id                        String   @unique // bare FK → users.id
  notify_new_invoice             Boolean  @default(true)
  notify_second_approval_request Boolean  @default(true)
  notify_daily_digest            Boolean  @default(false)
  notify_decision_outcome        Boolean  @default(false)
  updated_at                     DateTime @updatedAt
  updated_by                     String? // bare audit-actor user id

  @@map("ap_notification_prefs")
}

model ApSecondApprover {
  id           String    @id @default(uuid())
  user_id      String // bare FK → users.id (constraint in migration)
  site_id      String // site CODE: 'woodland' | 'eugene' (CHECK in migration)
  active       Boolean   @default(true)
  active_from  DateTime  @default(now())
  active_until DateTime?
  created_at   DateTime  @default(now())

  @@index([site_id, active])
  @@index([user_id])
  @@map("ap_second_approvers")
}

// ────────────────────────────────────────────────────────────────────────
// ADR-0048 — backfill promotion
//
// The one-shot, idempotent, audited promotion of parsed workbook staging rows
// (ADR-0039 `workbook_import_rows`) into the operational tables — the ADR-0023
// historical-import discipline (SHA gate + idempotency + provenance + audit)
// applied to loads/inventory. Two ledger tables:
//
//   - `workbook_promotions` — one row per promoted `WorkbookImport`
//     (`import_id` UNIQUE = the re-run no-op). Records the scope, the SHA over
//     the staged content that was promoted, who/when, and per-table counts.
//   - `equipment_history_imports` — one row per Terex spreadsheet upload
//     (`source_sha256` UNIQUE = the re-run no-op) driving `equipment_events`
//     (`source=import`, `import_id` back-reference).
//
// Both blocks are self-contained at the schema tail: FK columns to sibling-owned
// models (`import_id` → `workbook_imports`, the actor columns) are plain scalars,
// their referential-integrity constraints created at the DB level in migration
// `20260714_june_backfill` (mirrors `equipment_events` / `alert_recipients`). The
// operational tables each gained a bare nullable `import_id` column (one ALTER
// each) so a promoted row is traceable AND the idempotency/conflict checks are
// cheap. No Prisma relation is added to any shared model.
// ────────────────────────────────────────────────────────────────────────

/// ADR-0048 D1/D2 — promotion ledger. One row per promoted workbook import.
/// `import_id` is UNIQUE: a second promotion of the same import is refused at the
/// application layer (SHA-matched re-run = no-op; SHA-changed = typed error).
/// `scope` retains the exact {siteId, from, to, expectedCloseBalance} the
/// promotion ran under; `counts` the per-table row counts (reconciled to the
/// workbook's own totals per the acceptance criteria).
model WorkbookPromotion {
  id                     String   @id @default(uuid())
  import_id              String   @unique // FK → workbook_imports.id (constraint in migration)
  scope                  Json // { siteId, from, to, expectedCloseBalance }
  sha256                 String // SHA-256 over the canonical serialization of the staged content promoted
  promoted_by            String // users.id (bare column — constraint in migration)
  promoted_at            DateTime @default(now())
  counts                 Json // { processed_units_daily, inbound_loads, outbound_materials, landfilled_units, consumer_dropoffs, site_inventory_snapshots }
  computed_close_program Decimal? @db.Decimal(10, 1) // proven June-close program balance (D2 live assertion)
  computed_close_total   Decimal? @db.Decimal(10, 1)
  notes                  String?
  created_at             DateTime @default(now())

  @@map("workbook_promotions")
}

/// ADR-0048 D3 — Terex equipment-history import batch. `source_sha256` is UNIQUE:
/// re-uploading the identical file is a no-op. Idempotency of the derived
/// `equipment_events` is `(site, event_date, kind, note-hash)` so a re-run that
/// finds the same events skips them. The parser is written against a documented
/// flexible header-detection mapping until Janette's real file lands, at which
/// point it is finalized against the real shape (the upload UI says so loudly).
model EquipmentHistoryImport {
  id                String   @id @default(uuid())
  site_id           String // FK → sites.id (constraint in migration)
  original_filename String
  source_sha256     String   @unique
  storage_key       String? // R2 evidence key (equipment-imports/ prefix), best-effort
  imported_by       String // users.id (bare column — constraint in migration)
  imported_at       DateTime @default(now())
  events_created    Int      @default(0)
  events_skipped    Int      @default(0)
  rows_parsed       Int      @default(0)
  // ADR-0048 D3 — content rows skipped for an implausible/unparseable Date cell
  // (e.g. an Excel-epoch 1900 artifact from a mis-entered Date column). Surfaced to
  // the operator to fix at the source; never stored as a garbage event.
  rows_warned       Int      @default(0)
  header_mapping    Json? // the detected column → field mapping (forensic)
  notes             String?
  created_at        DateTime @default(now())

  @@index([site_id, imported_at])
  @@map("equipment_history_imports")
}

// ════════════════════════════════════════════════════════════════════════
// 2026-07-08 planning rollup — build-now subset (self-contained tail blocks;
// bare FK columns with DB-level constraints created in migration
// 20260715b_rollup_ap_boardpack_yard, so the shared Site/User relation lists
// stay untouched — repo convention, mirrors ADR-0040/0041/0045).
// ════════════════════════════════════════════════════════════════════════

/// ADR-0045 §3 addendum (handoff §1.8) — the board-pack digest recipient roster.
/// Bethany + Bill are mandatory; seeded with Bill's login + a documented Bethany
/// placeholder (docs/operator/board-pack-digest.md) until her real address lands.
/// Mirrors `ap_decision_recipients`. The digest send routes through
/// notifyStaff('board_pack_digest') (org-wide surface, born pilot) — in pilot it
/// reroutes to admins; this roster is the LIVE audience.
model BoardPackRecipient {
  id         String   @id @default(uuid())
  email      String   @unique
  active     Boolean  @default(true)
  created_by String? // bare audit-actor column
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([active])
  @@map("board_pack_recipients")
}

/// ADR-0045 §3 addendum (handoff §1.8) — board-pack digest send idempotency ledger.
/// `period_start` (first-of-previous-month @db.Date) is UNIQUE, so a same-day
/// re-fire OR the 2nd-Wednesday + preceding-Monday double-trigger both map to ONE
/// send per month (mirrors `alert_digest_log` / `bonus_daily_report_log`).
model BoardPackSendLog {
  id               String   @id @default(uuid())
  period_start     DateTime @unique @db.Date // first-of-previous-month anchor
  sent_at          DateTime @default(now())
  recipients_count Int      @default(0)
  mode             String // 'live' | 'pilot' — how notifyStaff resolved the surface
  created_at       DateTime @default(now())

  @@map("board_pack_send_log")
}

/// handoff §1.8 — where a yard trailer/container currently is (Yard view scaffold).
enum YardTrailerStatus {
  on_yard
  at_account
  in_service
}

/// handoff §1.8 — a minimal trailer/yard position for the manager Yard view. A
/// SCAFFOLD: list + add/edit, no workflow. Site-scoped (bare FK column; constraint
/// in migration). Complements `container_rental_sites` (rental containers) — this
