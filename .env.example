# DR3-Vision environment variables
#
# Copy this file to `.env.local` for local development.
# In production, these are managed via the fleet secrets store on CHAD-HQ.
# See `docs/FLEET-DEPLOYMENT.md` for production-specific details.
#
# Never commit a populated .env file. .gitignore excludes them.

# ============================================================================
# Application
# ============================================================================

NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-random-32-byte-hex-in-production

# ============================================================================
# Database
# ============================================================================

# Local dev (matches docker-compose.yml)
DATABASE_URL="postgresql://dr3:dr3_dev_password@localhost:5432/dr3_vision?schema=public"

# ============================================================================
# Cloudflare R2 — photo storage
# ============================================================================

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dr3-vision-photos-dev
R2_PUBLIC_BASE_URL=https://photos-dev.dr3-vision.svdp.us

# For local dev with MinIO (S3-compatible local emulator):
# R2_ENDPOINT=http://localhost:9000
# R2_BUCKET=dr3-vision-photos
# R2_ACCESS_KEY_ID=minioadmin
# R2_SECRET_ACCESS_KEY=minioadmin

# ============================================================================
# MyMRC — Playwright integration (T-015 / ADR-0009 / ADR-0057)
# ============================================================================
#
# Operator runbook: docs/operator/mymrc-setup.md
#
# As of ADR-0057 the MyMRC login is NOT an env var. Bill enters the single
# admin identity in the UI at `/admin/mrc-scrape`; it is stored AES-256-GCM
# encrypted in Postgres. The retired MYMRC_{EUGENE,WOODLAND,OR,CA}_* vars are
# gone. The only MyMRC secret on the host is the encryption KEY below.

# AES-256 credential-store key (src/lib/mymrc/credential-store.ts). A dedicated
# 32-byte random secret — deliberately separate from NEXTAUTH_SECRET. BOTH the
# `app` (writes credentials via /admin/mrc-scrape) and the `mymrc-scrape`
# container (reads them) must have this in their environment or the store cannot
# encrypt/decrypt. Generate: `openssl rand -hex 32`. In production it is
# provisioned via ~/.dr3-vision-secrets/mymrc-cred-key.env (mode 600, compose
# env_file). Never commit a populated value.
MYMRC_CRED_KEY=

# Storage state directory for Playwright auth persistence between
# scrape runs. Production uses /var/lib/dr3-vision/mymrc-auth (mounted
# from the `mymrc-auth-state` Docker volume); local dev defaults to
# ./.mymrc-auth (gitignored).
MYMRC_AUTH_STATE_DIR=./.mymrc-auth

# Set to "false" only for local debugging (visible browser window).
# Production must stay headless.
MYMRC_HEADLESS=true

# ============================================================================
# Observability
# ============================================================================

# GlitchTip — error tracking (ADR-0022 §2). Unset = error reporting disabled
# (fail-open). Server-side DSN:
GLITCHTIP_DSN=
# Browser-side DSN (exposed to the client; a DSN is a write-only public ingest
# key — safe to ship). Usually the same value as GLITCHTIP_DSN.
NEXT_PUBLIC_GLITCHTIP_DSN=
# Source-map upload during `next build` (Sentry CLI → GlitchTip). Unset = build
# succeeds but GlitchTip stack traces are minified.
GLITCHTIP_AUTH_TOKEN=
GLITCHTIP_URL=https://glitchtip.barnardhq.com
# Sentry bundler-plugin org/project slugs (for source-map upload only):
SENTRY_ORG=
SENTRY_PROJECT=

# Loki — logs ship via stdout (the fleet Promtail/Alloy agent tails the
# container). No DR3-Vision-side endpoint. LOG_LEVEL controls pino verbosity.
LOG_LEVEL=info
LOKI_ENDPOINT=http://localhost:3100

# Tempo — traces (ADR-0022 §1). Unset = tracing disabled (fail-open).
TEMPO_ENDPOINT=http://localhost:4318/v1/traces
# Head-sampling ratio in production (dev is always 100%). 0.01 = 1%.
OTEL_TRACE_SAMPLE_RATE=0.01

# Deployed git short SHA — set at build time by swarmpilot_deployer; surfaces as
# the service version in traces, GlitchTip releases, and the dashboard footer.
GIT_SHA=

# ============================================================================
# ntfy — system-level alerts (ADR-0036 + ADR-0037)
# ============================================================================
#
# DR3-Vision publishes ONLY system-level events (boot, migration applied,
# unhandled errors). Operational events (rejections, long unloads, SLA
# breaches, PIN lockouts) are in-app dashboard signals — never push.
# Per CLAUDE.md hard rule #5 + docs/COMPLIANCE.md.
#
# Operator runbook for production token + env_file drop:
#   docs/operator/ntfy-setup.md
#
# Real publisher token lives in `~/.dr3-vision-secrets/ntfy.env` on
# CHAD-HQ (mode 600); the deployer sources it via env_file in
# docker-compose.yml. Never commit a populated value.

NTFY_BASE_URL=https://ntfy.barnardhq.com
NTFY_TOPIC_SYSTEM=dr3-vision-system
NTFY_TOPIC_CONTAINER=dr3-vision-container
NTFY_PUBLISHER_TOKEN=

# ============================================================================
# Microsoft Entra ID — SSO for managers + admins (ADR-0016)
# ============================================================================
#
# Operator runbook: docs/operator/entra-id-setup.md
#
# Register an application in Azure portal > Microsoft Entra ID >
# App registrations. Single-tenant. Redirect URI:
#   https://dr3-vision.svdp.us/api/auth/callback/microsoft-entra-id
#
# After registration, copy the values below and store them in the
# fleet secrets file (~/.dr3-vision-secrets/auth.env, chmod 600).
# Never commit populated values.

AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Directory (tenant) ID. Required for SSO and ALSO read directly by the M365
# Graph mail-send client (src/lib/m365-mail.ts via ClientSecretCredential).
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=
# Issuer URL — replace <tenant-id> with the Directory (tenant) ID.
# Trailing slash is optional. Use the tenant-specific issuer (NOT
# /common/v2.0/) so foreign Microsoft accounts are rejected at the
# IdP step before the signIn gate even runs.
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0/

# ============================================================================
# Microsoft Graph mail-send — monthly bonus PDF → payroll (ADR-0021, T-122)
# ============================================================================
#
# Operator runbook: docs/operator/m365-mail-send-setup.md
#
# Production wiring is operator env config — there is NO sandbox/prod toggle in
# code. The mail client reads the three AUTH_MICROSOFT_ENTRA_ID_* values above
# plus the two below, all from process.env, and posts to the standard Graph
# endpoint (https://graph.microsoft.com/v1.0 /users/{from}/sendMail). When any
# required value is unset the send is a fail-open no-op (logs + returns
# disabled) — the app boots and serves without M365 configured.
#
# Set these in the fleet secrets file on CHAD-HQ
# (~/.dr3-vision-secrets/m365.env, chmod 600). Never commit populated values.

M365_MAIL_FROM_ADDRESS=dr3-vision@svdp.us
M365_PAYROLL_TO_ADDRESS=payroll@svdp.us

# ============================================================================
# Feature flags (development only)
# ============================================================================

# Set to "1" to enable the V2.1 Processor Form workflow (not for production)
FEATURE_PROCESSOR_FORM=0

# Set to "1" to enable the V2.2 CIP capture flow (not for production)
FEATURE_CIP=0

# Set to "1" to enable the V2.1 cast-view ("Next up" warehouse TV)
FEATURE_CAST_VIEW=0

# ============================================================================
# ADR-0040 — Billing rate infrastructure (fuel-price auto-fetch)
# ============================================================================

# EIA open-data API key for the weekly West Coast (PADD 5) ULSD diesel fetch
# (src/lib/billing-rates/eia.ts, EIA API v2 petroleum/pri/gnd). Free key from
# https://api.eia.gov/opendata. FAIL-OPEN: if unset, the weekly fuel-fetch cron
# logs and skips (never pages/crashes) and the manual fuel-price entry surface
# still works. In production this is provisioned via
# ~/.dr3-vision-secrets/billing.env (compose env_file, required:false).
EIA_API_KEY=

# Defense-in-depth bearer for ALL /api/internal/* cron routes (optional: when
# unset, both sides skip the bearer check and the loopback/cf-connecting-ip
# guard is the only boundary — set it in production).
INTERNAL_CRON_TOKEN=

# ============================================================================
# ADR-0045 — Contact-form intake (D3)
# ============================================================================

# Shared secret for the public contact-intake endpoint (POST /api/intake/contact,
# header `x-intake-token`). The WordPress contact-form plugin sends this header;
# see docs/operator/ops-ledger-and-intake.md for the WP wiring. FAIL-CLOSED: if
# unset, the endpoint returns 503 and accepts nothing (an inbound auth secret must
# never degrade to an open write path). Generate: `openssl rand -hex 32`. In
# production this is provisioned via ~/.dr3-vision-secrets/intake.env.
INTAKE_TOKEN=

# ============================================================================
# ADR-0046 — Vendor-invoice approval via Graph mailbox ingestion
# ============================================================================
#
# The generic Graph-mail transport (src/lib/msgraph-mail/). All FOUR values must
# be present to select the LIVE transport; when any is unset Vision selects the
# fixture-driven MOCK transport (logged loudly at each poll) and the app boots
# fine. `Mail.ReadWrite`, scoped by ApplicationAccessPolicy to the single shared
# mailbox (org-wide read is unacceptable — that scoping is an IT/tenant concern).
# In production these live in ~/.dr3-vision-secrets/msgraph-mail.env (chmod 600),
# read by the `app` service (the poll route + transport run there). Enable the
# poll DAEMON with `docker compose --profile ap up -d`. See
# docs/operator/ap-approvals.md.
MSGRAPH_MAIL_TENANT_ID=
MSGRAPH_MAIL_CLIENT_ID=
MSGRAPH_MAIL_SECRET=
MSGRAPH_MAIL_MAILBOX=approvals-dr3@svdp.us

# Optional overrides (defaults shown). Source = the well-known inbox; Processed =
# the destination folder the message is moved to after ingest (create it in the
# mailbox; a folder id also works). Internal-tenant domain for sender validation.
# MSGRAPH_MAIL_SOURCE_FOLDER=inbox
# MSGRAPH_MAIL_PROCESSED_FOLDER=Processed
# MSGRAPH_MAIL_INTERNAL_DOMAIN=svdp.us

# ── ADR-0049 — Graph Files (workbook sync) ────────────────────────────────
#
# The generic READ-ONLY Graph Files transport (src/lib/msgraph-files/). Uses the
# SAME dr3-vision app registration as the mail transport — the `Files.Read.All`
# tenant-wide grant landed 2026-07-09 (app 2da92424-7397-435d-96a1-d2a382293a53).
# So these three FALL BACK to MSGRAPH_MAIL_* when unset — you normally leave them
# blank and only the mail creds are configured. When neither set is present Vision
# selects the fixture-driven MOCK Files transport (logged at each poll) and boots
# fine. In production these (or the shared msgraph-mail.env) live in
# ~/.dr3-vision-secrets/msgraph-files.env (chmod 600), read by the `app` service.
# Enable the poll DAEMON with `docker compose --profile workbook-sync up -d` AND
# enable a source in /admin/workbook-sync. See docs/operator/workbook-sync.md.
# MSGRAPH_FILES_TENANT_ID=
# MSGRAPH_FILES_CLIENT_ID=
# MSGRAPH_FILES_SECRET=

# Optional: address that also receives the (row id + sender domain ONLY)
# quarantine email in addition to the `dr3-vision-system` ntfy page. When unset,
# only the ntfy page fires. Never carries body/attachment/amount content.
AP_QUARANTINE_EMAIL=
